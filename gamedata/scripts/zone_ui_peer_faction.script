-- zone_ui_peer_faction.script
-- Peer faction/loadout select for Zone clients. Trimmed clone of
-- xrr_ui_peer_faction.script: faction grid + new_game_loadouts.ltx only.
-- Layout: ui_mm_zone_peer_faction.xml.

local ini_itm = nil
pcall(function()
  ini_itm = ini_file("items\\settings\\new_game_loadouts.ltx")
end)

-- CharacterSelect.items is a 256-byte buffer in the native client
-- (protocol/packets.h: char items[256]); udp_client.cpp memcpy-truncates at
-- 255 bytes, so the joined loadout must be validated before sending.
local MAX_LOADOUT_BYTES = 255

local function tr(id, fallback)
  local ok, s = pcall(function() return game.translate_string(id) end)
  if ok and type(s) == "string" and s ~= "" and s ~= id then return s end
  return fallback or id
end

local function format_tr(id, fallback, ...)
  local tmpl = tr(id, fallback)
  local ok, out = pcall(string.format, tmpl, ...)
  if ok and type(out) == "string" then return out end
  return string.format(fallback, ...)
end

local function zone_eco_tier()
  local ok, tier = pcall(function()
    return ZoneNet and ZoneNet.HostEcoTier and ZoneNet:HostEcoTier() or 1
  end)
  if ok and tier then
    return tostring(math.floor(tonumber(tier) or 1))
  end
  return "1"
end

class "UIZonePeerFaction" (CUIScriptWnd)

function UIZonePeerFaction:__init(owner) super()
  self.owner = owner

  self.table_faction = {
    ["stalker"]  = true, ["dolg"]    = true, ["freedom"] = true,
    ["csky"]     = true, ["ecolog"]  = true, ["killer"]  = true,
    ["army"]     = true, ["bandit"]  = true, ["monolith"] = true,
  }
  pcall(function()
    local cfg = axr_main and axr_main.config
    if not cfg then return end
    if cfg:r_value("unlocked_factions", "renegade", 1) == true then
      self.table_faction["renegade"] = true
    end
    if cfg:r_value("unlocked_factions", "greh", 1) == true then
      self.table_faction["greh"] = true
    end
    if cfg:r_value("unlocked_factions", "isg", 1) == true then
      self.table_faction["isg"] = true
    end
  end)

  self.selected_faction = "stalker"
  self.selected_money   = nil
  self.points_left      = 1000
  pcall(function()
    if ini_itm then
      self.points_left = ini_itm:r_float_ex("points", "total_points_eco_" .. zone_eco_tier()) or 1000
    end
  end)
  self.points_used      = 0
  self.access           = true
  self.config_error     = (ini_itm == nil)
  self.loadout_error    = false
  self.error_surfaced   = false
  self.connect_lost     = false

  self:SetWndRect(Frect():set(0, 0, 1024, 768))
  self:Enable(true)

  self.faction_cell = {
    ["stalker"]  = { row = 1, col = 1 },
    ["bandit"]   = { row = 1, col = 2 },
    ["csky"]     = { row = 1, col = 3 },
    ["dolg"]     = { row = 2, col = 1 },
    ["freedom"]  = { row = 2, col = 2 },
    ["killer"]   = { row = 2, col = 3 },
    ["army"]     = { row = 3, col = 1 },
    ["ecolog"]   = { row = 3, col = 2 },
    ["monolith"] = { row = 3, col = 3 },
    ["renegade"] = { row = 4, col = 1 },
    ["greh"]     = { row = 4, col = 2 },
    ["isg"]      = { row = 4, col = 3 },
  }

  self:InitUI()
  self:InitCallbacks()
  self:PopupFaction_Controls()
  self:PopupFaction_Show(false)
end

function UIZonePeerFaction:__finalize()
end

function UIZonePeerFaction:InitUI()
  local xml = CScriptXmlInit()
  self.xml = xml
  xml:ParseFile("ui_mm_zone_peer_faction.xml")

  xml:InitStatic("background", self)
  self.dialog = xml:InitStatic("main_dialog:frame_back", self)

  self.box_faction  = xml:InitStatic("main_dialog:box_faction", self.dialog)
  self.box_item     = xml:InitStatic("main_dialog:box_item", self.dialog)

  self.main_frame = xml:InitStatic("main_dialog:frame_front", self.dialog)

  self.text_descr = xml:InitTextWnd("main_dialog:text_descr", nil)
  self.scroll_desc = xml:InitScrollView("main_dialog:scroll_desc", self.dialog)
  self.scroll_desc:AddWindow(self.text_descr, true)
  self.text_descr:SetAutoDelete(false)

  self.character_name = xml:InitTextWnd("main_dialog:input_name", self.dialog)
  self:RefreshPlayerName()
  xml:InitStatic("main_dialog:cap_name_hint", self.dialog)

  self.text_relations   = xml:InitTextWnd("main_dialog:text_relations", self.dialog)
  self.text_points_left = xml:InitTextWnd("main_dialog:text_points_left", self.dialog)
  self.text_points_used = xml:InitTextWnd("main_dialog:text_points_used", self.dialog)

  xml:InitStatic("main_dialog:cap_character", self.dialog)
  xml:InitStatic("main_dialog:cap_inventory", self.dialog)
  xml:InitStatic("main_dialog:cap_loadout", self.dialog)
  xml:InitStatic("main_dialog:cap_name", self.dialog)
  xml:InitStatic("main_dialog:cap_points_left", self.dialog)
  xml:InitStatic("main_dialog:cap_points_used", self.dialog)

  local btn = xml:Init3tButton("main_dialog:btn_start", self.dialog)
  self:Register(btn, "btn_start")

  btn = xml:Init3tButton("main_dialog:btn_back", self.dialog)
  self:Register(btn, "btn_back")

  btn = xml:Init3tButton("main_dialog:btn_faction", self.dialog)
  self:Register(btn, "btn_faction")

  pcall(function()
    self.text_error = xml:InitTextWnd("main_dialog:text_error", self.dialog)
    if self.text_error then self.text_error:SetText("") end
  end)

  self.CC = {}
  self.CC["inventory"] = utils_ui.UICellContainer("inventory", self, nil, "main_dialog:cont_inv", self.dialog)
  self.CC["loadout"]   = utils_ui.UICellContainer("loadout", self, nil, "main_dialog:cont_loadout", self.dialog)

  for name, cc in pairs(self.CC) do
    cc.showcase      = true
    cc.disable_drag  = true
    cc.disable_stack = true
    cc:SetGridSpecs(35, 2)
  end

  self.ck_reset = xml:Init3tButton("main_dialog:check_reset", self.dialog)
  self:Register(self.ck_reset, "check_reset")

  self.item_info = utils_ui.UIInfoItem(self, 1000)

  self:UpdateAll()

  self.hint_wnd = utils_ui.UIHint(self)
end

function UIZonePeerFaction:RefreshPlayerName()
  if not self.character_name then return end
  local pname = ""
  pcall(function()
    if zone_main and zone_main.get_config then
      pname = zone_main.get_config().nickname or ""
    end
  end)
  self.character_name:SetText(pname ~= "" and pname or "Player")
end

function UIZonePeerFaction:InitCallbacks()
  self:AddCallback("btn_start",   ui_events.BUTTON_CLICKED, self.OnStartGame,      self)
  self:AddCallback("btn_back",    ui_events.BUTTON_CLICKED, self.OnQuit,            self)
  self:AddCallback("btn_faction", ui_events.BUTTON_CLICKED, self.OnFactionClicked,  self)
  self:AddCallback("check_reset", ui_events.BUTTON_CLICKED, self.OnCheckResetList,  self)
end

function UIZonePeerFaction:Update()
  CUIScriptWnd.Update(self)
  -- Menu-safe pump: SHOW_START/LOAD_LEVEL/ERROR can arrive while the faction
  -- dialog is up, when actor_on_update does not exist yet.
  pcall(function()
    if zone_net and type(zone_net.pump_menu) == "function" then
      zone_net.pump_menu()
    end
  end)

  -- Connection watchdog: a dropped handshake/session must not leave this
  -- dialog silently dead. Report the reason once per disconnect.
  local connected = false
  pcall(function()
    if ZoneNet and ZoneNet.IsConnected then
      connected = ZoneNet:IsConnected() and true or false
    end
  end)
  if connected then
    self.connect_lost = false
  elseif not self.connect_lost then
    self.connect_lost = true
    local reason = ""
    pcall(function()
      if ZoneNet and ZoneNet.GetLastError then reason = ZoneNet:GetLastError() or "" end
      if reason == "" and ZoneNet and ZoneNet.GetPreservedError then
        reason = ZoneNet:GetPreservedError() or ""
      end
    end)
    local shown = reason
    if reason ~= "" then
      pcall(function()
        if ZoneNet and type(ZoneNet.LocalizeError) == "function" then
          shown = ZoneNet:LocalizeError(reason) or reason
        end
      end)
    else
      shown = tr("ui_zone_error_not_connected", "Not connected to the server.")
    end
    self:ShowError(shown)
  end

  if not self.access then
    self.hint_wnd:Update()
    return
  end

  local found_cell = false
  for name, cc in pairs(self.CC) do
    if cc:IsShown() then
      found_cell = cc:Update(self.item_info) or found_cell
    end
  end
  if not found_cell then
    self.item_info:Update()
  end

  self.hint_wnd:Update()
end

function UIZonePeerFaction:Show(state)
  if state then
    self:Refresh()
    if (self.config_error or self.loadout_error) and not self.error_surfaced then
      self.error_surfaced = true
      local id = self.config_error and "ui_zone_error_loadout_config" or "ui_zone_error_loadout_build"
      local fb = self.config_error and "Loadout configuration is missing or unreadable"
        or "Could not build the loadout"
      self:ShowError(tr(id, fb))
    end
  end
  CUIScriptWnd.Show(self, state)
end

function UIZonePeerFaction:Refresh()
  self:RefreshPlayerName()
  self:UpdateAll()
end

----------------------------------------------------------------------
-- Faction popup
----------------------------------------------------------------------
function UIZonePeerFaction:PopupFaction_Controls()
  local xml = self.xml
  self.black_1        = xml:InitStatic("main_dialog:popup_faction:frame_black", self.dialog)
  self.dialog_1       = xml:InitStatic("main_dialog:popup_faction:frame", self.dialog)
  self.cap_faction    = xml:InitStatic("main_dialog:popup_faction:cap_faction", self.dialog_1)
  self.scroll_faction = xml:InitScrollView("main_dialog:popup_faction:scroll_faction", self.dialog_1)
  self.btn_faction    = {}
end

function UIZonePeerFaction:PopupFaction_Callbacks()
  for k, v in pairs(self.table_faction) do
    self:AddCallback("btn_" .. k, ui_events.BUTTON_CLICKED, self["OnFaction_" .. k], self)
  end
end

function UIZonePeerFaction:PopupFaction_Show(state)
  local xml = self.xml
  local num_of_rows = math.ceil(size_table(self.table_faction) / 3)

  self.black_1:Show(state)
  self.dialog_1:Show(state)
  self.cap_faction:Show(state)
  self.scroll_faction:Clear()

  if state then
    self.access = false
    self:PopupFaction_Callbacks()
    local _st = xml:InitStatic("main_dialog:popup_faction:templ_faction", nil)

    for k, v in pairs(self.table_faction) do
      self.btn_faction[k] = xml:Init3tButton("main_dialog:popup_faction:btn_" .. k, _st)
      local x, y = self:GetAxis_Icon(self.scroll_faction, self.btn_faction[k],
        num_of_rows, 3, self.faction_cell[k].row, self.faction_cell[k].col)
      self.btn_faction[k]:SetWndPos(vector2():set(x, y))
      self:Register(self.btn_faction[k], "btn_" .. k)
    end
    self.scroll_faction:AddWindow(_st, true)
    _st:SetAutoDelete(false)
  else
    self.access = true
  end
end

function UIZonePeerFaction:OnFactionSelect(faction)
  self.selected_faction = faction
  self:UpdateAll()
  self:PopupFaction_Show(false)
end

function UIZonePeerFaction:OnFaction_stalker()  self:OnFactionSelect("stalker")  end
function UIZonePeerFaction:OnFaction_bandit()   self:OnFactionSelect("bandit")   end
function UIZonePeerFaction:OnFaction_csky()     self:OnFactionSelect("csky")     end
function UIZonePeerFaction:OnFaction_dolg()     self:OnFactionSelect("dolg")     end
function UIZonePeerFaction:OnFaction_freedom()  self:OnFactionSelect("freedom")  end
function UIZonePeerFaction:OnFaction_killer()   self:OnFactionSelect("killer")   end
function UIZonePeerFaction:OnFaction_army()     self:OnFactionSelect("army")     end
function UIZonePeerFaction:OnFaction_ecolog()   self:OnFactionSelect("ecolog")   end
function UIZonePeerFaction:OnFaction_monolith() self:OnFactionSelect("monolith") end
function UIZonePeerFaction:OnFaction_renegade() self:OnFactionSelect("renegade") end
function UIZonePeerFaction:OnFaction_greh()     self:OnFactionSelect("greh")     end
function UIZonePeerFaction:OnFaction_isg()      self:OnFactionSelect("isg")      end


----------------------------------------------------------------------
-- Data loading
----------------------------------------------------------------------
function UIZonePeerFaction:LoadFaction(faction)
  self.selected_faction = faction or "stalker"
  self.selected_money = utils_data.read_from_ini(
    ini_itm, self.selected_faction .. "_money", "money", "float")
  self:UpdateFaction()
end

function UIZonePeerFaction:LoadLoadout()
  local ok = pcall(function()
    local eco_idxs = zone_eco_tier()
    self.points_used = 0
    self.points_left = ini_itm and ini_itm:r_float_ex("points", "total_points_eco_" .. eco_idxs) or 1000
    self.text_points_used:SetText(tostring(self.points_used))
    self.text_points_left:SetText(tostring(self.points_left))

    local t_inv, t_loadout, p_inv, p_loadout = {}, {}, {}, {}
    local size_inv, size_loadout = 0, 0
    local n = (ini_itm and ini_itm:line_count(self.selected_faction .. "_loadout")) or 0
    for i = 0, n - 1 do
      local result, sec, value = ini_itm:r_line(self.selected_faction .. "_loadout", i, "", "")
      if ini_sys and ini_sys:section_exist(sec) then
        local t = str_explode(value, ",")
        if (not t[4]) or (t[4] and (tonumber(eco_idxs) <= tonumber(t[4]))) then
          if t[1] == "false" then
            for j = 1, tonumber(t[2]) do
              size_inv = size_inv + 1
              t_inv[size_inv] = sec
              p_inv[size_inv] = 0
            end
          elseif t[1] == "true" then
            for j = 1, tonumber(t[2]) do
              size_loadout = size_loadout + 1
              t_loadout[size_loadout] = sec
              p_loadout[size_loadout] = tonumber(t[3])
            end
          end
        end
      end
    end

    self.CC["inventory"]:Reinit(t_inv, p_inv)
    for idx, ci in pairs(self.CC["inventory"].cell) do
      if ci:IsShown() then
        local val = ci.flags.info or 0
        ci.flags.value = val
        ci.flags.value_str = game.translate_string("st_mm_new_game_points") .. ": " .. val
      end
    end

    self.CC["loadout"]:Reinit(t_loadout, p_loadout)
    for idx, ci in pairs(self.CC["loadout"].cell) do
      if ci:IsShown() then
        local val = ci.flags.info or 0
        ci.flags.value = val
        ci.flags.value_str = game.translate_string("st_mm_new_game_points") .. ": " .. val
      end
    end
  end)
  if not ok then
    printf("Zone: faction loadout build failed (missing config or data)")
    return false
  end
  return true
end


----------------------------------------------------------------------
-- Visual updates
----------------------------------------------------------------------
function UIZonePeerFaction:UpdateAll()
  self:LoadFaction(self.selected_faction)
  self:UpdateDescr()
  self.loadout_error = not self:LoadLoadout()
end

function UIZonePeerFaction:UpdateFaction()
  self.box_faction:InitTexture("ui_new_game_flair_" .. self.selected_faction)
  self.box_faction:SetStretchTexture(true)
  self.box_faction:SetWndSize(vector2():set(
    self.box_faction:GetWidth(), self.box_faction:GetHeight()))
end

function UIZonePeerFaction:UpdateDescr()
  local faction = self.selected_faction

  local desc = "%c[0,250,250,250]" .. game.translate_string("st_mm_new_game_description")
  desc = desc .. "\\n%c[0,150,150,150]" .. game.translate_string("st_faction_" .. faction .. "_desc")

  self.text_descr:SetText(desc)
  self.text_descr:AdjustHeightToText()
  self.text_descr:SetWndSize(vector2():set(
    self.text_descr:GetWidth(), self.text_descr:GetHeight() + 10))
  self.scroll_desc:Clear()
  self.scroll_desc:AddWindow(self.text_descr, true)
  self.text_descr:SetAutoDelete(false)

  local str_stats = "%c[0,250,250,250]" .. game.translate_string("st_mm_new_game_relations") .. " \\n"
  for k, v in pairs(self.table_faction) do
    if k ~= faction then
      local rel = relation_registry.community_relation("actor_" .. faction, k)
      if rel >= 1000 then
        str_stats = str_stats .. "%c[0,150,150,150]" .. string.char(149) .. " %c[0,50,175,50]" .. game.translate_string("st_faction_" .. k) .. "\\n"
      elseif rel <= -1000 then
        str_stats = str_stats .. "%c[0,150,150,150]" .. string.char(149) .. " %c[0,175,50,50]" .. game.translate_string("st_faction_" .. k) .. "\\n"
      else
        str_stats = str_stats .. "%c[0,150,150,150]" .. string.char(149) .. " %c[0,175,175,50]" .. game.translate_string("st_faction_" .. k) .. "\\n"
      end
    end
  end

  self.text_relations:SetText(str_stats)
  self.text_relations:AdjustHeightToText()
end

function UIZonePeerFaction:GetAxis_Icon(main, element, all_row, all_col, row, col)
  local _w  = main:GetWidth()
  local _h  = main:GetHeight()
  local _wi = element:GetWidth()
  local _hi = element:GetHeight()
  local off_x = (_w - _wi * all_col) / (all_col + 1)
  local off_y = (_h - _hi * all_row) / (all_row + 1)
  return (off_x * col) + (_wi * (col - 1)),
         (off_y * row) + (_hi * (row - 1))
end


----------------------------------------------------------------------
-- Interaction
----------------------------------------------------------------------
function UIZonePeerFaction:OnFactionClicked()
  if not self.access then return end
  self:PopupFaction_Show(true)
end

function UIZonePeerFaction:On_CC_Mouse1(cont, idx)
  if not self.access then return end

  local ci = self.CC[cont].cell[idx]
  if not ci then return end

  local flags = ci.flags
  if not (flags.value and flags.value > 0) then return end

  local points = flags.value
  local to_inv = cont == "inventory"
  local cont2  = to_inv and "loadout" or "inventory"

  local points_used = self.points_used + ((to_inv and -1 or 1) * points)
  local points_left = self.points_left + ((to_inv and 1 or -1) * points)
  if points_left < 0 then return end

  self.points_used = points_used
  self.points_left = points_left

  self.text_points_used:SetText(tostring(self.points_used))
  self.text_points_left:SetText(tostring(self.points_left))

  self.CC[cont]:TransferItem(self.CC[cont2], nil, ci.section)
end

function UIZonePeerFaction:OnCheckResetList()
  if not self.access then return end
  self:LoadLoadout()
end


----------------------------------------------------------------------
-- Navigation
----------------------------------------------------------------------
function UIZonePeerFaction:OnQuit()
  if not self.access then return end

  if ZoneNet and ZoneNet.IsConnected and ZoneNet:IsConnected() then
    local ok = pcall(function() ZoneNet:Disconnect() end)
    if not ok then
      printf("Zone: disconnect failed while leaving faction select")
    end
  end

  self:CloseToMenu()
end

function UIZonePeerFaction:CloseToMenu()
  self.submitted = nil
  if self.owner then
    self.owner:ShowDialog(true)
    self.owner:Show(true)
  end
  if self:IsShown() then self:HideDialog() end
  CUIScriptWnd.Show(self, false)
end

function UIZonePeerFaction:BuildLoadoutItems()
  local entries = {}
  local ammo_to_spawn = {}

  for idx, ci in pairs(self.CC["inventory"].cell) do
    if ci:IsShown() and ci.section then
      local sec    = ci.section
      local copies = ci:CountChilds() + 1
      local box_size = ini_sys:section_exist(sec) and ini_sys:r_float_ex(sec, "box_size")
      local each_cnt = (box_size and box_size > 0) and math.floor(box_size) or 1
      for i = 1, copies do
        entries[#entries + 1] = sec .. ":" .. tostring(each_cnt)
      end

      if ini_sys:section_exist(sec) and ini_sys:r_string_ex(sec, "ammo_class") then
        local slot     = ini_sys:r_float_ex(sec, "slot")
        local ani_slot = ini_sys:r_float_ex(sec, "animation_slot")
        if slot and (((slot == 0) and (ani_slot == 1)) or slot == 1 or slot == 2) then
          local ammo_tbl  = str_explode(ini_sys:r_string_ex(sec, "ammo_class"), ",")
          local ammo_type = ini_itm:r_string_ex("ammo_type_per_wpn", sec)
          local sec_ammo  = ammo_tbl[1]
          if ammo_type and ini_sys:section_exist(ammo_type) then
            sec_ammo = ammo_type
          end
          local ammo_box = ini_sys:r_float_ex(sec_ammo, "box_size") or 50
          local count    = ini_itm:r_float_ex("ammo_count", sec_ammo)
          if not count then
            count = (ammo_box < 30) and (2 * ammo_box) or ammo_box
          end
          ammo_to_spawn[sec_ammo] = (ammo_to_spawn[sec_ammo] or 0) + (count * copies)
        end
      end
    end
  end

  for sec_ammo, cnt in pairs(ammo_to_spawn) do
    entries[#entries + 1] = sec_ammo .. ":" .. tostring(math.floor(cnt))
  end

  return table.concat(entries, ",")
end

function UIZonePeerFaction:OnStartGame()
  if not self.access then return end
  if self.submitted then return end
  if not (ZoneNet and ZoneNet.IsConnected and ZoneNet:IsConnected()) then
    self:ShowError(tr("ui_zone_error_not_connected", "Not connected to the server."))
    return
  end
  if ZoneNet.IsClientLoaded and not ZoneNet:IsClientLoaded() then
    self:ShowError(tr("ui_zone_error_zone_module",
      "Network module unavailable - cannot send character"))
    return
  end

  -- Identity gate: only enforced when zone_main exposes the identity API.
  -- Never send a character select for the shared "anonymous" placeholder.
  local have_identity_api = false
  local cfg = nil
  pcall(function()
    if zone_main and type(zone_main.ensure_identity) == "function" then
      have_identity_api = true
      cfg = zone_main.ensure_identity()
    elseif zone_main and type(zone_main.get_config) == "function" then
      have_identity_api = true
      cfg = zone_main.get_config()
    end
  end)
  if have_identity_api then
    local bad = (type(cfg) ~= "table")
      or (type(cfg.client_uuid) ~= "string" or cfg.client_uuid == ""
          or cfg.client_uuid == "anonymous")
      or (not tonumber(cfg.hwid_hash))
    if bad then
      self:ShowError(tr("ui_zone_error_identity",
        "Client identity is missing - cannot create a character"))
      return
    end
  end

  self:SaveCoopOptions()

  local faction  = self.selected_faction or "stalker"
  local money    = math.floor(self.selected_money or 0)

  local build_ok, items_str = pcall(self.BuildLoadoutItems, self)
  if not build_ok or type(items_str) ~= "string" then
    self:ShowError(tr("ui_zone_error_loadout_build", "Could not build the loadout"))
    return
  end
  if #items_str > MAX_LOADOUT_BYTES then
    self:ShowError(format_tr("ui_zone_error_loadout_oversize",
      "Loadout is too large for the server (%d/%d bytes)", #items_str, MAX_LOADOUT_BYTES))
    return
  end

  local send_ok, sent = pcall(function()
    return ZoneNet:SendCharacterSelect(faction, money, items_str)
  end)
  if not send_ok or not sent then
    self:ShowError(tr("ui_zone_error_send", "Failed to send the selection to the server."))
    return
  end

  self.submitted = true
  if self.text_error then self.text_error:SetText("") end
  self:HideDialog()
  CUIScriptWnd.Show(self, false)
end

-- Server-side failure (OpError 0x0077) or local precondition failure: reset the
-- one-shot submit latch and surface the reason inside the dialog.
function UIZonePeerFaction:ShowError(msg)
  self.submitted = nil
  msg = tostring(msg or "")
  if msg == "" then msg = "Character creation failed." end
  if self.text_error then
    pcall(function()
      self.text_error:SetText("%c[0,220,70,70]" .. msg)
    end)
  else
    -- No label in the layout: fall back to game news so the reason is visible.
    pcall(function()
      if db and db.actor then
        db.actor:give_game_news("Zone", msg, "ui_inGame2_PDA_icon", 0, 6000, 0)
      end
    end)
  end
  printf("Zone: faction dialog error: %s", msg)
  pcall(function()
    if not self:IsShown() then
      self:ShowDialog(true)
      self:Show(true)
    end
  end)
end

function UIZonePeerFaction:OnServerError(msg)
  self:ShowError(msg)
end

-- Stripped: Zone has no per-client coop toggles here.
function UIZonePeerFaction:SaveCoopOptions()
end

function UIZonePeerFaction:OnKeyboard(dik, keyboard_action)
  if not self.access then return end

  local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
  if res == false then
    for name, cc in pairs(self.CC) do
      if cc:IsShown() then
        cc:OnKeyboard(dik, keyboard_action)
      end
    end

    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
      if dik == DIK_keys.DIK_ESCAPE then
        self:OnQuit()
      end
    end
  end
  return res
end


----------------------------------------------------------------------
-- Singleton
----------------------------------------------------------------------
local _peer_dlg = nil

function open_peer_faction(owner)
  if not _peer_dlg then
    _peer_dlg = UIZonePeerFaction(owner)
  else
    if owner then _peer_dlg.owner = owner end
    _peer_dlg.submitted = nil
    _peer_dlg:Refresh()
  end
  _peer_dlg:ShowDialog(true)
  _peer_dlg:Show(true)
  return _peer_dlg
end

function get_peer_faction_dialog()
  return _peer_dlg
end
