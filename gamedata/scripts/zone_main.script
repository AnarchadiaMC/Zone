-- zone_main.script
-- Zone Bootstrap

local config = {}
local input_callbacks_registered = false

local function generate_random_uuid()
    math.randomseed(os.time() + (time_global and time_global() or 0))
    local template = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
    return string.gsub(template, "[xy]", function (c)
        local v = (c == "x") and math.random(0, 0xf) or math.random(8, 0xb)
        return string.format("%x", v)
    end)
end

local function generate_random_hwid()
    math.randomseed(os.time() + (time_global and time_global() or 0))
    return math.random(100000000, 999999999)
end

local CANONICAL_SECTION = "zone_identity"
local LEGACY_SECTION = "identity"
local IDENTITY_KEYS = {
    client_uuid = true, uuid = true,
    hwid_hash = true, hwid = true,
    nickname = true, server_ip = true, server_port = true,
}

local function read_file_lines(path)
    local lines = {}
    local file = io.open(path, "r")
    if not file then return lines end
    pcall(function()
        for line in file:lines() do lines[#lines + 1] = line end
    end)
    pcall(function() file:close() end)
    return lines
end

local function write_lines_to_file(path, lines)
    local file = io.open(path, "w")
    if not file then return false end
    local ok = pcall(function()
        for _, line in ipairs(lines) do file:write(line .. "\n") end
    end)
    pcall(function() file:close() end)
    return ok
end

-- Atomic persistence: write a temp file next to the target, then rename via
-- os.rename (remove the destination once and retry, since Windows refuses
-- rename-over-existing); fall back to a direct write when os.rename is
-- unavailable or keeps failing.
local function write_lines_atomic(path, lines)
    if type(os.rename) ~= "function" then
        return write_lines_to_file(path, lines)
    end
    local tmp = path .. ".tmp"
    if not write_lines_to_file(tmp, lines) then
        pcall(os.remove, tmp)
        return write_lines_to_file(path, lines)
    end
    local moved = false
    pcall(function() moved = (os.rename(tmp, path) == true) end)
    if not moved then
        pcall(os.remove, path)
        pcall(function() moved = (os.rename(tmp, path) == true) end)
    end
    if moved then return true end
    pcall(os.remove, tmp)
    return write_lines_to_file(path, lines)
end

-- Rewrite only the zone identity keys, in the canonical [zone_identity]
-- section (the section the injected DLL reads). Every other line - including
-- [zone_favorites]/[zone_history] and any unknown section written by the
-- server browser or future tools - is preserved verbatim. Legacy [identity]
-- sections are migrated in place: the header is normalized and legacy
-- uuid=/hwid= aliases are replaced by the canonical keys. A file without an
-- identity section gets one appended. Write is atomic when os.rename exists.
local function save_identity_config(cfg, path)
    local source = read_file_lines(path)
    local out = {}
    local inserted = false
    local current_section = nil

    local function canonical_lines()
        return {
            "[" .. CANONICAL_SECTION .. "]",
            string.format("client_uuid = %s", cfg.client_uuid or ""),
            string.format("hwid_hash = %d", tonumber(cfg.hwid_hash) or 0),
            string.format("nickname = %s", cfg.nickname or "Stalker"),
            string.format("server_ip = %s", cfg.server_ip or "127.0.0.1"),
            string.format("server_port = %d", tonumber(cfg.server_port) or 27015),
        }
    end

    for _, line in ipairs(source) do
        local sec = string.match(line, "^%s*%[([^%]]+)%]")
        if sec then
            current_section = string.lower(sec)
            if current_section == CANONICAL_SECTION or current_section == LEGACY_SECTION then
                if not inserted then
                    inserted = true
                    for _, l in ipairs(canonical_lines()) do out[#out + 1] = l end
                end
            else
                out[#out + 1] = line
            end
        elseif current_section == CANONICAL_SECTION or current_section == LEGACY_SECTION then
            local key = string.match(line, "^%s*([%w_]+)%s*=")
            if not (key and IDENTITY_KEYS[string.lower(key)]) then
                out[#out + 1] = line
            end
        else
            out[#out + 1] = line
        end
    end

    if not inserted then
        if #out > 0 and out[#out] ~= "" then out[#out + 1] = "" end
        for _, l in ipairs(canonical_lines()) do out[#out + 1] = l end
    end

    if not write_lines_atomic(path, out) then
        printf("Zone: [ERROR] Failed to save identity to %s", path)
        return false
    end
    printf("Zone: Saved identity to %s", path)
    return true
end

local function load_config()
    local fs = getFS and getFS()
    if not fs then
        printf("Zone: FileSystem not available")
        return false
    end
    local path = fs:update_path("$app_data_root$", "zone_identity.ltx")
    local file = io.open(path, "r")
    if not file then
        printf("Zone: [WARNING] Missing zone_identity.ltx in appdata! Generating unique client credentials.")
        config.client_uuid = generate_random_uuid()
        config.hwid_hash = generate_random_hwid()
        config.nickname = "Stalker"
        config.server_ip = "127.0.0.1"
        config.server_port = 27015
        save_identity_config(config, path)
        printf("Zone: [WARNING] Callsign set to default 'Stalker'. Please configure your callsign in Server Browser or zone_identity.ltx.")
        return true
    end
    
    -- Section-aware read: identity keys are only honored inside the canonical
    -- [zone_identity] section, the legacy [identity] section, or before the
    -- first section header (sectionless legacy files). Keys inside
    -- [zone_favorites]/[zone_history]/[server_history] are ignored.
    local current_section = ""
    for line in file:lines() do
        local sec = string.match(line, "^%s*%[([^%]]+)%]")
        if sec then
            current_section = string.lower(sec)
        elseif current_section == CANONICAL_SECTION or current_section == LEGACY_SECTION or current_section == "" then
            local key, val = string.match(line, "^%s*([%w_]+)%s*=%s*(.+)%s*$")
            if key and val then
                key = string.lower(key)
                if key == "client_uuid" or key == "uuid" then
                    config.client_uuid = val
                elseif key == "hwid_hash" or key == "hwid" then
                    config.hwid_hash = tonumber(val)
                elseif key == "nickname" then
                    config.nickname = val
                elseif key == "server_ip" then
                    config.server_ip = val
                elseif key == "server_port" then
                    config.server_port = tonumber(val)
                end
            end
        end
    end
    file:close()

    local updated = false
    if not config.client_uuid or config.client_uuid == "default_uuid" or config.client_uuid == "" or config.client_uuid == "anonymous" then
        config.client_uuid = generate_random_uuid()
        printf("Zone: [WARNING] Unconfigured client_uuid. Generated random UUID: %s", config.client_uuid)
        updated = true
    end

    if not config.hwid_hash or config.hwid_hash == 123456789 or config.hwid_hash == 0 then
        config.hwid_hash = generate_random_hwid()
        printf("Zone: [WARNING] Unconfigured hwid_hash. Generated random HWID: %d", config.hwid_hash)
        updated = true
    end

    if not config.nickname or config.nickname == "" or config.nickname == "Stalker" then
        printf("Zone: [WARNING] Callsign unconfigured or default ('%s'). Prompting player to configure callsign.", config.nickname or "nil")
        if not config.nickname or config.nickname == "" then
            config.nickname = "Stalker"
            updated = true
        end
    end

    if updated then
        save_identity_config(config, path)
    end

    return true
end

function on_game_start()
    -- Ensure safezone enforcement is registered even if the engine's
    -- per-script on_game_start ordering changes (idempotent there).
    pcall(function()
        if zone_safezone and zone_safezone.on_game_start then
            zone_safezone.on_game_start()
        end
    end)

    -- Register the save/load veto callbacks (declared in axr_main.script:217-218).
    -- Save is dispatched as (flags, source, text) and load as (dik, bind, flags);
    -- both are vetoed by setting flags.ret = true, not flags.ret_value
    -- (level_input.script:55-57 and 109-111, ui_main_menu.script:168-170).
    if RegisterScriptCallback and not input_callbacks_registered then
        input_callbacks_registered = true
        pcall(RegisterScriptCallback, "on_before_save_input", on_before_save_input)
        pcall(RegisterScriptCallback, "on_before_load_input", on_before_load_input)
    end

    if not (zone_net and zone_net.is_client_loaded and zone_net.is_client_loaded()) then
        printf("Zone: ZoneClient.dll native library not loaded! Inject the DLL first.")
        return
    end

    -- Tick must exist for browser-initiated connections too (browser never
    -- registers it). Register first, connect second.
    if RegisterScriptCallback and zone_net and zone_net.on_tick then
        pcall(RegisterScriptCallback, "actor_on_update", zone_net.on_tick)
    end

    -- Level-load/spawn callbacks belong to zone_net; ensure they are registered
    -- for browser-initiated joins as well as auto-dial sessions.
    if zone_net and zone_net.register_level_callbacks then
        pcall(zone_net.register_level_callbacks)
    end

    -- Already connected from the main-menu browser: keep that session, don't
    -- clobber it with the stored identity.
    local already = false
    pcall(function()
        if ZoneNet and ZoneNet:IsConnected() then already = true end
    end)
    if already then
        printf("Zone: keeping browser session")
        return
    end

    -- xrRazom compatibility: never auto-dial Zone when co-op owns the world.
    local xrr_active = false
    pcall(function()
        if _G.XrrIsConnected and _G.XrrIsConnected() then xrr_active = true end
        if _G.XrrIsHosted and _G.XrrIsHosted() then xrr_active = true end
    end)
    if xrr_active then
        printf("Zone: xrRazom session active, Zone staying offline")
        return
    end

    if not load_config() then
        printf("Zone: Failed to load config.")
        return
    end

    local ip = config.server_ip or "127.0.0.1"
    local port = config.server_port or 27015
    local uuid = config.client_uuid
    local hwid = config.hwid_hash
    local nick = config.nickname or "Stalker"

    -- NOTE: engine printf supports %s only.
    printf(string.format("Zone: Connecting to %s:%s as %s",
        tostring(ip), tostring(port), tostring(nick)))
    pcall(function() ZoneNet:Connect(ip, port, uuid, hwid, nick) end)
end

function get_config()
    return config
end
-- Public identity gate for the server browser: initializes/loads
-- zone_identity.ltx (generating uuid/hwid when missing and persisting them)
-- and returns the config table, or nil when no usable identity is available.
-- The browser must call this before Connect so a first-run client never
-- connects as a shared anonymous account.
function ensure_identity()
    if not load_config() then return nil end
    local uuid = config.client_uuid
    local hwid = tonumber(config.hwid_hash) or 0
    if type(uuid) ~= "string" or uuid == "" or uuid == "anonymous" or hwid == 0 then
        return nil
    end
    -- Guard against a silently failed write: require the uuid to be readable
    -- back from the identity file before allowing a connection.
    local fs = getFS and getFS()
    local path = fs and fs:update_path("$app_data_root$", "zone_identity.ltx")
    if not path then return nil end
    local persisted = false
    pcall(function()
        local f = io.open(path, "r")
        if not f then return end
        local section = ""
        for line in f:lines() do
            local sec = string.match(line, "^%s*%[([^%]]+)%]")
            if sec then
                section = string.lower(sec)
            elseif section == CANONICAL_SECTION or section == LEGACY_SECTION or section == "" then
                local k, v = string.match(line, "^%s*([%w_]+)%s*=%s*(.+)%s*$")
                if k and v and v == uuid then
                    k = string.lower(k)
                    if k == "client_uuid" or k == "uuid" then
                        persisted = true
                        break
                    end
                end
            end
        end
        f:close()
    end)
    if not persisted then return nil end
    return config
end
-- Single owner of OpShowStart (0x0071): only open the faction/loadout dialog
-- when the server says this player still needs a character (SHOW_START).
-- The server browser (if visible) is hidden first and restored by the dialog's
-- Back button, so the whole flow stays in the menu until a level is started.
function on_show_start(pkt, offset)
    local pending = false
    pcall(function()
        if ZoneNet and ZoneNet.IsPendingCreate then
            pending = ZoneNet:IsPendingCreate() and true or false
        end
    end)
    if not pending then return end

    local browser = nil
    pcall(function()
        if zone_ui_server_list and zone_ui_server_list.get_dialog then
            browser = zone_ui_server_list.get_dialog()
        end
    end)
    if browser then
        pcall(function() browser:HideDialog() end)
        pcall(function() browser:Show(false) end)
    end

    pcall(function()
        local open_fn = _G.open_peer_faction
        if type(open_fn) ~= "function" and zone_ui_peer_faction then
            open_fn = zone_ui_peer_faction.open_peer_faction
        end
        if type(open_fn) == "function" then
            open_fn(browser)
        end
    end)
end
local function zone_is_connected()
    local connected = false
    pcall(function()
        if ZoneNet and ZoneNet.IsConnected then
            connected = ZoneNet:IsConnected() and true or false
        end
    end)
    return connected
end
-- Veto convention verified against the base scripts: the save dispatchers
-- call SendScriptCallback("on_before_save_input", flags, n, text) and abort
-- when flags.ret == true (level_input.script:53-59, ui_main_menu.script:166-172,
-- ui_main_menu.script:309-313); quick load calls
-- SendScriptCallback("on_before_load_input", dik, bind, flags) with the same
-- flags.ret veto (level_input.script:108-113).
function on_before_save_input(flags, typ, text)
    if type(flags) ~= "table" then return end
    if zone_is_connected() then flags.ret = true end
end
function on_before_load_input(dik, bind, flags)
    if type(flags) ~= "table" then return end
    if zone_is_connected() then
        pcall(function()
            if db and db.actor then db.actor:give_game_news("Zone", "Disconnect before loading.", "ui_inGame2_PDA_icon", 0, 3000, 0) end
        end)
        flags.ret = true
    end
end
function get_server_spawn()
    local x, y, z = 0, 0, 0
    pcall(function()
        if ZoneNet and ZoneNet.GetSpawn then x, y, z = ZoneNet:GetSpawn() end
    end)
    return x, y, z
end
function has_server_character()
    local has = false
    pcall(function()
        if ZoneNet and ZoneNet.HasCharacter then has = ZoneNet:HasCharacter() and true or false end
    end)
    return has
end
