local function argb(a, r, g, b)
    if GetARGB then
        local ok, c = pcall(GetARGB, a, r, g, b)
        if ok and type(c) == "number" then return c end
    end
    return (a * 16777216) + (r * 65536) + (g * 256) + b
end

local AMBER = argb(255, 255, 195, 5)
local GREEN = argb(255, 80, 220, 80)
local RED = argb(255, 220, 70, 70)
local GRAY = argb(255, 165, 165, 158)
local WHITE = argb(255, 225, 225, 215)
local DIM = argb(255, 140, 140, 134)

local LAMP_OFF = "ui_inGame2_lamp_OFF"
local LAMP_RED = "ui_inGame2_lamp_RED"
local LAMP_GREEN = "ui_inGame2_lamp_GREEN"

if not ui_events then ui_events = {} end

local function tr(id)
    local ok, s = pcall(function() return game.translate_string(id) end)
    if ok and type(s) == "string" and s ~= "" and s ~= id then return s end
    return id
end

local function tr_or(id, fallback)
    local s = tr(id)
    if s == id then return fallback end
    return s
end

-- DLL/handshake error -> localized message (single source: zone_net mapper).
local function localize_net_error(raw)
    if type(raw) ~= "string" or raw == "" then return raw end
    local out = raw
    pcall(function()
        if ZoneNet and type(ZoneNet.LocalizeError) == "function" then
            out = ZoneNet:LocalizeError(raw) or raw
        end
    end)
    return out
end

-- Classify a probe failure for per-row display.
local function probe_failure_kind(reason)
    local low = tostring(reason or ""):lower()
    if low:find("timed out", 1, true) or low:find("timeout", 1, true) then
        return "ui_zone_row_fail_timeout"
    end
    if low:find("refused", 1, true) or low:find("reject", 1, true) then
        return "ui_zone_row_fail_refused"
    end
    return "ui_zone_row_fail_bad"
end

-- Identity gate: zone_main owns zone_identity.ltx. Returns the config table
-- with a real uuid/hwid, or nil when no identity could be established. The
-- browser must never connect with the shared "anonymous" placeholder.
local function client_identity()
    local cfg = nil
    pcall(function()
        if not zone_main then return end
        if type(zone_main.ensure_identity) == "function" then
            cfg = zone_main.ensure_identity()
        elseif type(zone_main.get_config) == "function" then
            cfg = zone_main.get_config()
        end
    end)
    if type(cfg) ~= "table" then return nil end
    local uuid = cfg.client_uuid
    if type(uuid) ~= "string" or uuid == "" or uuid == "anonymous" then return nil end
    if not tonumber(cfg.hwid_hash) then return nil end
    return cfg
end

local function set_widget_text(wnd, text, color)
    if not wnd then return end
    pcall(function()
        local tc = nil
        if wnd.TextControl then tc = wnd:TextControl() end
        if tc then
            if tc.SetText then tc:SetText(tostring(text)) end
            if color and tc.SetTextColor then tc:SetTextColor(color) end
        end
        if wnd.SetText then wnd:SetText(tostring(text)) end
        if color and wnd.SetTextColor then wnd:SetTextColor(color) end
    end)
end

local function field_text(id, value)
    return "%c[0,140,140,134]" .. tr(id) .. ": %c[0,225,225,215]" .. tostring(value)
end

-- UTF-8 safe truncation: never cut inside a multibyte sequence, and strip
-- control characters (server-provided names/maps are untrusted).
local function utf8_safe_prefix(s, max_bytes)
    if type(s) ~= "string" then return "" end
    s = s:gsub("[%z\1-\8\11\12\14-\31\127]", "")
    if #s <= max_bytes then return s end
    local cut = max_bytes
    local b = s:byte(cut)
    -- Walk back over continuation bytes (0x80..0xBF) to the sequence lead.
    while cut > 1 and b and b >= 128 and b < 192 do
        cut = cut - 1
        b = s:byte(cut)
    end
    if b and b >= 192 then
        local need = 2
        if b >= 240 then need = 4
        elseif b >= 224 then need = 3 end
        if cut + need - 1 > max_bytes then cut = cut - 1 end
    end
    if cut < 0 then cut = 0 end
    return s:sub(1, cut)
end

local function clip_text(s, n)
    if type(s) ~= "string" then return "" end
    local prefix = utf8_safe_prefix(s, n)
    if prefix == s then return prefix end
    return prefix .. "."
end

local function mode_name(m)
    m = tonumber(m) or 0
    if m <= 0 then return "Co-op" end
    return "M" .. tostring(math.floor(m))
end

local function valid_host(h)
    if type(h) ~= "string" or h == "" or #h > 253 then return false end
    if h:match("^%d+%.%d+%.%d+%.%d+$") then
        for octet in h:gmatch("(%d+)") do
            local n = tonumber(octet)
            if not n or n < 0 or n > 255 then return false end
        end
        return true
    end
    return h:match("^[%w][%w%.%-]*[%w]$") ~= nil
end

local function get_identity_path()
    local fs = getFS and getFS()
    if fs then
        return fs:update_path("$app_data_root$", "zone_identity.ltx")
    end
    return "appdata\\zone_identity.ltx"
end

local function sanitize_nickname(nick)
    if not nick then return "Stalker" end
    local cleaned = nick:gsub("[%[%]=%c\r\n\t]", ""):match("^%s*(.-)%s*$")
    if not cleaned or cleaned == "" then return "Stalker" end
    if #cleaned > 24 then cleaned = cleaned:sub(1, 24) end
    return cleaned
end

local function sanitize_label(label, fallback_ip, fallback_port)
    if not label or label:match("^%s*$") then
        if fallback_ip and fallback_port then
            return string.format("%s:%s", tostring(fallback_ip), tostring(fallback_port))
        end
        return "Server"
    end
    local cleaned = label:gsub("[%[%]=%c\r\n\t|]", ""):match("^%s*(.-)%s*$")
    if not cleaned or cleaned == "" then
        if fallback_ip then return string.format("%s:%s", tostring(fallback_ip), tostring(fallback_port)) end
        return "Server"
    end
    if #cleaned > 32 then cleaned = utf8_safe_prefix(cleaned, 32) end
    return cleaned
end

local function split_pipe(s)
    local t = {}
    for part in string.gmatch(s, "[^|]+") do t[#t + 1] = part end
    return t
end

local function now_timestamp()
    local ok, ts = pcall(function()
        if os and os.time then return os.time() end
    end)
    if ok and ts and type(ts) == "number" then return ts end
    local ok2, tg = pcall(function() return time_global and time_global() or 0 end)
    if ok2 and tg then return math.floor(tg / 1000) end
    return 0
end

local function age_text(ts)
    ts = tonumber(ts) or 0
    if ts <= 0 then return "-" end
    local d = now_timestamp() - ts
    if d < 0 then d = 0 end
    if d < 60 then return string.format("%ds", math.floor(d)) end
    if d < 3600 then return string.format("%dm", math.floor(d / 60)) end
    if d < 86400 then return string.format("%dh", math.floor(d / 3600)) end
    return string.format("%dd", math.floor(d / 86400))
end

local function parse_entry(raw, is_fav_default)
    if not raw or raw:match("^%s*$") then return nil end
    raw = raw:match("^%s*(.-)%s*$")
    local parts = split_pipe(raw)
    if #parts == 0 then return nil end

    local label = nil
    local ipport = nil
    local flagStr = nil
    local tsStr = nil
    local protoStr = nil
    local addedStr = nil

    if #parts == 1 then
        local s = parts[1]
        if s:match(":%d+$") then
            ipport = s
            label = s
        else
            return nil
        end
    elseif #parts == 2 then
        label = parts[1]:match("^%s*(.-)%s*$")
        ipport = parts[2]:match("^%s*(.-)%s*$")
    else
        label = parts[1]:match("^%s*(.-)%s*$")
        ipport = parts[2]:match("^%s*(.-)%s*$")
        flagStr = parts[3]
        if #parts >= 4 then tsStr = parts[4] end
        if #parts >= 5 then protoStr = parts[5] end
        if #parts >= 6 then addedStr = parts[6] end
    end

    if not ipport then return nil end
    local ip, port = ipport:match("^([^:]+):(%d+)$")
    if not ip or not port then return nil end
    ip = ip:match("^%s*(.-)%s*$")
    port = tonumber(port)
    if not port or port < 1 or port > 65535 then return nil end

    label = sanitize_label(label, ip, port)

    local is_fav = is_fav_default
    if flagStr then
        flagStr = flagStr:match("^%s*(.-)%s*$")
        if flagStr == "1" or flagStr:lower() == "fav" or flagStr:lower() == "true" then
            is_fav = true
        elseif flagStr == "0" or flagStr:lower() == "hist" or flagStr:lower() == "false" then
            is_fav = false
        end
        if tonumber(flagStr) and #parts == 3 and tonumber(flagStr) > 100000 then
            tsStr = flagStr
        end
    end

    local lastSeen = 0
    if tsStr then
        lastSeen = tonumber(tsStr:match("^%s*(.-)%s*$")) or 0
    end
    if lastSeen == 0 then lastSeen = now_timestamp() end

    local proto = 0
    if protoStr then proto = tonumber(protoStr) or 0 end
    local added = 0
    if addedStr then added = tonumber(addedStr) or 0 end
    if added == 0 then added = lastSeen end

    -- Persisted format (back-compatible):
    --   label|ip:port|fav|last_seen|proto|added
    return {
        label = label,
        ip = ip,
        port = port,
        is_fav = is_fav,
        status = is_fav and "Favorite" or "Recent",
        lastSeen = lastSeen,
        added = added,
        proto = proto,
        fail_count = 0,
        retry_at = 0,
        state = nil,
        query = nil
    }
end

local function find_entry_by_addr(list, ip, port)
    for idx, e in ipairs(list) do
        if e.ip == ip and e.port == port then return e, idx end
    end
    return nil, nil
end

local function write_lines_to_file(path, lines)
    local ok_open, out = pcall(io.open, path, "w")
    if not ok_open or not out then return false end
    local write_ok = true
    pcall(function()
        for _, l in ipairs(lines) do
            if out:write(l .. "\n") == nil then write_ok = false break end
        end
    end)
    pcall(function() out:close() end)
    return write_ok
end

-- Atomic persistence: write a temp file next to the target, then rename.
-- Windows rename-over-existing can fail, so remove the destination once and
-- retry. If os.rename is unavailable (or keeps failing), fall back to a direct
-- non-atomic write.
local function write_lines_atomic(path, lines)
    if type(os.rename) ~= "function" then
        -- No atomic rename available: direct write fallback (non-atomic).
        return write_lines_to_file(path, lines)
    end
    local tmp = path .. ".tmp"
    if not write_lines_to_file(tmp, lines) then
        pcall(os.remove, tmp)
        return write_lines_to_file(path, lines)
    end
    -- os.rename reports failure by returning nil, err (it does not raise).
    local moved = false
    pcall(function() moved = (os.rename(tmp, path) == true) end)
    if not moved then
        pcall(os.remove, path)
        pcall(function() moved = (os.rename(tmp, path) == true) end)
    end
    if moved then return true end
    pcall(os.remove, tmp)
    -- Rename keeps failing (locked file): last-resort direct write.
    return write_lines_to_file(path, lines)
end

local _server_browser_dlg = nil

class "UIZoneServerList" (CUIScriptWnd)

function UIZoneServerList:__init(owner)
    super()
    self.owner = owner
    local ok, rect = pcall(function() return Frect():set(0, 0, 1024, 768) end)
    if ok and rect then
        pcall(function() self:SetWndRect(rect) end)
    end
    pcall(function() self:Enable(true) end)

    self.favorites = {}
    self.history = {}
    self.rows = {}
    self.sel_entry = nil
    self.tab_id = TAB_INTERNET

    self.uuid = nil
    self.hwid = 0
    self.nick = "Stalker"
    self.edit_focus = 0

    self.state = STATE_IDLE
    self.state_detail = ""

    self.scan_active = false
    self.scan_queue = nil
    self.scan_index = nil
    self.scan_discoveries = false
    self.scan_prev_connected = false
    self.broadcast_hit = nil

    -- Async scheduler state.
    self.async_ok = nil
    self.scan_gen = 0
    self.query_inflight = {}
    self.queue_internet = {}
    self.queue_lan = {}
    self.scan_total = 0
    self.scan_done = 0
    self.last_fail_reason = nil
    self.last_retry_service = 0
    -- Post-scan summary and persistent-failure reporting.
    self.scan_ok = 0
    self.scan_timeouts = 0
    self.scan_summary = nil
    self.persist_error = nil
    self.module_error_logged = false

    -- Row model widgets keyed by ip:port, and their view indices.
    self.row_widgets = {}
    self.row_index = {}
    self.view_dirty = false

    -- Sort/filter view state.
    self.sort_key = "ping"
    self.sort_asc = true
    self.filter_text = ""
    self.filter_editing = false
    self.hide_full = false
    self.hide_empty = false
    self.hide_locked = false
    self.max_ping = 0
    self.own_proto = nil

    self.connect_ip = nil
    self.connect_port = nil
    self.connect_start = 0
    self.last_connect_poll = 0

    self.spinner_shown = false
    self.spin_on = false
    self.last_spin = 0
end

function UIZoneServerList:__finalize()
    self:AbortScan()
    -- Never let keyboard capture outlive the window.
    pcall(function() self:ReleaseEditFocus() end)
    self.filter_editing = false
    _server_browser_dlg = nil
end

function UIZoneServerList:Now()
    local t = 0
    pcall(function() if time_global then t = time_global() end end)
    if not t or t == 0 then
        pcall(function()
            local dev = device and device()
            if dev and dev.time_continual then t = dev:time_continual() end
        end)
    end
    return t or 0
end

function UIZoneServerList:NetAvailable()
    local ok, avail = pcall(function()
        return ZoneNet ~= nil and type(ZoneNet.QueryServer) == "function"
    end)
    return ok and avail and true or false
end

function UIZoneServerList:AsyncAvailable()
    local avail = false
    pcall(function()
        if ZoneNet and type(ZoneNet.HasAsyncQuery) == "function" then
            avail = ZoneNet:HasAsyncQuery() and true or false
        end
    end)
    return avail
end

function UIZoneServerList:ClientLoaded()
    local loaded = false
    pcall(function()
        if zone_net and type(zone_net.is_client_loaded) == "function" then
            loaded = zone_net.is_client_loaded() and true or false
        elseif ZoneNet and type(ZoneNet.IsClientLoaded) == "function" then
            loaded = ZoneNet:IsClientLoaded() and true or false
        end
    end)
    return loaded
end

local function xml_init(xml, method, path, parent)
    local wnd = nil
    pcall(function() wnd = xml[method](xml, path, parent) end)
    return wnd
end

function UIZoneServerList:InitControls()
    -- The dialog instance is cached and reused for the whole session. Auto-delete
    -- would destroy it on HideDialog (engine takes ownership when the dialog is
    -- hidden), leaving the cache dangling and crashing the next frame that touches
    -- it. Keep ownership in Lua and only hide/show.
    self:SetAutoDelete(false)

    pcall(function()
        if getFS then
            local fs = getFS()
            if fs then
                if fs.path_exist then
                    local ok_alias, has_alias = pcall(function() return fs:path_exist("$game_config$") end)
                    if ok_alias and has_alias and fs.rescan_path then
                        pcall(function() fs:rescan_path("$game_config$") end)
                    end
                end
                if fs.rescan_pathes then pcall(function() fs:rescan_pathes() end) end
            end
        end
    end)

    local fs_ok = false
    pcall(function()
        local fs = getFS and getFS()
        if fs and fs.exist then
            fs_ok = fs:exist("$game_config$", "ui\\zone_ui_server_list.xml") and true or false
        end
    end)
    if not fs_ok then
        printf("Zone UI: server list XML not in FS cache - restart game once after first inject")
        return false
    end

    local xml = CScriptXmlInit()
    local parsed = false
    pcall(function()
        xml:ParseFile(DIALOG_XML)
        parsed = true
    end)
    if not parsed then
        printf("Zone UI: failed to parse " .. DIALOG_XML)
        return false
    end

    self.background = xml_init(xml, "InitStatic", "background", self)
    self.window_frame = xml_init(xml, "InitStatic", "window_frame", self)
    self.title = xml_init(xml, "InitStatic", "title", self)
    self.accent_line = xml_init(xml, "InitStatic", "accent_line", self)
    self.header_lamp = xml_init(xml, "InitStatic", "header_lamp", self)
    self.status_header = xml_init(xml, "InitStatic", "status_header", self)

    self.tabs = xml_init(xml, "InitTab", "tabs", self)
    if self.tabs then self:Register(self.tabs, "tabs") end

    -- Sortable column headers are real 3tButtons: CUIStatic never emits
    -- WINDOW_LBUTTON_DOWN in this engine, so click handling must ride on
    -- BUTTON_CLICKED (bound in InitCallBacks).
    self.col_name = xml_init(xml, "Init3tButton", "btn_col_name", self)
    self.col_map = xml_init(xml, "Init3tButton", "btn_col_map", self)
    self.col_players = xml_init(xml, "Init3tButton", "btn_col_players", self)
    self.col_ping = xml_init(xml, "Init3tButton", "btn_col_ping", self)
    self.col_mode = xml_init(xml, "Init3tButton", "btn_col_mode", self)

    self.list_frame = xml_init(xml, "InitFrame", "list_frame", self)
    self.list_servers = xml_init(xml, "InitListBox", "list", self)
    if self.list_servers then self:Register(self.list_servers, "server_list") end

    self.empty_title = xml_init(xml, "InitStatic", "empty_title", self)
    self.empty_hint = xml_init(xml, "InitStatic", "empty_hint", self)

    self.details_bg = xml_init(xml, "InitFrame", "details_bg", self)
    self.details_title = xml_init(xml, "InitStatic", "details_title", self)
    self.details_body = xml_init(xml, "InitTextWnd", "details_body", self)
    if self.details_body and self.details_body.SetTextComplexMode then
        pcall(function() self.details_body:SetTextComplexMode(true) end)
    end

    self.direct_bg = xml_init(xml, "InitFrame", "direct_bg", self)
    self.direct_title = xml_init(xml, "InitStatic", "direct_title", self)
    self.host_label = xml_init(xml, "InitStatic", "host_label", self)
    self.host_bg = xml_init(xml, "InitFrameLine", "host_bg", self)
    self.edit_ip = xml_init(xml, "InitEditBox", "edit_ip", self)
    self.port_label = xml_init(xml, "InitStatic", "port_label", self)
    self.port_bg = xml_init(xml, "InitFrameLine", "port_bg", self)
    self.edit_port = xml_init(xml, "InitEditBox", "edit_port", self)
    self.nick_label = xml_init(xml, "InitStatic", "nick_label", self)
    self.nick_bg = xml_init(xml, "InitFrameLine", "nick_bg", self)
    self.edit_nick = xml_init(xml, "InitEditBox", "edit_nick", self)

    if self.edit_ip then self:Register(self.edit_ip, "edit_ip") end
    if self.edit_port then self:Register(self.edit_port, "edit_port") end
    if self.edit_nick then self:Register(self.edit_nick, "edit_nick") end

    self.status_bg = xml_init(xml, "InitFrameLine", "status_bg", self)
    self.status_label = xml_init(xml, "InitStatic", "status_label", self)
    self.spinner = xml_init(xml, "InitAnimStatic", "spinner", self)
    if self.spinner then pcall(function() self.spinner:Show(false) end) end

    self.btn_connect = xml_init(xml, "Init3tButton", "btn_connect", self)
    self.btn_favorite = xml_init(xml, "Init3tButton", "btn_favorite", self)
    self.btn_remove = xml_init(xml, "Init3tButton", "btn_remove", self)
    self.btn_refresh = xml_init(xml, "Init3tButton", "btn_refresh", self)
    self.btn_back = xml_init(xml, "Init3tButton", "btn_back", self)

    if self.btn_connect then self:Register(self.btn_connect, "btn_connect") end
    if self.btn_favorite then self:Register(self.btn_favorite, "btn_favorite") end
    if self.btn_remove then self:Register(self.btn_remove, "btn_remove") end
    if self.btn_refresh then self:Register(self.btn_refresh, "btn_refresh") end
    if self.btn_back then self:Register(self.btn_back, "btn_back") end

    if self.col_name then self:Register(self.col_name, "btn_col_name") end
    if self.col_map then self:Register(self.col_map, "btn_col_map") end
    if self.col_players then self:Register(self.col_players, "btn_col_players") end
    if self.col_ping then self:Register(self.col_ping, "btn_col_ping") end
    if self.col_mode then self:Register(self.col_mode, "btn_col_mode") end

    if self.edit_ip and self.edit_port and self.edit_ip.SetNextFocusCapturer then
        pcall(function() self.edit_ip:SetNextFocusCapturer(self.edit_port) end)
    end
    if self.edit_port and self.edit_nick and self.edit_port.SetNextFocusCapturer then
        pcall(function() self.edit_port:SetNextFocusCapturer(self.edit_nick) end)
    end
    if self.edit_nick and self.edit_ip and self.edit_nick.SetNextFocusCapturer then
        pcall(function() self.edit_nick:SetNextFocusCapturer(self.edit_ip) end)
    end

    self.tab_id = self:GetActiveTabId()
    if self.tabs and self.tabs.SetActiveTab then
        pcall(function() self.tabs:SetActiveTab(self.tab_id) end)
    end
    self:UpdateLabels()
    self:LoadFavorites()
    self:UpdateDirectVisibility()
    self:UpdateStatus()
    return true
end

function UIZoneServerList:InitCallBacks()
    if self.btn_connect then
        self:AddCallback("btn_connect", ui_events.BUTTON_CLICKED, self.OnConnect, self)
    end
    if self.btn_favorite then
        self:AddCallback("btn_favorite", ui_events.BUTTON_CLICKED, self.OnToggleFavorite, self)
    end
    if self.btn_remove then
        self:AddCallback("btn_remove", ui_events.BUTTON_CLICKED, self.OnRemove, self)
    end
    if self.btn_refresh then
        self:AddCallback("btn_refresh", ui_events.BUTTON_CLICKED, self.OnRefresh, self)
    end
    if self.btn_back then
        self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    end
    if self.tabs then
        self:AddCallback("tabs", ui_events.TAB_CHANGED, self.OnTabChanged, self)
    end
    if self.list_servers and ui_events.LIST_ITEM_CLICKED then
        self:AddCallback("server_list", ui_events.LIST_ITEM_CLICKED, self.OnListSelect, self)
        if ui_events.WINDOW_LBUTTON_DB_CLICK then
            self:AddCallback("server_list", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnConnect, self)
        end
    end
    -- Sortable column headers: clicking a header button selects that column
    -- (Mode cycles Mode/Proto/Lock).
    if ui_events.BUTTON_CLICKED then
        local function header_cb(ctrl, name, fn)
            if not ctrl then return end
            self:AddCallback(name, ui_events.BUTTON_CLICKED, fn, self)
        end
        header_cb(self.col_name, "btn_col_name", self.OnSortName)
        header_cb(self.col_map, "btn_col_map", self.OnSortMap)
        header_cb(self.col_players, "btn_col_players", self.OnSortPlayers)
        header_cb(self.col_ping, "btn_col_ping", self.OnSortPing)
        header_cb(self.col_mode, "btn_col_mode", self.OnSortMode)
    end
end

function UIZoneServerList:UpdateLabels()
    set_widget_text(self.title, tr("ui_zone_title"), AMBER)
    set_widget_text(self.col_name, tr("ui_zone_col_name"), AMBER)
    set_widget_text(self.col_map, tr("ui_zone_col_map"), AMBER)
    set_widget_text(self.col_players, tr("ui_zone_col_players"), AMBER)
    set_widget_text(self.col_ping, tr("ui_zone_col_ping"), AMBER)
    set_widget_text(self.col_mode, tr("ui_zone_col_mode"), AMBER)
    set_widget_text(self.details_title, tr("ui_zone_details"), AMBER)
    set_widget_text(self.direct_title, tr("ui_zone_tab_direct"), AMBER)
    set_widget_text(self.host_label, tr("ui_zone_direct_host"), WHITE)
    set_widget_text(self.port_label, tr("ui_zone_direct_port"), WHITE)
    set_widget_text(self.nick_label, tr("ui_zone_direct_nick"), WHITE)
    set_widget_text(self.btn_connect, tr("ui_zone_btn_connect"), nil)
    set_widget_text(self.btn_favorite, tr("ui_zone_btn_favorite"), nil)
    set_widget_text(self.btn_remove, tr("ui_zone_btn_remove"), nil)
    set_widget_text(self.btn_refresh, tr("ui_zone_btn_refresh"), nil)
    set_widget_text(self.btn_back, tr("ui_zone_btn_back"), nil)
    if self.tabs and self.tabs.GetButtonById then
        local function cap(id, text)
            pcall(function()
                local b = self.tabs:GetButtonById(id)
                if b and b.TextControl then b:TextControl():SetText(text) end
            end)
        end
        cap(TAB_INTERNET, tr("ui_zone_tab_internet"))
        cap(TAB_LAN, tr("ui_zone_tab_lan"))
        cap(TAB_FAVORITES, tr("ui_zone_tab_favorites"))
        cap(TAB_DIRECT, tr("ui_zone_tab_direct"))
    end
    self:UpdateSortMarkers()
end

function UIZoneServerList:UpdateSortMarkers()
    local arrow = (self.sort_asc == false) and " v" or " ^"
    local key = self.sort_key or "ping"
    local ctrl, id = nil, nil
    if key == "name" then ctrl, id = self.col_name, "ui_zone_col_name"
    elseif key == "map" then ctrl, id = self.col_map, "ui_zone_col_map"
    elseif key == "players" then ctrl, id = self.col_players, "ui_zone_col_players"
    elseif key == "ping" then ctrl, id = self.col_ping, "ui_zone_col_ping"
    elseif key == "mode" then ctrl, id = self.col_mode, "ui_zone_col_mode"
    elseif key == "proto" then ctrl, id = self.col_mode, "ui_zone_col_proto"
    elseif key == "lock" then ctrl, id = self.col_mode, "ui_zone_lock"
    end
    if ctrl then
        set_widget_text(ctrl, tr(id) .. arrow, AMBER)
    end
end

function UIZoneServerList:GetActiveTabId()
    local id = nil
    pcall(function()
        if self.tabs and self.tabs.GetActiveId then id = self.tabs:GetActiveId() end
    end)
    if type(id) ~= "string" or id == "" then id = TAB_INTERNET end
    if id ~= TAB_INTERNET and id ~= TAB_LAN and id ~= TAB_FAVORITES and id ~= TAB_DIRECT then
        id = TAB_INTERNET
    end
    return id
end

function UIZoneServerList:IsDirectTab()
    return self.tab_id == TAB_DIRECT
end

-- Persistence failure is surfaced once in the status footer and kept there
-- until a save succeeds; never spam per entry.
function UIZoneServerList:ReportPersistError()
    if self.persist_error then return end
    self.persist_error = tr("ui_zone_favorites_write_failed")
    printf("Zone UI Error: identity file not writable")
    self:UpdateStatus()
end

-- External error surface used by zone_net (drop reasons, join failures).
-- Only rewrites the visible footer while the browser is actually shown.
function UIZoneServerList:ReportError(msg)
    msg = tostring(msg or "")
    if msg == "" then return end
    self.last_fail_reason = msg
    local shown = false
    pcall(function() shown = self:IsShown() and true or false end)
    if shown then
        self:SetState(STATE_FAILED, msg)
    end
end

function UIZoneServerList:LoadFavorites()
    self.favorites = {}
    self.history = {}
    self.sel_entry = nil

    local path = get_identity_path()
    local ok_open, file, open_err = pcall(io.open, path, "r")
    if ok_open and not file and type(open_err) == "string"
        and open_err:lower():find("denied", 1, true) then
        self:ReportPersistError()
    end
    if ok_open and file then
        local current_section = ""
        local legacy_buffer = {}
        local fav_buffer = {}
        local hist_buffer = {}
        local ok_lines = pcall(function()
            for line in file:lines() do
                local sec = line:match("^%s*%[([^%]]+)%]")
                if sec then
                    current_section = sec:lower()
                else
                    local k, v = line:match("^%s*([%w_]+)%s*=%s*(.+)%s*$")
                    if k and v then
                        k = k:lower()
                        v = v:match("^%s*(.-)%s*$")
                        if current_section == FAVORITES_SEC:lower() then
                            local e = parse_entry(v, true)
                            if e and #fav_buffer < MAX_FAVORITES then
                                e.is_fav = true
                                e.status = "Favorite"
                                fav_buffer[#fav_buffer + 1] = e
                            end
                        elseif current_section == HISTORY_SEC:lower() then
                            local e = parse_entry(v, false)
                            if e and #hist_buffer < MAX_HISTORY then
                                e.is_fav = false
                                e.status = "Recent"
                                hist_buffer[#hist_buffer + 1] = e
                            end
                        elseif current_section == LEGACY_SEC:lower() then
                            local e = parse_entry(v, false)
                            if e then legacy_buffer[#legacy_buffer + 1] = e end
                        elseif current_section == IDENTITY_SEC:lower() or current_section == "" then
                            if k == "nickname" then
                                self.nick = sanitize_nickname(v)
                            elseif k == "uuid" or k == "client_uuid" then
                                self.uuid = v
                            elseif k == "hwid" or k == "hwid_hash" then
                                self.hwid = tonumber(v) or self.hwid
                            end
                        end
                    end
                end
            end
        end)
        pcall(function() file:close() end)
        if ok_lines then
            if #fav_buffer == 0 and #hist_buffer == 0 and #legacy_buffer > 0 then
                for _, e in ipairs(legacy_buffer) do
                    if #fav_buffer < MAX_FAVORITES then
                        e.is_fav = true
                        e.status = "Favorite"
                        fav_buffer[#fav_buffer + 1] = e
                    elseif #hist_buffer < MAX_HISTORY then
                        e.is_fav = false
                        e.status = "Recent"
                        hist_buffer[#hist_buffer + 1] = e
                    end
                end
            end
            self.favorites = fav_buffer
            self.history = hist_buffer
        end
    end

    pcall(function()
        if zone_main and zone_main.get_config then
            local cfg = zone_main.get_config()
            if cfg.client_uuid and (self.uuid == nil or self.uuid == "" or self.uuid == "anonymous") then
                self.uuid = cfg.client_uuid
            end
            if cfg.hwid_hash and self.hwid == 0 then self.hwid = cfg.hwid_hash end
            if cfg.nickname and self.nick == "Stalker" then self.nick = sanitize_nickname(cfg.nickname) end
        end
    end)

    if #self.favorites == 0 and #self.history == 0 then
        local ts = now_timestamp()
        self.favorites[1] = {
            label = "Local Dev Server",
            ip = "127.0.0.1",
            port = DEFAULT_PORT,
            is_fav = true,
            status = "Favorite",
            lastSeen = ts,
            added = ts,
            proto = 0,
            fail_count = 0,
            retry_at = 0,
            state = nil,
            query = nil
        }
    end

    table.sort(self.history, function(a, b) return (a.lastSeen or 0) > (b.lastSeen or 0) end)

    pcall(function() if self.edit_nick then self.edit_nick:SetText(self.nick) end end)
    local seed = self.sel_entry or self.favorites[1] or self.history[1]
    if seed then
        pcall(function() if self.edit_ip then self.edit_ip:SetText(seed.ip) end end)
        pcall(function() if self.edit_port then self.edit_port:SetText(tostring(seed.port)) end end)
    end

    if self.list_servers then self:RefreshList() end
end

function UIZoneServerList:SaveFavorites()
    local target_path = get_identity_path()
    local lines = {}

    local ok_read, file = pcall(io.open, target_path, "r")
    local in_block = false
    if ok_read and file then
        local ok_lines = pcall(function()
            for line in file:lines() do
                local sec = line:match("^%s*%[([^%]]+)%]")
                if sec then
                    local low = sec:lower()
                    in_block = (low == FAVORITES_SEC or low == HISTORY_SEC or low == LEGACY_SEC)
                    if not in_block then lines[#lines + 1] = line end
                elseif not in_block then
                    local k = line:match("^%s*([%w_]+)%s*=")
                    if k and k:lower() == "nickname" and self.nick then
                        lines[#lines + 1] = "nickname = " .. sanitize_nickname(self.nick)
                    else
                        lines[#lines + 1] = line
                    end
                end
            end
        end)
        pcall(function() file:close() end)
        if not ok_lines then
            self:ReportPersistError()
            return false
        end
    end

    local function entry_line(i, entry, fav_flag)
        local proto = tonumber(entry.proto)
        if not proto and entry.query then proto = tonumber(entry.query.proto) end
        proto = proto or 0
        local ts = entry.lastSeen or now_timestamp()
        local added = entry.added or ts
        return string.format("entry_%d = %s|%s:%d|%d|%d|%d|%d",
            i - 1, entry.label or (entry.ip .. ":" .. tostring(entry.port)),
            entry.ip, entry.port, fav_flag, ts, proto, added)
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "[" .. FAVORITES_SEC .. "]"
    for i, entry in ipairs(self.favorites) do
        lines[#lines + 1] = entry_line(i, entry, 1)
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "[" .. HISTORY_SEC .. "]"
    for i, entry in ipairs(self.history) do
        lines[#lines + 1] = entry_line(i, entry, 0)
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "[" .. LEGACY_SEC .. "]"

    if not write_lines_atomic(target_path, lines) then
        self:ReportPersistError()
        return false
    end
    self.persist_error = nil
    return true
end

function UIZoneServerList:EntryKey(e)
    if not e then return "" end
    return (e.ip or "") .. ":" .. tostring(e.port or 0)
end

function UIZoneServerList:EntryLabel(e)
    local info = e.query
    local name = info and info.name
    if not name or name == "" then name = e.label end
    if not name or name == "" then name = (e.ip or "") .. ":" .. tostring(e.port or 0) end
    return name
end

function UIZoneServerList:ProtoMismatch(e)
    if not e then return false end
    local p = tonumber(e.proto)
    if (not p or p <= 0) and e.query then p = tonumber(e.query.proto) end
    if not p or p <= 0 then return false end
    local own = tonumber(self.own_proto)
    if not own or own <= 0 then return false end
    return p ~= own
end

function UIZoneServerList:EntryPassesFilter(e)
    local needle = self.filter_text
    if type(needle) == "string" and needle ~= "" then
        needle = needle:lower()
        local name = ((e.query and e.query.name) or e.label or ""):lower()
        local map = (((e.query and e.query.map) or "")):lower()
        if not (name:find(needle, 1, true) or map:find(needle, 1, true)) then
            return false
        end
    end

    local info = e.query
    if self.hide_full then
        local maxp = info and tonumber(info.maxPlayers)
        local pl = info and tonumber(info.players)
        if maxp and maxp > 0 and pl and pl >= maxp then return false end
    end
    if self.hide_empty and (not info or (tonumber(info.players) or 0) <= 0) then
        return false
    end
    if self.hide_locked and info and tonumber(info.locked or 0) ~= 0 then
        return false
    end
    if tonumber(self.max_ping) and tonumber(self.max_ping) > 0 then
        local p = info and tonumber(info.ping_ms)
        if not p or p > tonumber(self.max_ping) then return false end
    end
    return true
end

function UIZoneServerList:SortValue(e, key)
    local info = e.query
    if key == "name" then
        local n = (info and info.name ~= "" and info.name) or e.label or e.ip or ""
        return n:lower()
    elseif key == "map" then
        return ((info and info.map) or ""):lower()
    elseif key == "players" then
        return tonumber(info and info.players) or -1
    elseif key == "ping" then
        local p = tonumber(info and info.ping_ms)
        if not p then return 1e12 end
        return p
    elseif key == "mode" then
        return tonumber(info and info.mode) or -1
    elseif key == "proto" then
        local p = tonumber(e.proto)
        if not p and info then p = tonumber(info.proto) end
        return p or -1
    elseif key == "lock" then
        return tonumber(info and info.locked) or 0
    end
    return 0
end

function UIZoneServerList:SortEntries(list)
    local key = self.sort_key or "ping"
    local asc = self.sort_asc
    if asc == nil then asc = true end
    local function tie(a, b)
        return self:EntryKey(a) < self:EntryKey(b)
    end
    table.sort(list, function(a, b)
        local va = self:SortValue(a, key)
        local vb = self:SortValue(b, key)
        if va == vb then return tie(a, b) end
        if asc then return va < vb end
        return va > vb
    end)
end

function UIZoneServerList:SetSort(key)
    if self.sort_key == key then
        self.sort_asc = not (self.sort_asc ~= false)
    else
        self.sort_key = key
        self.sort_asc = true
    end
    self:UpdateLabels()
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:GetView()
    local out = {}
    local seen = {}
    local function push(e)
        local key = self:EntryKey(e)
        if seen[key] then return end
        seen[key] = true
        if self.tab_id ~= TAB_DIRECT and not self:EntryPassesFilter(e) then return end
        out[#out + 1] = e
    end

    if self.tab_id == TAB_FAVORITES then
        for _, e in ipairs(self.favorites) do push(e) end
    elseif self.tab_id == TAB_DIRECT then
        return out
    else
        for _, e in ipairs(self.favorites) do push(e) end
        for _, e in ipairs(self.history) do push(e) end
    end

    self:SortEntries(out)
    return out
end

-- Row rendering is split from row creation so an in-place result update only
-- rewrites the cells of the affected row (no list rebuild during a scan).
function UIZoneServerList:FillRow(w, entry, index)
    if not w or not entry then return end
    local info = entry.query
    local online = (entry.state == "online" or entry.state == "locked")
    local stale = (entry.state == "stale")
    local offline = (entry.state == "offline")
    local locked = info and tonumber(info.locked or 0) ~= 0

    if w.icon then
        local tex, col = LAMP_OFF, argb(255, 130, 130, 124)
        if offline then
            tex, col = LAMP_RED, argb(255, 200, 70, 70)
        elseif stale then
            tex, col = LAMP_OFF, AMBER
        elseif online and locked then
            tex, col = LAMP_RED, argb(255, 230, 90, 90)
        elseif online then
            tex, col = LAMP_GREEN, argb(255, 110, 220, 110)
        end
        pcall(function()
            w.icon:InitTexture(tex)
            w.icon:SetTextureColor(col)
        end)
    end

    if w.name then
        local color = WHITE
        if entry.is_fav then color = argb(255, 255, 210, 90)
        elseif stale then color = AMBER
        elseif offline then color = DIM end
        pcall(function()
            w.name:SetText(clip_text(self:EntryLabel(entry), 22))
            w.name:SetTextColor(color)
        end)
    end

    if w.map then
        local map_txt = (info and info.map and info.map ~= "") and info.map or "-"
        pcall(function()
            w.map:SetText(clip_text(map_txt, 12))
            w.map:SetTextColor(GRAY)
        end)
    end

    if w.players then
        local pl_txt = "-"
        if info and tonumber(info.maxPlayers) then
            pl_txt = string.format("%d/%d", tonumber(info.players) or 0, tonumber(info.maxPlayers))
            if locked then pl_txt = pl_txt .. " L" end
        end
        local pl_col = GRAY
        if locked then pl_col = argb(255, 225, 120, 120)
        elseif online then pl_col = argb(255, 150, 220, 150)
        elseif stale then pl_col = AMBER
        elseif offline then pl_col = DIM end
        pcall(function()
            w.players:SetText(pl_txt)
            w.players:SetTextColor(pl_col)
        end)
    end

    if w.ping then
        local ping_txt = "-"
        local c = GRAY
        local p = info and tonumber(info.ping_ms)
        if p then
            ping_txt = string.format("%d", math.floor(p))
            if online then
                if p < 80 then c = argb(255, 120, 220, 120)
                elseif p < 160 then c = argb(255, 235, 200, 80)
                else c = argb(255, 225, 90, 90) end
            elseif stale then
                c = AMBER
            elseif offline then
                c = DIM
            end
        elseif (stale or offline) and entry.fail_reason_id then
            -- Show the failure kind instead of a bare "-" so a dead row says
            -- why it is dead (timeout / refused / bad response).
            ping_txt = clip_text(tr(entry.fail_reason_id), 10)
            c = stale and AMBER or DIM
        end
        pcall(function()
            w.ping:SetText(ping_txt)
            w.ping:SetTextColor(c)
        end)
    end

    if w.mode then
        local mode_txt = "-"
        if info then
            mode_txt = mode_name(info.mode)
            local proto = tonumber(entry.proto)
            if not proto then proto = tonumber(info.proto) end
            if proto and proto > 0 then
                mode_txt = mode_txt .. " v" .. tostring(proto)
            end
        end
        local mode_col = GRAY
        if self:ProtoMismatch(entry) then
            mode_col = RED
        elseif stale then
            mode_col = AMBER
        elseif offline then
            mode_col = DIM
        end
        pcall(function()
            w.mode:SetText(clip_text(mode_txt, 12))
            w.mode:SetTextColor(mode_col)
        end)
    end
end

function UIZoneServerList:AddRow(entry, index)
    local item = CUIListBoxItem(ROW_H)
    local font = GetFontLetterica16Russian and GetFontLetterica16Russian() or nil
    local w = { item = item }

    local icon = item:AddIconField(24)
    if icon then
        w.icon = icon
    end
    local name = item:AddTextField("", 128)
    if name then
        if font then name:SetFont(font) end
        w.name = name
    end
    local map = item:AddTextField("", 78)
    if map then
        if font then map:SetFont(font) end
        w.map = map
    end
    local players = item:AddTextField("", 52)
    if players then
        if font then players:SetFont(font) end
        w.players = players
    end
    local ping = item:AddTextField("", 46)
    if ping then
        if font then ping:SetFont(font) end
        w.ping = ping
    end
    local mode = item:AddTextField("", 70)
    if mode then
        if font then mode:SetFont(font) end
        w.mode = mode
    end

    self:FillRow(w, entry, index)
    item:SetTAG(index)
    self.list_servers:AddExistingItem(item)

    local key = self:EntryKey(entry)
    self.row_widgets[key] = w
    self.row_index[key] = index
    return w
end

function UIZoneServerList:UpdateRowInPlace(entry)
    if not entry then return false end
    if self.view_dirty then return false end
    local key = self:EntryKey(entry)
    local w = self.row_widgets and self.row_widgets[key]
    if not w then
        self.view_dirty = true
        return false
    end
    if not self:EntryPassesFilter(entry) then
        self.view_dirty = true
        return false
    end
    local index = self.row_index and self.row_index[key]
    if not index then
        self.view_dirty = true
        return false
    end
    pcall(function() self:FillRow(w, entry, index) end)
    return true
end

function UIZoneServerList:RefreshList()
    if not self.list_servers then return end
    local keep = self.sel_entry and self:EntryKey(self.sel_entry) or nil
    local saved_scroll = nil
    pcall(function() saved_scroll = self.list_servers:GetCurrentScrollPos() end)

    self.rows = self:GetView()
    self.row_widgets = {}
    self.row_index = {}
    pcall(function() self.list_servers:RemoveAll() end)

    for i = 1, #self.rows do
        local entry = self.rows[i]
        local ok = pcall(function() self:AddRow(entry, i) end)
        if not ok then break end
    end

    self.sel_entry = nil
    if keep then
        for i = 1, #self.rows do
            if self:EntryKey(self.rows[i]) == keep then
                self.sel_entry = self.rows[i]
                pcall(function() self.list_servers:SetSelectedIndex(i - 1) end)
                break
            end
        end
    end

    if not self.sel_entry then
        local idx = self:SelectedIndexSafe()
        if idx >= 0 then self.sel_entry = self.rows[idx + 1] end
    end

    -- Selection and scroll survive the rebuild.
    if saved_scroll and saved_scroll > 0 then
        pcall(function() self.list_servers:SetScrollPos(math.floor(saved_scroll)) end)
    elseif self.sel_entry then
        local idx = self.row_index[self:EntryKey(self.sel_entry)]
        if idx then self:EnsureRowVisible(idx - 1) end
    end

    self.view_dirty = false
    self:UpdateEmptyState()
    self:UpdateDetails()
end

function UIZoneServerList:SelectedIndexSafe()
    local idx = -1
    pcall(function()
        if self.list_servers and self.list_servers.GetSelectedIndex then
            local raw = self.list_servers:GetSelectedIndex()
            if type(raw) == "number" and raw >= 0 and raw < 100000 then idx = math.floor(raw) end
        end
    end)
    if not self.rows or idx < 0 or idx >= #self.rows then return -1 end
    return idx
end

function UIZoneServerList:EnsureRowVisible(idx)
    if not self.list_servers then return end
    pcall(function()
        local h = self.list_servers:GetHeight() or 0
        local pos = self.list_servers:GetCurrentScrollPos() or 0
        local top = idx * ROW_H
        local bottom = top + ROW_H
        if top < pos then
            pos = top
        elseif bottom > pos + h then
            pos = bottom - h
        end
        self.list_servers:SetScrollPos(pos)
    end)
end

function UIZoneServerList:PageSize()
    local h = 0
    pcall(function() if self.list_servers then h = self.list_servers:GetHeight() or 0 end end)
    local n = math.floor(h / ROW_H)
    if n < 1 then n = 1 end
    return n
end

function UIZoneServerList:SelectRow(idx)
    if not self.list_servers or #self.rows == 0 then return end
    if idx < 0 then idx = 0 end
    if idx > #self.rows - 1 then idx = #self.rows - 1 end
    pcall(function() self.list_servers:SetSelectedIndex(idx) end)
    self.sel_entry = self.rows[idx + 1]
    pcall(function() if self.edit_ip and self.sel_entry then self.edit_ip:SetText(self.sel_entry.ip) end end)
    pcall(function() if self.edit_port and self.sel_entry then self.edit_port:SetText(tostring(self.sel_entry.port)) end end)
    self:UpdateDetails()
    self:EnsureRowVisible(idx)
end

function UIZoneServerList:MoveSelection(delta)
    if not self.list_servers or #self.rows == 0 then return end
    local idx = self:SelectedIndexSafe()
    if idx < 0 then
        idx = delta > 0 and -1 or 0
    end
    self:SelectRow(idx + delta)
end

function UIZoneServerList:MoveSelectionTo(idx)
    if not self.list_servers or #self.rows == 0 then return end
    self:SelectRow(idx)
end

function UIZoneServerList:UpdateEmptyState()
    local direct = self:IsDirectTab()
    local count = (type(self.rows) == "table") and #self.rows or 0
    local empty = (not direct) and (count == 0)

    if self.empty_title then pcall(function() self.empty_title:Show(empty) end) end
    if self.empty_hint then pcall(function() self.empty_hint:Show(empty) end) end
    if not empty then return end

    local title = (self.state == STATE_SCANNING) and tr("ui_zone_scanning") or tr("ui_zone_empty_title")
    set_widget_text(self.empty_title, title, AMBER)

    local hint = tr("ui_zone_empty_hint")
    if self.broadcast_hit and self.broadcast_hit.name and self.broadcast_hit.name ~= "" then
        hint = self.broadcast_hit.name
        if self.broadcast_hit.map and self.broadcast_hit.map ~= "" then
            hint = hint .. " (" .. self.broadcast_hit.map .. ")"
        end
    end
    set_widget_text(self.empty_hint, hint, DIM)
end

function UIZoneServerList:UpdateDetails()
    if not self.details_body then return end
    local e = self.sel_entry
    if not e then
        set_widget_text(self.details_body, tr("ui_zone_empty_title"), DIM)
        return
    end

    local info = e.query or {}
    local name = (info.name and info.name ~= "") and info.name or (e.label or "-")
    local lines = {}
    lines[#lines + 1] = "%c[0,255,210,90]" .. clip_text(name, 48)
    lines[#lines + 1] = field_text("ui_zone_direct_host", (e.ip or "") .. ":" .. tostring(e.port or 0))
    lines[#lines + 1] = field_text("ui_zone_col_map", (info.map and info.map ~= "") and info.map or "-")

    local pl = "-"
    if tonumber(info.maxPlayers) then
        pl = string.format("%d/%d", tonumber(info.players) or 0, tonumber(info.maxPlayers))
        if tonumber(info.locked or 0) ~= 0 then pl = pl .. " (L)" end
    end
    lines[#lines + 1] = field_text("ui_zone_col_players", pl)
    lines[#lines + 1] = field_text("ui_zone_col_ping",
        tonumber(info.ping_ms) and (tostring(math.floor(info.ping_ms)) .. " ms") or "-")
    lines[#lines + 1] = field_text("ui_zone_col_mode", tonumber(info.mode) and mode_name(info.mode) or "-")

    local proto = tonumber(e.proto)
    if not proto then proto = tonumber(info.proto) end
    local proto_txt = proto and tostring(proto) or "-"
    if self:ProtoMismatch(e) then
        proto_txt = proto_txt .. " (" .. tr("ui_zone_proto_mismatch") .. ")"
    end
    lines[#lines + 1] = field_text("ui_zone_col_proto", proto_txt)
    lines[#lines + 1] = field_text("ui_zone_col_tick",
        tonumber(info.tick) and tostring(math.floor(info.tick)) or "-")
    lines[#lines + 1] = field_text("ui_zone_lock",
        (info.locked ~= nil) and ((tonumber(info.locked) ~= 0) and "1" or "0") or "-")

    if e.state == "stale" or e.state == "offline" then
        local state_id = (e.state == "offline") and "ui_zone_state_offline" or "ui_zone_state_stale"
        lines[#lines + 1] = tr(state_id) .. " (" .. age_text(e.last_ok or e.lastSeen) .. ")"
        if e.fail_reason_id then
            lines[#lines + 1] = field_text("ui_zone_last_error", tr(e.fail_reason_id))
        end
    end
    lines[#lines + 1] = field_text("ui_zone_last_seen", age_text(e.last_ok or e.lastSeen))
    set_widget_text(self.details_body, table.concat(lines, "\\n"), nil)
end

function UIZoneServerList:CountStates()
    local online, offline = 0, 0
    local seen = {}
    local function count(e)
        local key = self:EntryKey(e)
        if seen[key] then return end
        seen[key] = true
        if e.state == "online" or e.state == "locked" then
            online = online + 1
        elseif e.state == "stale" or e.state == "offline" then
            offline = offline + 1
        end
    end
    for _, e in ipairs(self.favorites) do count(e) end
    for _, e in ipairs(self.history) do count(e) end
    return online, offline
end

function UIZoneServerList:UpdateStatus()
    local state = self.state or STATE_IDLE
    local text, color, lamp
    if state == STATE_SCANNING then
        local done = tonumber(self.scan_done) or 0
        local total = tonumber(self.scan_total) or 0
        text, color, lamp = tr("ui_zone_scan_progress") .. string.format(" %d/%d", done, total), AMBER, LAMP_OFF
    elseif state == STATE_CONNECTING then
        text, color, lamp = tr("ui_zone_connecting"), AMBER, LAMP_OFF
    elseif state == STATE_CONNECTED then
        text, color, lamp = tr("ui_zone_connected"), GREEN, LAMP_GREEN
    elseif state == STATE_FAILED then
        text, color, lamp = tr("ui_zone_failed"), RED, LAMP_RED
    else
        if not self:NetAvailable() or not self:ClientLoaded() then
            text, color, lamp = tr("ui_zone_status_no_module"), RED, LAMP_RED
        else
            text, color, lamp = tr("ui_zone_status_ready"), AMBER, LAMP_OFF
        end
    end

    if self.state_detail and self.state_detail ~= "" then
        if state == STATE_CONNECTING or state == STATE_CONNECTED or state == STATE_FAILED then
            text = text .. ": " .. self.state_detail
        end
    end
    if state == STATE_FAILED then
        text = text .. " - " .. tr("ui_zone_failed_retry_hint")
    end

    if state == STATE_IDLE then
        local online, offline = self:CountStates()
        local summary = self.scan_summary
        local total = summary and tonumber(summary.total) or 0
        local timed_out = summary and tonumber(summary.timed_out) or 0
        if summary and total == 0 and online + offline == 0 then
            text = tr("ui_zone_scan_zero_targets")
        elseif online + offline > 0 then
            text = tr("ui_zone_online_count") .. ": " .. tostring(online)
                .. " / " .. tr("ui_zone_offline_count") .. ": " .. tostring(offline)
            if online == 0 then
                if total > 0 and timed_out >= total then
                    text = text .. " - " .. tr("ui_zone_scan_all_timed_out")
                elseif self.last_fail_reason and self.last_fail_reason ~= "" then
                    text = text .. " (" .. clip_text(self.last_fail_reason, 28) .. ")"
                end
            end
        elseif total > 0 then
            text = tr("ui_zone_scan_none_online") .. " - "
                .. ((timed_out >= total) and tr("ui_zone_scan_all_timed_out")
                    or tr("ui_zone_scan_all_offline"))
        else
            text = tr("ui_zone_sort_hint")
        end
        if self.filter_editing then
            text = tr("ui_zone_filter_hint") .. " " .. (self.filter_text or "")
        end
    end

    if self.persist_error and self.persist_error ~= "" then
        text = text .. " | " .. self.persist_error
    end

    set_widget_text(self.status_label, text, color)
    set_widget_text(self.status_header, text, color)
    if self.header_lamp then
        pcall(function() self.header_lamp:InitTexture(lamp) end)
    end
end

function UIZoneServerList:SetState(state, detail)
    self.state = state or STATE_IDLE
    self.state_detail = detail or ""
    self:UpdateStatus()
    self:UpdateEmptyState()
end

function UIZoneServerList:UpdateDirectVisibility()
    local direct = self:IsDirectTab()
    local function show(w, v)
        if w and w.Show then pcall(function() w:Show(v) end) end
    end
    show(self.list_servers, not direct)
    show(self.list_frame, not direct)
    show(self.col_name, not direct)
    show(self.col_map, not direct)
    show(self.col_players, not direct)
    show(self.col_ping, not direct)
    show(self.col_mode, not direct)
    show(self.details_bg, not direct)
    show(self.details_title, not direct)
    show(self.details_body, not direct)
    show(self.direct_bg, direct)
    show(self.direct_title, direct)
    show(self.host_label, direct)
    show(self.host_bg, direct)
    show(self.edit_ip, direct)
    show(self.port_label, direct)
    show(self.port_bg, direct)
    show(self.edit_port, direct)
    show(self.nick_label, direct)
    show(self.nick_bg, direct)
    show(self.edit_nick, direct)
    if direct then
        self.edit_focus = 1
        self:ApplyEditFocus()
    else
        self:ReleaseEditFocus()
    end
    self:UpdateEmptyState()
end

function UIZoneServerList:ApplyEditFocus()
    local focus = self.edit_focus or 0
    local edits = { self.edit_ip, self.edit_port, self.edit_nick }
    for i = 1, #edits do
        local e = edits[i]
        if e and e.CaptureFocus then
            pcall(function() e:CaptureFocus(i == focus) end)
        end
    end
end

function UIZoneServerList:ReleaseEditFocus()
    self.edit_focus = 0
    local edits = { self.edit_ip, self.edit_port, self.edit_nick }
    for i = 1, #edits do
        local e = edits[i]
        if e and e.CaptureFocus then
            pcall(function() e:CaptureFocus(false) end)
        end
    end
end

function UIZoneServerList:GetEditText(edit)
    local raw = ""
    if edit then pcall(function() raw = edit:GetText() or "" end) end
    return (raw:match("^%s*(.-)%s*$")) or ""
end

function UIZoneServerList:CurrentPort()
    local port = tonumber(self:GetEditText(self.edit_port))
    if port and port >= 1 and port <= 65535 then return math.floor(port) end
    if self.rows and self.rows[1] and tonumber(self.rows[1].port) then
        return tonumber(self.rows[1].port)
    end
    return DEFAULT_PORT
end

function UIZoneServerList:FindEntry(ip, port)
    local e = find_entry_by_addr(self.favorites, ip, port)
    if e then return e end
    e = find_entry_by_addr(self.history, ip, port)
    return e
end

function UIZoneServerList:UpsertHistory(ip, port)
    local ts = now_timestamp()
    local fav = find_entry_by_addr(self.favorites, ip, port)
    if fav then
        fav.lastSeen = ts
        return fav
    end
    local hist = find_entry_by_addr(self.history, ip, port)
    if hist then
        hist.lastSeen = ts
        return hist
    end
    if #self.history >= MAX_HISTORY then
        table.sort(self.history, function(a, b) return (a.lastSeen or 0) > (b.lastSeen or 0) end)
        table.remove(self.history, #self.history)
    end
    local entry = {
        label = string.format("%s:%d", ip, port),
        ip = ip,
        port = port,
        is_fav = false,
        status = "Recent",
        lastSeen = ts,
        added = ts,
        proto = 0,
        fail_count = 0,
        retry_at = 0,
        state = nil,
        query = nil
    }
    self.history[#self.history + 1] = entry
    return entry
end

function UIZoneServerList:MarkFailure(entry, reason)
    if not entry then return end
    entry.fail_count = (entry.fail_count or 0) + 1
    if entry.fail_count >= 2 then
        entry.state = "offline"
    else
        entry.state = "stale"
    end
    if type(reason) == "string" and reason ~= "" then
        entry.fail_reason = reason
        entry.fail_reason_id = probe_failure_kind(reason)
    end
    local idx = entry.fail_count
    if idx > #RETRY_BACKOFF then idx = #RETRY_BACKOFF end
    entry.retry_at = now_timestamp() + RETRY_BACKOFF[idx]
end

-- DLL/module missing is a distinct state from "no server answered": report it
-- once in the log and always in the footer.
function UIZoneServerList:ReportModuleMissing()
    local msg = tr("ui_zone_status_no_module")
    if not self.module_error_logged then
        self.module_error_logged = true
        printf("Zone UI: %s", msg)
    end
    self:SetState(STATE_FAILED, msg)
end

function UIZoneServerList:StartScan(reset_backoff)
    if self.scan_active or self.state == STATE_CONNECTING then return end
    if self:IsDirectTab() then return end
    if not self:NetAvailable() or not self:ClientLoaded() then
        self:ReportModuleMissing()
        return
    end

    self.async_ok = self:AsyncAvailable()
    self.scan_prev_connected = (self.state == STATE_CONNECTED)
    self.broadcast_hit = nil
    self.last_scan_step = 0
    self.scan_summary = nil
    self.scan_ok = 0
    self.scan_timeouts = 0

    if not self.async_ok then
        -- Blocking fallback (DLL without ZN_QueryStart): legacy 450 ms probes
        -- spaced by SCAN_STEP_MS so the UI stays responsive.
        local queue = {}
        local seen = {}
        local function push(e)
            if not e then return end
            local key = self:EntryKey(e)
            if seen[key] then return end
            seen[key] = true
            if reset_backoff then
                e.fail_count = 0
                e.retry_at = 0
            end
            queue[#queue + 1] = { ip = e.ip, port = e.port, scan = true }
        end
        for _, e in ipairs(self.favorites) do push(e) end
        for _, e in ipairs(self.history) do push(e) end
        if self.tab_id == TAB_LAN then
            local port = self:CurrentPort()
            for _ = 1, LAN_PROBE_COUNT do
                queue[#queue + 1] = { ip = BROADCAST_ADDR, port = port, broadcast = true, scan = true }
            end
        end

        self.scan_queue = queue
        self.scan_index = 1
        self.scan_total = #queue
        self.scan_done = 0
        self.scan_active = (#queue > 0)
        if self.scan_active then
            if not self.scan_prev_connected then
                self:SetState(STATE_SCANNING)
            end
        else
            -- Nothing to probe: say so instead of leaving a bare footer.
            self.scan_summary = { total = 0, ok = 0, timed_out = 0 }
            if not self.scan_prev_connected then self:SetState(STATE_IDLE) end
            self:UpdateStatus()
        end
        return
    end

    -- Async scheduling: new generation, favorites/history first, LAN
    -- broadcast entries on the LAN tab, then fill up to the concurrency caps.
    self.scan_gen = (self.scan_gen or 0) + 1
    self.query_inflight = {}
    self.queue_internet = {}
    self.queue_lan = {}
    self.scan_total = 0
    self.scan_done = 0
    self.view_dirty = false

    local now_wall = now_timestamp()
    local seen = {}
    local function add_entry(e)
        if not e then return end
        local key = self:EntryKey(e)
        if seen[key] then return end
        seen[key] = true
        if reset_backoff then
            e.fail_count = 0
            e.retry_at = 0
        elseif (e.fail_count or 0) >= 1 and (e.retry_at or 0) > now_wall then
            -- Backoff has not elapsed; the retry service will pick this up.
            return
        end
        self.queue_internet[#self.queue_internet + 1] = {
            ip = e.ip,
            port = e.port,
            lane = "internet",
            timeout = ASYNC_TIMEOUT_INTERNET_MS,
            gen = self.scan_gen,
            scan = true,
        }
        self.scan_total = self.scan_total + 1
    end
    for _, e in ipairs(self.favorites) do add_entry(e) end
    for _, e in ipairs(self.history) do add_entry(e) end
    if self.tab_id == TAB_LAN then
        local port = self:CurrentPort()
        for _ = 1, LAN_PROBE_COUNT do
            self.queue_lan[#self.queue_lan + 1] = {
                ip = BROADCAST_ADDR,
                port = port,
                lane = "lan",
                timeout = ASYNC_TIMEOUT_LAN_MS,
                gen = self.scan_gen,
                scan = true,
                broadcast = true,
            }
            self.scan_total = self.scan_total + 1
        end
    end

    self.scan_active = (self.scan_total > 0)
    if self.scan_active then
        if not self.scan_prev_connected then
            self:SetState(STATE_SCANNING)
        end
        self:PumpQueries()
        self:UpdateStatus()
        self:CheckScanFinished()
    else
        -- Nothing to probe: say so instead of leaving a bare footer.
        self.scan_summary = { total = 0, ok = 0, timed_out = 0 }
        if not self.scan_prev_connected then self:SetState(STATE_IDLE) end
        self:UpdateStatus()
    end
end

function UIZoneServerList:AbortScan()
    -- New generation invalidates any result still in flight; cancel all
    -- outstanding queries so the DLL-side sockets are released.
    self.scan_gen = (self.scan_gen or 0) + 1
    self.scan_active = false
    self.scan_queue = nil
    self.scan_index = nil
    self.scan_prev_connected = false
    self.scan_summary = nil
    self.queue_internet = {}
    self.queue_lan = {}
    local had_inflight = (self.query_inflight and next(self.query_inflight) ~= nil)
    self.query_inflight = {}
    if had_inflight then
        pcall(function()
            if ZoneNet and type(ZoneNet.QueryCancelAll) == "function" then
                ZoneNet:QueryCancelAll()
            end
        end)
    end
end

function UIZoneServerList:StartProbe(probe)
    if not probe then return false end
    local id, err = nil, nil
    local ok = pcall(function()
        id, err = ZoneNet:QueryStart(probe.ip, probe.port, probe.timeout)
    end)
    if ok and type(id) == "number" and id > 0 then
        probe.deadline = self:Now() + (tonumber(probe.timeout) or ASYNC_TIMEOUT_INTERNET_MS) + 150
        self.query_inflight[id] = probe
        return true
    end
    self:OnProbeFailure(probe, err or "start failed")
    return false
end

function UIZoneServerList:PumpSlots()
    local internet, lan = 0, 0
    for _, p in pairs(self.query_inflight) do
        if p.lane == "lan" then lan = lan + 1 else internet = internet + 1 end
    end
    while internet < ASYNC_MAX_INTERNET and #self.queue_internet > 0 do
        local probe = table.remove(self.queue_internet, 1)
        if self:StartProbe(probe) then internet = internet + 1 end
    end
    while lan < ASYNC_MAX_LAN and #self.queue_lan > 0 do
        local probe = table.remove(self.queue_lan, 1)
        if self:StartProbe(probe) then lan = lan + 1 end
    end
end

-- Bounded async pump: at most ASYNC_POLL_PER_UPDATE ZN_QueryPoll calls per
-- UI update, then top up the in-flight slots from the queues.
function UIZoneServerList:PumpQueries()
    local inflight = self.query_inflight
    if not inflight then return end
    if next(inflight) == nil and #self.queue_internet == 0 and #self.queue_lan == 0 then
        self:CheckScanFinished()
        return
    end

    local now = self:Now()
    local polls = 0
    local changed = false
    for qid, probe in pairs(inflight) do
        if polls >= ASYNC_POLL_PER_UPDATE then break end
        polls = polls + 1
        local ok_poll, res, err = pcall(function() return ZoneNet:QueryPoll(qid) end)
        if not ok_poll then
            inflight[qid] = nil
            self:OnProbeFailure(probe, "poll error")
            changed = true
        elseif res == false then
            inflight[qid] = nil
            self:OnProbeFailure(probe, err or "query failed")
            changed = true
        elseif res == nil then
            -- Still pending; soft deadline guards against a lost result.
            if probe.deadline and now > probe.deadline + 250 then
                pcall(function() ZoneNet:QueryCancel(qid) end)
                inflight[qid] = nil
                self:OnProbeFailure(probe, "timeout")
                changed = true
            end
        else
            inflight[qid] = nil
            self:OnProbeSuccess(probe, res)
            changed = true
        end
    end

    self:PumpSlots()
    if changed or self.scan_active then
        self:UpdateStatus()
    end
    self:CheckScanFinished()
end

function UIZoneServerList:ApplyQuery(probe, info)
    if not info then return nil end
    if probe.broadcast then
        self.broadcast_hit = info
        self.state_detail = info.name or ""
        self:UpdateStatus()
        self:UpdateEmptyState()
        return nil
    end

    local entry = self:FindEntry(probe.ip, probe.port)
    if not entry then
        entry = self:UpsertHistory(probe.ip, probe.port)
        self.scan_discoveries = true
        self.view_dirty = true
    end
    if not entry then return nil end

    entry.query = info
    entry.state = (tonumber(info.locked or 0) ~= 0) and "locked" or "online"
    entry.fail_count = 0
    entry.retry_at = 0
    entry.fail_reason = nil
    entry.fail_reason_id = nil
    entry.lastSeen = now_timestamp()
    entry.last_ok = entry.lastSeen
    if not entry.added or entry.added <= 0 then entry.added = entry.lastSeen end
    if tonumber(info.proto) then entry.proto = tonumber(info.proto) end
    if info.name and info.name ~= "" then
        entry.label = sanitize_label(info.name, entry.ip, entry.port)
    end

    -- While connected, the connected server's proto becomes our reference for
    -- mismatch highlighting (the session API exposes no own-proto field).
    if self.state == STATE_CONNECTED and probe.ip == self.connect_ip
        and tonumber(probe.port) == tonumber(self.connect_port) then
        self.own_proto = tonumber(info.proto) or self.own_proto
    end
    return entry
end

function UIZoneServerList:OnProbeSuccess(probe, info)
    if probe.gen and probe.gen ~= self.scan_gen then return end
    local entry = self:ApplyQuery(probe, info)
    if probe.scan then
        self.scan_done = (self.scan_done or 0) + 1
        self.scan_ok = (self.scan_ok or 0) + 1
    end
    if entry then
        self:UpdateRowInPlace(entry)
    end
    self:UpdateStatus()
end

function UIZoneServerList:OnProbeFailure(probe, reason)
    if probe.gen and probe.gen ~= self.scan_gen then
        if probe.scan then self.scan_done = (self.scan_done or 0) + 1 end
        return
    end
    if probe.scan then
        self.scan_done = (self.scan_done or 0) + 1
        if probe_failure_kind(reason) == "ui_zone_row_fail_timeout" then
            self.scan_timeouts = (self.scan_timeouts or 0) + 1
        end
    end
    if not probe.broadcast then
        self.last_fail_reason = reason or ""
        local entry = self:FindEntry(probe.ip, probe.port)
        if entry then
            self:MarkFailure(entry, reason)
            self:UpdateRowInPlace(entry)
        end
    end
    self:UpdateStatus()
end

function UIZoneServerList:CheckScanFinished()
    if not self.scan_active then return end
    if #self.queue_internet > 0 or #self.queue_lan > 0 then return end
    if next(self.query_inflight) ~= nil then return end

    self.scan_active = false
    self.scan_summary = {
        total = tonumber(self.scan_total) or 0,
        ok = tonumber(self.scan_ok) or 0,
        timed_out = tonumber(self.scan_timeouts) or 0,
    }
    if self.scan_discoveries then
        self.scan_discoveries = false
        pcall(function() self:SaveFavorites() end)
    end
    -- Single rebuild per batch: sorting and filter transitions are applied
    -- here, not for every landed result.
    self.view_dirty = true
    pcall(function() self:RefreshList() end)
    if self.scan_prev_connected then
        self.scan_prev_connected = false
        self:SetState(STATE_CONNECTED, self.state_detail)
    elseif self.state ~= STATE_CONNECTING and self.state ~= STATE_CONNECTED then
        self:SetState(STATE_IDLE)
    end
    self:UpdateStatus()
end

-- Backoff re-query: failed entries retry after 30/60/120 s (cap 5 min), at
-- most RETRY_MAX_ACTIVE at once, never while connecting and never while a
-- scan is running.
function UIZoneServerList:ServiceRetries()
    if self.state == STATE_CONNECTING then return end
    if self:IsDirectTab() or self.scan_active then return end
    if self.async_ok == nil then self.async_ok = self:AsyncAvailable() end
    if not self.async_ok then return end

    local now_wall = now_timestamp()
    if (self.last_retry_service or 0) == now_wall then return end
    self.last_retry_service = now_wall

    local retry_keys = {}
    local active = 0
    for _, p in pairs(self.query_inflight or {}) do
        if p.retry then
            active = active + 1
            retry_keys[p.ip .. ":" .. tostring(p.port)] = true
        end
    end
    if active >= RETRY_MAX_ACTIVE then return end

    for _, e in ipairs(self.rows or {}) do
        if active >= RETRY_MAX_ACTIVE then break end
        local key = self:EntryKey(e)
        -- One failure is enough to schedule a re-query: the second failure is
        -- what flips the row to "offline" (2 consecutive failures rule).
        if not retry_keys[key] and (e.fail_count or 0) >= 1
            and (e.retry_at or 0) > 0 and e.retry_at <= now_wall then
            local probe = {
                ip = e.ip,
                port = e.port,
                lane = "internet",
                timeout = ASYNC_TIMEOUT_INTERNET_MS,
                gen = self.scan_gen,
                retry = true,
            }
            if self:StartProbe(probe) then
                active = active + 1
                retry_keys[key] = true
            end
        end
    end
end

-- Legacy blocking fallback path, used only when the DLL lacks the async API.
function UIZoneServerList:ScanStep()
    if not self.scan_active then return end
    local now = self:Now()
    if self.last_scan_step and (now - self.last_scan_step) < SCAN_STEP_MS then return end
    self.last_scan_step = now

    local probe = self.scan_queue and self.scan_queue[self.scan_index]
    if not probe then
        self.scan_active = false
        self.scan_summary = {
            total = tonumber(self.scan_total) or 0,
            ok = tonumber(self.scan_ok) or 0,
            timed_out = tonumber(self.scan_timeouts) or 0,
        }
        if self.scan_discoveries then
            self.scan_discoveries = false
            pcall(function() self:SaveFavorites() end)
        end
        if self.scan_prev_connected then
            self.scan_prev_connected = false
            self:SetState(STATE_CONNECTED, self.state_detail)
        elseif self.state ~= STATE_CONNECTING and self.state ~= STATE_CONNECTED then
            self:SetState(STATE_IDLE)
        end
        self.view_dirty = true
        pcall(function() self:RefreshList() end)
        self:UpdateStatus()
        return
    end
    self.scan_index = self.scan_index + 1

    local info, err = nil, nil
    pcall(function()
        local r, e = ZoneNet:QueryServer(probe.ip, probe.port, SCAN_TIMEOUT_MS)
        if type(r) == "table" then
            info = r
        else
            err = e
        end
    end)

    if info then
        self:OnProbeSuccess(probe, info)
    else
        -- Never drop the reason: the row and the footer must say why.
        self:OnProbeFailure(probe, err or "no response")
    end
end

function UIZoneServerList:PollConnect()
    if self.state ~= STATE_CONNECTING then return end
    local now = self:Now()
    if self.last_connect_poll and (now - self.last_connect_poll) < CONNECT_POLL_MS then return end
    self.last_connect_poll = now

    local connected = false
    pcall(function()
        if ZoneNet and ZoneNet.IsConnected then connected = ZoneNet:IsConnected() and true or false end
    end)

    if connected then
        pcall(function()
            if ZoneNet and ZoneNet.ClearPreservedError then ZoneNet:ClearPreservedError() end
        end)
        for _, list in ipairs({ self.favorites, self.history }) do
            for _, e in ipairs(list) do
                if e.ip == self.connect_ip and e.port == self.connect_port then
                    e.state = "online"
                    e.lastSeen = now_timestamp()
                    e.fail_reason = nil
                    e.fail_reason_id = nil
                end
            end
        end
        self:SetState(STATE_CONNECTED, string.format("%s:%d", tostring(self.connect_ip), tonumber(self.connect_port) or 0))
        self:RefreshList()
        return
    end

    -- Early failure: the DLL sets GetLastError for handshake rejections
    -- (full/banned/version), invalid address and server kicks before the local
    -- timeout elapses. Surface that immediately instead of waiting 16 s.
    local raw = ""
    pcall(function()
        if ZoneNet and ZoneNet.GetLastError then raw = ZoneNet:GetLastError() or "" end
    end)
    local failed = false
    if type(raw) == "string" and raw ~= "" then
        failed = true
    elseif now - (self.connect_start or now) >= CONNECT_TIMEOUT_MS then
        failed = true
        pcall(function()
            if ZoneNet and ZoneNet.GetPreservedError then raw = ZoneNet:GetPreservedError() or "" end
        end)
        if raw == "" then raw = "timeout" end
    end

    if failed then
        local shown = localize_net_error(raw)
        printf("Zone UI: connect to %s:%s failed: %s",
            tostring(self.connect_ip), tostring(self.connect_port), tostring(raw))
        pcall(function()
            if ZoneNet and ZoneNet.ClearPreservedError then ZoneNet:ClearPreservedError() end
        end)
        for _, list in ipairs({ self.favorites, self.history }) do
            for _, e in ipairs(list) do
                if e.ip == self.connect_ip and e.port == self.connect_port then
                    e.state = "offline"
                    e.fail_reason = raw
                    e.fail_reason_id = probe_failure_kind(raw)
                end
            end
        end
        self.connect_start = 0
        self.last_fail_reason = raw
        self:SetState(STATE_FAILED, shown)
        self:RefreshList()
    end
end

-- A live "Connected" state must reflect the socket, not a cached state: the
-- server can stop or drop the session while the browser stays open.
function UIZoneServerList:PollLiveState()
    if self.state ~= STATE_CONNECTED then return end
    local connected = false
    pcall(function()
        if ZoneNet and ZoneNet.IsConnected then
            connected = ZoneNet:IsConnected() and true or false
        end
    end)
    if connected then return end

    local raw = ""
    pcall(function()
        if ZoneNet and ZoneNet.GetLastError then raw = ZoneNet:GetLastError() or "" end
    end)
    self.connect_start = 0
    self.last_fail_reason = raw
    if raw ~= "" then
        local shown = raw
        pcall(function()
            if ZoneNet and type(ZoneNet.LocalizeError) == "function" then
                shown = ZoneNet:LocalizeError(raw) or raw
            end
        end)
        self:SetState(STATE_FAILED, shown)
    else
        self:SetState(STATE_IDLE)
    end
    self:RefreshList()
end

function UIZoneServerList:Update()
    if self.closed then return end
    pcall(function() self:ProcessTabChange() end)
    pcall(function() CUIScriptWnd.Update(self) end)
    pcall(function()
        if self.async_ok then
            self:PumpQueries()
        else
            self:ScanStep()
        end
    end)
    pcall(function() self:PollConnect() end)
    pcall(function() self:PollLiveState() end)
    pcall(function() self:ServiceRetries() end)
    pcall(function() self:AnimateSpinner() end)
    -- Menu-safe pump: the join flow packets (SHOW_START/LOAD_LEVEL) arrive
    -- before actor_on_update exists; drain them while the browser is open.
    pcall(function()
        if zone_net and type(zone_net.pump_menu) == "function" then
            zone_net.pump_menu()
        end
    end)
end

function UIZoneServerList:AnimateSpinner()
    if not self.spinner then return end
    local active = (self.state == STATE_SCANNING or self.state == STATE_CONNECTING)
    if self.spinner_shown ~= active then
        self.spinner_shown = active
        pcall(function() self.spinner:Show(active) end)
    end
    if not active then return end
    local now = self:Now()
    if self.last_spin and (now - self.last_spin) < 350 then return end
    self.last_spin = now
    self.spin_on = not self.spin_on
    local c = self.spin_on and argb(255, 255, 195, 5) or argb(255, 110, 80, 10)
    pcall(function() self.spinner:SetTextureColor(c) end)
end

function UIZoneServerList:OnListSelect()
    local idx = self:SelectedIndexSafe()
    if idx < 0 then return end
    local e = self.rows and self.rows[idx + 1]
    if not e then return end
    self.sel_entry = e
    self:UpdateDetails()
end

-- Engine TAB_CHANGED callback: set a flag only. Calling engine getters
-- (GetActiveId) or rebuilding the list from inside the tab-control's own
-- callback crashes (re-entrancy), so all work happens on the next Update tick.
function UIZoneServerList:OnTabChanged()
    self.tab_dirty = true
end

function UIZoneServerList:ProcessTabChange()
    if not self.tab_dirty then return end
    self.tab_dirty = false
    self.tab_id = self:GetActiveTabId()
    self:AbortScan()
    self.broadcast_hit = nil
    self:UpdateDirectVisibility()
    self:RefreshList()
    if self.tab_id == TAB_DIRECT then
        if self.state ~= STATE_CONNECTING and self.state ~= STATE_CONNECTED and self.state ~= STATE_FAILED then
            self:SetState(STATE_IDLE)
        end
    else
        self:StartScan(false)
    end
end

function UIZoneServerList:OnRefresh()
    -- User-initiated refresh: drop backoff so every known endpoint is probed.
    self:AbortScan()
    self.broadcast_hit = nil
    self:RefreshList()
    self:StartScan(true)
end

function UIZoneServerList:OnConnect()
    if self.state == STATE_CONNECTING then return end
    self:AbortScan()

    local ip, port = nil, nil
    if not self:IsDirectTab() then
        local e = self.sel_entry
        if e then ip, port = e.ip, e.port end
        if not ip then
            pcall(function() if self.tabs then self.tabs:SetActiveTab(TAB_DIRECT) end end)
            self.tab_id = TAB_DIRECT
            self:UpdateDirectVisibility()
            self:RefreshList()
            self:ApplyEditFocus()
            return
        end
    else
        ip = self:GetEditText(self.edit_ip)
        port = tonumber(self:GetEditText(self.edit_port))
    end

    if not valid_host(ip) then
        self:SetState(STATE_FAILED, tr("ui_zone_bad_address"))
        return
    end
    port = tonumber(port)
    if not port or port < 1 or port > 65535 then
        self:SetState(STATE_FAILED, tr("ui_zone_bad_port"))
        return
    end
    port = math.floor(port)

    self.nick = sanitize_nickname(self:GetEditText(self.edit_nick))
    pcall(function() if self.edit_nick then self.edit_nick:SetText(self.nick) end end)

    -- Identity must exist before any handshake: never connect as the shared
    -- "anonymous" account, and persist uuid/hwid to zone_identity.ltx.
    local cfg = client_identity()
    if not cfg then
        self:SetState(STATE_FAILED, tr_or("ui_zone_identity_missing", "Client identity unavailable - cannot connect"))
        return
    end
    self.uuid = cfg.client_uuid
    self.hwid = tonumber(cfg.hwid_hash) or 0

    local live_connected = false
    pcall(function()
        if ZoneNet and ZoneNet.IsConnected then
            live_connected = ZoneNet:IsConnected() and true or false
        end
    end)
    if live_connected then
        local same_target = (self.connect_ip == ip) and (tonumber(self.connect_port) == port)
        if same_target then
            self:SetState(STATE_CONNECTED, string.format("%s:%d", tostring(ip), port))
            return
        end
        -- Explicit reconnect: tear the live session down before dialing the
        -- new target so Connect never resets a session behind the user's back.
        pcall(function() ZoneNet:Disconnect() end)
    end

    local busy = false
    pcall(function()
        if _G.XrrIsConnected and _G.XrrIsConnected() then busy = true end
        if _G.XrrIsHosted and _G.XrrIsHosted() then busy = true end
        if _G.XrrNet then
            local okc, connected = pcall(function() return _G.XrrNet():IsConnected() end)
            if okc and connected then busy = true end
        end
    end)
    if busy then
        self:SetState(STATE_FAILED, tr("ui_zone_status_busy"))
        return
    end

    if not self:NetAvailable() or not self:ClientLoaded() then
        self:ReportModuleMissing()
        return
    end

    local connect_called = false
    pcall(function()
        ZoneNet:Connect(ip, port, self.uuid, self.hwid, self.nick)
        connect_called = true
    end)
    if not connect_called then
        self:SetState(STATE_FAILED, tr("ui_zone_err_connect_call"))
        return
    end

    self.connect_ip = ip
    self.connect_port = port
    self.connect_start = self:Now()
    self.last_connect_poll = self.connect_start
    self:UpsertHistory(ip, port)
    self:SaveFavorites()
    self:SetState(STATE_CONNECTING, string.format("%s:%d", ip, port))
    self:RefreshList()
end

function UIZoneServerList:OnToggleFavorite()
    local ip, port = nil, nil
    if not self:IsDirectTab() and self.sel_entry then
        ip, port = self.sel_entry.ip, self.sel_entry.port
    else
        ip = self:GetEditText(self.edit_ip)
        port = tonumber(self:GetEditText(self.edit_port))
    end
    if not valid_host(ip) or not port or port < 1 or port > 65535 then
        self:SetState(STATE_FAILED, tr("ui_zone_bad_address"))
        return
    end
    port = math.floor(port)

    local fav, fav_idx = find_entry_by_addr(self.favorites, ip, port)
    local hist, hist_idx = find_entry_by_addr(self.history, ip, port)

    if fav then
        table.remove(self.favorites, fav_idx)
        if not hist then
            if #self.history >= MAX_HISTORY then
                table.sort(self.history, function(a, b) return (a.lastSeen or 0) > (b.lastSeen or 0) end)
                table.remove(self.history, #self.history)
            end
            local ts = now_timestamp()
            self.history[#self.history + 1] = {
                label = fav.label,
                ip = ip,
                port = port,
                is_fav = false,
                status = "Recent",
                lastSeen = ts,
                added = fav.added or ts,
                proto = fav.proto or 0,
                fail_count = fav.fail_count or 0,
                retry_at = fav.retry_at or 0,
                state = fav.state,
                query = fav.query
            }
        end
    else
        if #self.favorites >= MAX_FAVORITES then
            self:SetState(STATE_FAILED, string.format("%s %d", tr("ui_zone_btn_favorite"), MAX_FAVORITES))
            return
        end
        if hist then table.remove(self.history, hist_idx) end
        local ts = now_timestamp()
        self.favorites[#self.favorites + 1] = {
            label = hist and hist.label or (ip .. ":" .. tostring(port)),
            ip = ip,
            port = port,
            is_fav = true,
            status = "Favorite",
            lastSeen = ts,
            added = hist and hist.added or ts,
            proto = hist and (hist.proto or 0) or 0,
            fail_count = hist and (hist.fail_count or 0) or 0,
            retry_at = hist and (hist.retry_at or 0) or 0,
            state = hist and hist.state or nil,
            query = hist and hist.query or nil
        }
    end

    self:SaveFavorites()
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:OnRemove()
    local removed = false
    local e = self.sel_entry
    if not e and self:IsDirectTab() then
        local ip = self:GetEditText(self.edit_ip)
        local port = tonumber(self:GetEditText(self.edit_port))
        if valid_host(ip) and port and port >= 1 and port <= 65535 then
            e = self:FindEntry(ip, math.floor(port))
        end
    end
    if not e then
        self:UpdateStatus()
        return
    end

    local fav, fav_idx = find_entry_by_addr(self.favorites, e.ip, e.port)
    if fav then table.remove(self.favorites, fav_idx) removed = true end
    local hist, hist_idx = find_entry_by_addr(self.history, e.ip, e.port)
    if hist then table.remove(self.history, hist_idx) removed = true end
    if not removed then
        self:UpdateStatus()
        return
    end

    self.sel_entry = nil
    self:SaveFavorites()
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:OnShow()
    self.closed = false
    self.tab_dirty = false
    self.tab_id = self:GetActiveTabId()
    self:UpdateLabels()
    self:UpdateDirectVisibility()

    local connected = false
    pcall(function()
        if ZoneNet and ZoneNet.IsConnected then connected = ZoneNet:IsConnected() and true or false end
    end)
    if connected then
        local detail = ""
        if self.connect_ip then
            detail = string.format("%s:%d", tostring(self.connect_ip), tonumber(self.connect_port) or 0)
        end
        self:SetState(STATE_CONNECTED, detail)
    elseif self.state ~= STATE_CONNECTING and self.state ~= STATE_FAILED then
        self:SetState(STATE_IDLE)
    end

    self:RefreshList()
    if self.state ~= STATE_FAILED then
        self:StartScan(true)
    else
        -- Keep the failure reason visible; the user retries with Connect or
        -- Refresh from the same dialog.
        self:UpdateStatus()
    end
end

-- Single close path for Back/ESC and external callers. Always cancels probes,
-- drops the edit-box keyboard capture and hides the dialog, so focus can never
-- persist after the window is gone.
function UIZoneServerList:Close()
    if self.closed then return end
    self.closed = true
    self:AbortScan()
    self:ReleaseEditFocus()
    self.filter_editing = false
    -- Last engine call: after HideDialog nothing may touch this window until a
    -- future open resets self.closed and re-shows it.
    pcall(function() self:HideDialog() end)
end

function UIZoneServerList:OnBack()
    self:Close()
    if self.owner then
        pcall(function() self.owner:ShowDialog(true) end)
        pcall(function() self.owner:Show(true) end)
    end
end

function UIZoneServerList:OnSortName() self:SetSort("name") end
function UIZoneServerList:OnSortMap() self:SetSort("map") end
function UIZoneServerList:OnSortPlayers() self:SetSort("players") end
function UIZoneServerList:OnSortPing() self:SetSort("ping") end

-- No dedicated Proto/Lock headers exist in the dialog XML, so the Mode header
-- cycles through Mode -> Proto -> Lock.
function UIZoneServerList:OnSortMode()
    if self.sort_key == "mode" then
        self:SetSort("proto")
    elseif self.sort_key == "proto" then
        self:SetSort("lock")
    else
        self:SetSort("mode")
    end
end

function UIZoneServerList:ToggleHideFull()
    self.hide_full = not self.hide_full
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:ToggleHideEmpty()
    self.hide_empty = not self.hide_empty
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:ToggleHideLocked()
    self.hide_locked = not self.hide_locked
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:CycleMaxPing()
    local cur = tonumber(self.max_ping) or 0
    local next_v = 0
    for i = 1, #MAX_PING_CYCLE do
        if MAX_PING_CYCLE[i] == cur then
            next_v = MAX_PING_CYCLE[(i % #MAX_PING_CYCLE) + 1]
            break
        end
    end
    self.max_ping = next_v
    self:RefreshList()
    self:UpdateStatus()
end

function UIZoneServerList:SwitchTab(delta)
    if not self.tabs or not self.tabs.SetActiveTab then return end
    local cur = 1
    for i = 1, #TAB_ORDER do
        if TAB_ORDER[i] == self.tab_id then cur = i end
    end
    local next_i = cur + delta
    if next_i < 1 then next_i = #TAB_ORDER end
    if next_i > #TAB_ORDER then next_i = 1 end
    pcall(function() self.tabs:SetActiveTab(TAB_ORDER[next_i]) end)
    if self.tab_id ~= TAB_ORDER[next_i] then
        self.tab_dirty = true
    end
end

local key_char_map = nil

local function build_key_char_map()
    local map = {}
    if not DIK_keys then return map end
    local function add(dik_name, ch)
        local code = DIK_keys[dik_name]
        if code then map[code] = ch end
    end
    add("DIK_A", "a")
    add("DIK_B", "b")
    add("DIK_C", "c")
    add("DIK_D", "d")
    add("DIK_E", "e")
    add("DIK_F", "f")
    add("DIK_G", "g")
    add("DIK_H", "h")
    add("DIK_I", "i")
    add("DIK_J", "j")
    add("DIK_K", "k")
    add("DIK_L", "l")
    add("DIK_M", "m")
    add("DIK_N", "n")
    add("DIK_O", "o")
    add("DIK_P", "p")
    add("DIK_Q", "q")
    add("DIK_R", "r")
    add("DIK_S", "s")
    add("DIK_T", "t")
    add("DIK_U", "u")
    add("DIK_V", "v")
    add("DIK_W", "w")
    add("DIK_X", "x")
    add("DIK_Y", "y")
    add("DIK_Z", "z")
    add("DIK_1", "1")
    add("DIK_2", "2")
    add("DIK_3", "3")
    add("DIK_4", "4")
    add("DIK_5", "5")
    add("DIK_6", "6")
    add("DIK_7", "7")
    add("DIK_8", "8")
    add("DIK_9", "9")
    add("DIK_0", "0")
    add("DIK_SPACE", " ")
    add("DIK_MINUS", "-")
    add("DIK_PERIOD", ".")
    return map
end

function UIZoneServerList:OnKeyboard(dik, keyboard_action)
    local res = false
    pcall(function() res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action) end)
    if res then return res end
    if keyboard_action ~= ui_events.WINDOW_KEY_PRESSED then return false end
    if not DIK_keys then return false end
    if dik == nil then return false end

    -- Filter entry mode: printable keys build the name/map filter.
    if self.filter_editing then
        if dik == DIK_keys.DIK_ESCAPE then
            self.filter_editing = false
            self.filter_text = ""
            self:RefreshList()
            self:UpdateStatus()
            return true
        elseif dik == DIK_keys.DIK_RETURN then
            self.filter_editing = false
            self:RefreshList()
            self:UpdateStatus()
            return true
        elseif dik == DIK_keys.DIK_BACK then
            if #self.filter_text > 0 then
                self.filter_text = self.filter_text:sub(1, #self.filter_text - 1)
                self:RefreshList()
                self:UpdateStatus()
            end
            return true
        else
            if not key_char_map then key_char_map = build_key_char_map() end
            local ch = key_char_map[dik]
            if ch then
                if #self.filter_text < MAX_FILTER_LEN then
                    self.filter_text = self.filter_text .. ch
                    self:RefreshList()
                    self:UpdateStatus()
                end
                return true
            end
        end
    end

    if dik == DIK_keys.DIK_ESCAPE then
        if self.filter_text ~= "" then
            self.filter_text = ""
            self:RefreshList()
            self:UpdateStatus()
            return true
        end
        self:OnBack()
        return true
    elseif dik == DIK_keys.DIK_RETURN then
        self:OnConnect()
        return true
    elseif dik == DIK_keys.DIK_F5 then
        self:OnRefresh()
        return true
    elseif dik == DIK_keys.DIK_F6 then
        self:ToggleHideFull()
        return true
    elseif dik == DIK_keys.DIK_F7 then
        self:ToggleHideEmpty()
        return true
    elseif dik == DIK_keys.DIK_F8 then
        self:ToggleHideLocked()
        return true
    elseif dik == DIK_keys.DIK_F9 then
        self:CycleMaxPing()
        return true
    elseif dik == DIK_keys.DIK_SLASH then
        self.filter_editing = true
        self:UpdateStatus()
        return true
    elseif dik == DIK_keys.DIK_UP then
        self:MoveSelection(-1)
        return true
    elseif dik == DIK_keys.DIK_DOWN then
        self:MoveSelection(1)
        return true
    elseif dik == DIK_keys.DIK_HOME then
        self:MoveSelectionTo(0)
        return true
    elseif dik == DIK_keys.DIK_END then
        self:MoveSelectionTo(#self.rows - 1)
        return true
    elseif dik == DIK_keys.DIK_PRIOR then
        self:MoveSelection(-self:PageSize())
        return true
    elseif dik == DIK_keys.DIK_NEXT then
        self:MoveSelection(self:PageSize())
        return true
    elseif dik == DIK_keys.DIK_LEFT then
        self:SwitchTab(-1)
        return true
    elseif dik == DIK_keys.DIK_RIGHT then
        self:SwitchTab(1)
        return true
    elseif dik == DIK_keys.DIK_TAB then
        if self:IsDirectTab() then
            self.edit_focus = (self.edit_focus or 0) + 1
            if self.edit_focus > 3 then self.edit_focus = 1 end
            self:ApplyEditFocus()
        end
        return true
    end

    -- Fallback filter entry: on list tabs a printable key starts the filter
    -- even if DIK_SLASH is unavailable in this build.
    if not self:IsDirectTab() then
        if not key_char_map then key_char_map = build_key_char_map() end
        local ch = key_char_map[dik]
        if ch and ch ~= " " then
            self.filter_editing = true
            if #self.filter_text < MAX_FILTER_LEN then
                self.filter_text = self.filter_text .. ch
            end
            self:RefreshList()
            self:UpdateStatus()
            return true
        end
    end
    return false
end

function open_server_browser(owner)
    -- One keyboard owner at a time: never leave the chat edit box focused
    -- under the browser.
    pcall(function()
        if zone_hud and type(zone_hud.close_chat) == "function" then
            zone_hud.close_chat("server_browser")
        end
    end)
    if not _server_browser_dlg then
        local dlg = UIZoneServerList(owner)
        local ok = dlg:InitControls()
        if ok == false or not dlg.list_servers then
            printf("Zone UI init failed")
            return nil
        end
        dlg:InitCallBacks()
        _server_browser_dlg = dlg
    else
        if owner then _server_browser_dlg.owner = owner end
        _server_browser_dlg:LoadFavorites()
    end
    _server_browser_dlg:ShowDialog(true)
    _server_browser_dlg:Show(true)
    _server_browser_dlg:OnShow()
    return _server_browser_dlg
end

function get_dialog()
    return _server_browser_dlg
end
