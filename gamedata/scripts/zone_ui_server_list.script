-- zone_ui_server_list.script
-- Native S.T.A.L.K.E.R. Anomaly Server Browser Dialog
-- Implements CUIScriptWnd-based server browser with favorites persistence in %APPDATA%\zone_identity.ltx.

if not ui_events then ui_events = {} end

local DIALOG_XML    = "zone_ui_server_list.xml"
local HISTORY_SEC   = "server_history"
local IDENTITY_SEC  = "identity"
local MAX_FAVORITES = 16

-- Returns path to zone_identity.ltx inside appdata directory (on-demand getFS call)
local function get_identity_path()
    local fs = getFS and getFS()
    if fs then
        return fs:update_path("$app_data_root$", "zone_identity.ltx")
    end
    return "appdata\\zone_identity.ltx"
end

-- Sanitizes player nickname, stripping characters that could corrupt LTX syntax or cause injections
local function sanitize_nickname(nick)
    if not nick then return "Stalker" end
    local cleaned = nick:gsub("[%[%]=%c\r\n\t]", ""):match("^%s*(.-)%s*$")
    if not cleaned or cleaned == "" then
        return "Stalker"
    end
    if #cleaned > 24 then
        cleaned = cleaned:sub(1, 24)
    end
    return cleaned
end

-- Singleton dialog instance
local _server_browser_dlg = nil

-- Helper to safely call init methods across CScriptXmlInit / CUIXml variations
local function safe_init(xml, method, path, arg2, arg3)
    if not xml or not xml[method] then return nil end
    local ok, res
    if arg3 ~= nil then
        ok, res = pcall(function() return xml[method](xml, path, arg2, arg3) end)
        if ok and res then return res end
    end
    if arg2 ~= nil then
        ok, res = pcall(function() return xml[method](xml, path, arg2) end)
        if ok and res then return res end
    end
    ok, res = pcall(function() return xml[method](xml, path) end)
    if ok and res then return res end
    return nil
end

-- ============================================================
-- class UIZoneServerList (CUIScriptWnd)
-- ============================================================
class "UIZoneServerList" (CUIScriptWnd)

function UIZoneServerList:__init(owner)
    super()
    self.owner     = owner
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:Enable(true)
    self.favorites = {}   -- list of { label = string, ip = string, port = number, status = string }
    self.sel_idx   = nil  -- currently selected 0-based list index
    self.uuid      = "anonymous"
    self.hwid      = 0
    self.nick      = "Stalker"
    -- Menu-visible connection state (db.actor is nil in the main menu, so
    -- give_game_news cannot be used here; the dialog's own status label is
    -- the only user-visible feedback channel).
    self.status_text     = "Ready"
    self.connect_pending = false
    self.connect_ip      = nil
    self.connect_port    = nil
    self.connect_start   = 0
    self.last_status_poll = 0
end

function UIZoneServerList:__finalize()
    _server_browser_dlg = nil
end

-- ------------------------------------------------------------
-- InitControls — loads XML layout and initializes widgets
-- ------------------------------------------------------------
function UIZoneServerList:InitControls()
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("zone_ui_server_list.xml")

    self.background = xml:InitStatic("background", self)
    xml:InitStatic("header_label", self)
    xml:InitStatic("col_name", self)
    xml:InitStatic("col_host", self)
    xml:InitStatic("col_port", self)
    xml:InitStatic("col_status", self)
    xml:InitStatic("direct_label", self)
    xml:InitStatic("ip_label", self)
    xml:InitStatic("port_label", self)
    xml:InitStatic("nick_label", self)

    self.list_servers = xml:InitListBox("list", self)
    if self.list_servers then self:Register(self.list_servers, "server_list") end

    self.edit_ip = xml:InitEditBox("edit_ip", self)
    if self.edit_ip then self:Register(self.edit_ip, "edit_ip") end

    self.edit_port = xml:InitEditBox("edit_port", self)
    if self.edit_port then self:Register(self.edit_port, "edit_port") end

    self.edit_nick = xml:InitEditBox("edit_nick", self)
    if self.edit_nick then self:Register(self.edit_nick, "edit_nick") end

    self.btn_connect = xml:Init3tButton("btn_connect", self)
    if self.btn_connect then self:Register(self.btn_connect, "btn_connect") end

    self.btn_add_fav = xml:Init3tButton("btn_add_fav", self)
    if self.btn_add_fav then self:Register(self.btn_add_fav, "btn_add_fav") end

    self.btn_del_fav = xml:Init3tButton("btn_del_fav", self)
    if self.btn_del_fav then self:Register(self.btn_del_fav, "btn_del_fav") end

    self.btn_back = xml:Init3tButton("btn_back", self)
    if self.btn_back then self:Register(self.btn_back, "btn_back") end

    -- Connection-status footer. Missing in older layouts: nil-safe, Update()
    -- and SetStatus() both tolerate a nil label (log-only fallback).
    self.status_label = nil
    pcall(function()
        self.status_label = xml:InitStatic("status_label", self)
    end)

    self:LoadFavorites()
    pcall(function() self:SetStatus("Ready") end)
end

-- ------------------------------------------------------------
-- InitCallBacks — binds UI events to handlers
-- ------------------------------------------------------------
function UIZoneServerList:InitCallBacks()
    if self.btn_connect then
        self:AddCallback("btn_connect", ui_events.BUTTON_CLICKED, self.OnConnect, self)
    end
    if self.btn_add_fav then
        self:AddCallback("btn_add_fav", ui_events.BUTTON_CLICKED, self.OnAddFavorite, self)
    end
    if self.btn_del_fav then
        self:AddCallback("btn_del_fav", ui_events.BUTTON_CLICKED, self.OnDelFavorite, self)
    end
    if self.btn_back then
        self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    end

    if self.list_servers then
        self:AddCallback("server_list", ui_events.LIST_ITEM_CLICKED, self.OnListSelect, self)
        if ui_events.WINDOW_LBUTTON_DB_CLICK then
            self:AddCallback("server_list", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnConnect, self)
        end
    end
end

-- ============================================================
-- Favorites persistence (%APPDATA%\zone_identity.ltx)
-- ============================================================

local function parse_history_entry(raw)
    if not raw then return nil end
    local label, rest = raw:match("^([^|]+)|(.+)$")
    if not label then
        label = raw
        rest = raw
    end
    local ip, port = rest:match("^([^:]+):(%d+)$")
    if not ip or not port then return nil end
    return {
        label  = label:match("^%s*(.-)%s*$"),
        ip     = ip:match("^%s*(.-)%s*$"),
        port   = tonumber(port),
        status = "Saved"
    }
end

function UIZoneServerList:LoadFavorites()
    self.favorites = {}

    local file = io.open(get_identity_path(), "r")
    if file then
        local current_section = ""
        for line in file:lines() do
            local sec = line:match("^%s*%[([^%]]+)%]")
            if sec then
                current_section = sec:lower()
            else
                local k, v = line:match("^%s*([%w_]+)%s*=%s*(.+)%s*$")
                if k and v then
                    k = k:lower()
                    v = v:match("^%s*(.-)%s*$")
                    if current_section == HISTORY_SEC:lower() then
                        local entry = parse_history_entry(v)
                        if entry and #self.favorites < MAX_FAVORITES then
                            self.favorites[#self.favorites + 1] = entry
                        end
                    elseif current_section == IDENTITY_SEC:lower() or current_section == "" then
                        if k == "nickname" then
                            self.nick = sanitize_nickname(v)
                        elseif k == "uuid" or k == "client_uuid" then
                            self.uuid = v
                        elseif k == "hwid" or k == "hwid_hash" then
                            self.hwid = tonumber(v) or self.hwid
                        end
                    end
                end
            end
        end
        file:close()
    end

    -- Pull config from zone_main if identity ltx had incomplete fields
    if zone_main and zone_main.get_config then
        local cfg = zone_main.get_config()
        if cfg.client_uuid and self.uuid == "anonymous" then self.uuid = cfg.client_uuid end
        if cfg.hwid_hash and self.hwid == 0 then self.hwid = cfg.hwid_hash end
        if cfg.nickname and self.nick == "Stalker" then self.nick = sanitize_nickname(cfg.nickname) end
    end

    -- Seed default localhost server if no favorites exist
    -- NOTE: must match zone-server default (zone_server.yaml port 27015).
    if #self.favorites == 0 then
        self.favorites[1] = {
            label  = "Local Dev Server",
            ip     = "127.0.0.1",
            port   = 27015,
            status = "Ready"
        }
    end

    -- Populate UI input fields
    if self.edit_nick then
        self.edit_nick:SetText(self.nick)
    end
    if self.edit_ip and self.favorites[1] then
        self.edit_ip:SetText(self.favorites[1].ip)
    end
    if self.edit_port and self.favorites[1] then
        self.edit_port:SetText(tostring(self.favorites[1].port))
    end

    self:RefreshList()
end

function UIZoneServerList:RefreshList()
    if not self.list_servers then return end
    self.list_servers:RemoveAll()

    for i, entry in ipairs(self.favorites) do
        -- Format for column headers: Server Name (22ch), Host (16ch), Port (6ch), Status (8ch)
        local display = string.format("%-22s  %-15s  %-6d  %s",
            entry.label or "Server",
            entry.ip,
            entry.port,
            entry.status or "Saved"
        )
        self.list_servers:AddTextItem(display)
    end
    self.sel_idx = nil
end

-- ------------------------------------------------------------
-- SetStatus — menu-visible connection feedback.
-- db.actor (and give_game_news) does not exist in the main menu, so the
-- dialog's own status footer is the only user-visible channel. printf alone
-- only reaches xray_*.log. Never fatal: all engine calls are pcall-wrapped.
-- ------------------------------------------------------------
function UIZoneServerList:SetStatus(text)
    self.status_text = text or "Ready"
    pcall(function()
        -- NOTE: engine printf supports %s only.
        printf(string.format("Zone UI: %s", tostring(self.status_text)))
    end)
    pcall(function()
        if not self.status_label then return end
        local full = "Status: " .. tostring(self.status_text)
        if self.status_label.TextControl then
            self.status_label:TextControl():SetText(full)
        elseif self.status_label.SetText then
            self.status_label:SetText(full)
        end
    end)
end

-- ------------------------------------------------------------
-- Update — per-frame poll (engine calls CUIScriptWnd:Update while shown).
-- Polls ZoneNet:IsConnected() for a pending menu-initiated Connect and
-- flips the status footer to Connected/Failed. Throttled to ~2 Hz and fully
-- pcall-wrapped: a Lua error here is a fatal CTD.
-- ------------------------------------------------------------
function UIZoneServerList:Update()
    pcall(function() CUIScriptWnd.Update(self) end)
    pcall(function()
        if not self.connect_pending then return end

        local now_ms = nil
        pcall(function()
            if time_global then now_ms = time_global() end
        end)
        if not now_ms and time_continual then
            pcall(function() now_ms = time_continual() * 1000 end)
        end
        if not now_ms then return end

        -- Throttle to ~2 Hz so label/list updates don't flicker.
        if self.last_status_poll and (now_ms - self.last_status_poll) < 500 then
            return
        end
        self.last_status_poll = now_ms

        local connected = false
        pcall(function()
            if ZoneNet and ZoneNet.IsConnected then
                connected = ZoneNet:IsConnected() and true or false
            end
        end)
        if connected then
            self.connect_pending = false
            local ip_s = tostring(self.connect_ip or "")
            local port_s = tostring(self.connect_port or "")
            pcall(function()
                for _, e in ipairs(self.favorites) do
                    if e.ip == self.connect_ip and e.port == self.connect_port then
                        e.status = "Connected"
                    end
                end
            end)
            pcall(function() self:RefreshList() end)
            self:SetStatus(string.format("Connected to %s:%s - start or load a game",
                ip_s, port_s))
            return
        end

        -- Match ZoneClient CONNECTING retry budget (15 s / 5 tries in
        -- zone-client/src/net/udp_client.cpp) with a small margin.
        local elapsed = now_ms - (self.connect_start or now_ms)
        if elapsed > 16000 then
            self.connect_pending = false
            pcall(function()
                for _, e in ipairs(self.favorites) do
                    if e.ip == self.connect_ip and e.port == self.connect_port then
                        e.status = "Failed"
                    end
                end
            end)
            pcall(function() self:RefreshList() end)
            -- Surface the native reason (banned / full / version mismatch)
            -- instead of a generic unreachable message when available.
            local reason = ""
            pcall(function()
                if ZoneNet and ZoneNet.GetLastError then
                    reason = ZoneNet:GetLastError() or ""
                end
            end)
            if reason ~= nil and reason ~= "" then
                self:SetStatus(string.format("Failed - %s", tostring(reason)))
            else
                self:SetStatus("Failed - server unreachable, see xray log")
            end
        end
    end)
end

-- PRODUCTION FIX (crash on Connect):
-- The engine nils os.remove/os.rename/os.execute/os.exit (see
-- xray-monolith/src/xrServerEntities/script_storage.cpp disable_os_funcs).
-- The old atomic tmp->rename flow therefore raised
-- "attempt to call field 'remove' (a nil value)" inside the UI callback,
-- which CScriptEngine turns into a FATAL ERROR / CTD.
-- This version uses io.* only (always available) with a direct write.
function UIZoneServerList:SaveFavorites()
    local target_path = get_identity_path()
    local lines = {}
    local in_history = false
    local history_written = false

    local ok_read, file_or_err = pcall(io.open, target_path, "r")
    local file = ok_read and file_or_err or nil
    if file then
        local ok_lines = pcall(function()
            for line in file:lines() do
                local sec = line:match("^%s*%[([^%]]+)%]")
                if sec then
                    if in_history and not history_written then
                        self:_emit_history_block(lines)
                        history_written = true
                    end
                    in_history = (sec:lower() == HISTORY_SEC:lower())
                    if not in_history then
                        lines[#lines + 1] = line
                    end
                elseif not in_history then
                    -- Update nickname line in identity if modified, sanitizing input
                    local k = line:match("^%s*([%w_]+)%s*=")
                    if k and k:lower() == "nickname" and self.nick then
                        lines[#lines + 1] = "nickname = " .. sanitize_nickname(self.nick)
                    else
                        lines[#lines + 1] = line
                    end
                end
            end
        end)
        pcall(function() file:close() end)
        if not ok_lines then
            printf("Zone UI Error: Failed reading favorites file")
            return false
        end
    end

    if not history_written then
        self:_emit_history_block(lines)
    end

    -- Direct io-only write. No os.remove/os.rename (nilled by engine).
    local ok_open, out_or_err = pcall(io.open, target_path, "w")
    local out = ok_open and out_or_err or nil
    if not out then
        printf("Zone UI Error: Failed to open favorites file for saving")
        return false
    end

    local write_ok = true
    local ok_write = pcall(function()
        for _, l in ipairs(lines) do
            local ok = out:write(l .. "\n")
            if not ok then
                write_ok = false
                break
            end
        end
    end)
    pcall(function() out:close() end)

    if not ok_write or not write_ok then
        printf("Zone UI Error: Failed writing favorites data")
        return false
    end
    return true
end

function UIZoneServerList:_emit_history_block(lines)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "[" .. HISTORY_SEC .. "]"
    for i, entry in ipairs(self.favorites) do
        lines[#lines + 1] = string.format(
            "entry_%d = %s|%s:%d",
            i - 1,
            entry.label or (entry.ip .. ":" .. entry.port),
            entry.ip,
            entry.port
        )
    end
end

-- ============================================================
-- Event Handlers
-- ============================================================

function UIZoneServerList:OnConnect()
    -- Never fatal: any error below must be a log line, not a CTD.
    local ok, err = pcall(function()
        local ip   = self.edit_ip   and self.edit_ip:GetText()   or ""
        local port = self.edit_port and self.edit_port:GetText() or ""
        local nick = self.edit_nick and self.edit_nick:GetText() or ""

        ip   = ip:match("^%s*(.-)%s*$") or ""
        port = port:match("^%s*(.-)%s*$") or ""
        nick = nick:match("^%s*(.-)%s*$") or ""

        if ip == "" then
            printf("Zone: Cannot connect - empty server IP")
            pcall(function() self:SetStatus("Enter a server IP first") end)
            return
        end

        local port_n = tonumber(port)
        if not port_n or port_n < 1 or port_n > 65535 then
            printf("Zone: Cannot connect - invalid port")
            pcall(function() self:SetStatus("Invalid port (1-65535)") end)
            return
        end

        nick = sanitize_nickname(nick)
        self.nick = nick

        -- xrRazom compatibility: refuse Zone connect while co-op session is live.
        -- Both mods spawn proxy stalkers and hook actor update; running both
        -- simultaneously desyncs alife and double-spawns dummies.
        local xrr_busy = false
        pcall(function()
            if _G.XrrIsConnected and _G.XrrIsConnected() then xrr_busy = true end
            if _G.XrrIsHosted and _G.XrrIsHosted() then xrr_busy = true end
            if _G.XrrNet then
                local okc, connected = pcall(function() return _G.XrrNet():IsConnected() end)
                if okc and connected then xrr_busy = true end
                local okh, listening = pcall(function() return _G.XrrNet():IsListening() end)
                if okh and listening then xrr_busy = true end
            end
        end)
        if xrr_busy then
            printf("Zone: Cannot connect - xrRazom co-op session is active. Disconnect from co-op first.")
            pcall(function() self:SetStatus("Busy - xrRazom co-op is active") end)
            return
        end

        -- DLL check: FFI polyfill defines ZoneNet even without DLL, but its
        -- methods are no-ops. Gate on the real loader flag.
        local dll_ok = false
        pcall(function()
            if zone_net and zone_net.is_client_loaded and zone_net.is_client_loaded() then
                dll_ok = true
            end
        end)
        if not dll_ok then
            printf("Zone: ZoneNet DLL missing, cannot connect.")
            pcall(function() self:SetStatus("DLL missing - inject ZoneClient first") end)
            return
        end

        -- NOTE: engine printf only supports %s (see xray log literal %d bug).
        printf(string.format("Zone UI: Connecting to %s:%s as %s UUID %s HWID %s",
            tostring(ip), tostring(port_n), tostring(nick),
            tostring(self.uuid), tostring(self.hwid)))
        ZoneNet:Connect(ip, port_n, self.uuid, self.hwid, nick)

        -- Auto-save to favorites/history (io-only, never fatal)
        local found = false
        for _, e in ipairs(self.favorites) do
            if e.ip == ip and e.port == port_n then
                found = true
                e.status = "Connecting"
                break
            end
        end
        if not found and #self.favorites < MAX_FAVORITES then
            self.favorites[#self.favorites + 1] = {
                label  = string.format("%s:%s", tostring(ip), tostring(port_n)),
                ip     = ip,
                port   = port_n,
                status = "Connecting"
            }
        end
        pcall(function() self:SaveFavorites() end)
        pcall(function() self:RefreshList() end)

        -- Menu-visible feedback: keep the browser OPEN so the user sees the
        -- handshake outcome. db.actor/give_game_news do not exist in the main
        -- menu, so Update() polling + the status footer are the only channel.
        -- Do NOT auto-close here: closing is what produced "browser closes,
        -- nothing happens". The user closes via Back once Connected.
        pcall(function()
            self.connect_pending = true
            self.connect_ip = ip
            self.connect_port = port_n
            self.connect_start = 0
            if time_global then
                self.connect_start = time_global()
            elseif time_continual then
                self.connect_start = time_continual() * 1000
            end
            self.last_status_poll = 0
        end)
        pcall(function()
            self:SetStatus(string.format("Connecting to %s:%s...",
                tostring(ip), tostring(port_n)))
        end)
    end)
    if not ok then
        printf("Zone UI Error: Connect failed safely (no crash)")
        pcall(function() self:SetStatus("Error - see xray log") end)
    end
end

function UIZoneServerList:OnAddFavorite()
    local ip   = self.edit_ip   and self.edit_ip:GetText()   or ""
    local port = self.edit_port and self.edit_port:GetText() or ""

    ip   = ip:match("^%s*(.-)%s*$") or ""
    port = port:match("^%s*(.-)%s*$") or ""

    if ip == "" or port == "" then
        if db.actor then
            db.actor:give_game_news("Zone", "Please enter both IP and Port before adding.", "ui_inGame2_PDA_icon", 0, 3000, 1)
        end
        return
    end

    local port_n = tonumber(port)
    if not port_n or port_n < 1 or port_n > 65535 then
        if db.actor then
            db.actor:give_game_news("Zone", "ERROR: Invalid port number.", "ui_inGame2_PDA_icon", 0, 3000, 1)
        end
        return
    end

    for _, e in ipairs(self.favorites) do
        if e.ip == ip and e.port == port_n then
            if db.actor then
                db.actor:give_game_news("Zone", "Server is already in favorites list.", "ui_inGame2_PDA_icon", 0, 3000, 1)
            end
            return
        end
    end

    if #self.favorites >= MAX_FAVORITES then
        if db.actor then
            db.actor:give_game_news("Zone", string.format("Favorites list is full (%d max).", MAX_FAVORITES), "ui_inGame2_PDA_icon", 0, 3000, 1)
        end
        return
    end

    self.favorites[#self.favorites + 1] = {
        label  = string.format("%s:%d", ip, port_n),
        ip     = ip,
        port   = port_n,
        status = "Saved"
    }

    pcall(function() self:SaveFavorites() end)
    pcall(function() self:RefreshList() end)

    if db.actor then
        db.actor:give_game_news("Zone", "Server added to favorites.", "ui_inGame2_PDA_icon", 0, 3000, 1)
    end
end

function UIZoneServerList:OnDelFavorite()
    if not self.sel_idx then
        if db.actor then
            db.actor:give_game_news("Zone", "Select a server entry from the list first.", "ui_inGame2_PDA_icon", 0, 3000, 1)
        end
        return
    end

    local tbl_idx = self.sel_idx + 1
    if not self.favorites[tbl_idx] then return end

    table.remove(self.favorites, tbl_idx)
    self.sel_idx = nil

    pcall(function() self:SaveFavorites() end)
    pcall(function() self:RefreshList() end)

    if db.actor then
        db.actor:give_game_news("Zone", "Favorite server removed.", "ui_inGame2_PDA_icon", 0, 3000, 1)
    end
end

function UIZoneServerList:OnListSelect()
    if not self.list_servers then return end
    local idx = self.list_servers:GetSelectedIndex()
    if idx == nil or idx < 0 then return end
    self.sel_idx = idx

    local entry = self.favorites[idx + 1]
    if not entry then return end

    if self.edit_ip then self.edit_ip:SetText(entry.ip) end
    if self.edit_port then self.edit_port:SetText(tostring(entry.port)) end
end

function UIZoneServerList:OnBack()
    self:HideDialog()
    self:Show(false)
    if self.owner then
        self.owner:ShowDialog(true)
        self.owner:Show(true)
    end
end

function UIZoneServerList:OnKeyboard(dik, keyboard_action)
    CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
        self:OnBack()
        return true
    end
    return false
end

-- ============================================================
-- Public factory / API
-- ============================================================

--- Instantiates and shows the server browser dialog.
--- Called from zone_menu_patch or console/hotkey.
function open_server_browser(owner)
    if not _server_browser_dlg then
        _server_browser_dlg = UIZoneServerList(owner)
        _server_browser_dlg:InitControls()
        _server_browser_dlg:InitCallBacks()
    else
        if owner then _server_browser_dlg.owner = owner end
        _server_browser_dlg:LoadFavorites()
    end
    _server_browser_dlg:ShowDialog(true)
    _server_browser_dlg:Show(true)
    return _server_browser_dlg
end

function get_dialog()
    return _server_browser_dlg
end
