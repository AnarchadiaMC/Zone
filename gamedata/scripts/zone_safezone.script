-- zone_safezone.script
-- Safe zone damage gate. Weapons always function, keys never blocked.
-- Hits deal no damage to PROTECTED victims inside safe zones.

local in_safe_zone = false
local safe_zone_active = false
local safe_zone_id = ""

local SAFE_ZONES = {
    { id = "sz_cordon_rookie", level = "l01_escape", x = -211.3, y = -20.2, z = -145.8, r = 65.0, h = 20.0 },
    { id = "sz_cordon_farm", level = "l01_escape", x = 32.4, y = 3.1, z = 150.2, r = 50.0, h = 20.0 },
    { id = "sz_garbage_flea", level = "l02_garbage", x = -88.5, y = -0.5, z = -8.2, r = 45.0, h = 20.0 },
    { id = "sz_rostok_bar", level = "l05_bar_rostok", x = 30.5, y = 0.5, z = 138.2, r = 120.0, h = 20.0 },
    { id = "sz_darkvalley_base", level = "l04_darkvalley", x = 122.0, y = 1.2, z = -260.5, r = 80.0, h = 20.0 },
    { id = "sz_agroprom_camp", level = "l03_agroprom", x = -150.2, y = 5.4, z = -40.0, r = 55.0, h = 20.0 },
    { id = "sz_warehouses_base", level = "l07_military", x = -15.4, y = -5.2, z = 220.6, r = 110.0, h = 20.0 },
    { id = "sz_yantar_bunker", level = "l08_yantar", x = 32.8, y = -11.5, z = -270.2, r = 45.0, h = 20.0 },
    { id = "sz_deadcity_base", level = "l09_deadcity", x = 5.0, y = 2.1, z = 30.5, r = 75.0, h = 20.0 },
    { id = "sz_swamp_clearsky", level = "k00_marsh", x = -140.2, y = 1.5, z = -305.0, r = 85.0, h = 20.0 },
    { id = "sz_zaton_skadovsk", level = "zaton", x = 112.5, y = -4.5, z = 182.3, r = 65.0, h = 20.0 },
    { id = "sz_jupiter_yanov", level = "jupiter", x = -40.0, y = 3.5, z = 220.0, r = 75.0, h = 20.0 },
}

local function pos_in_safezone(pos, cur_level)
    if not pos then return false end
    local px = tonumber(pos.x)
    local py = tonumber(pos.y)
    local pz = tonumber(pos.z)
    if not px or not py or not pz then return false end
    for i = 1, #SAFE_ZONES do
        local sz = SAFE_ZONES[i]
        if sz.level == cur_level then
            local dx = px - sz.x
            local dz = pz - sz.z
            if (dx * dx + dz * dz) <= (sz.r * sz.r) then
                if math.abs(py - sz.y) <= (sz.h / 2) then
                    return true
                end
            end
        end
    end
    return false
end

local BLOCKED = {}

local function build_blocklist()
    local names = { "kWPN_FIRE" }
    for _, n in ipairs(names) do
        if key_bindings then
            local bind = key_bindings[n]
            if bind then BLOCKED[bind] = true end
        end
    end
end

local function actor_in_zone()
    if not db or not db.actor then return false end
    local ok_pos, apos = pcall(function() return db.actor:position() end)
    if not ok_pos or not apos then return false end
    if not tonumber(apos.x) or not tonumber(apos.y) or not tonumber(apos.z) then return false end
    local ok_lvl, lvl = pcall(function() return level.name() end)
    if not ok_lvl or type(lvl) ~= "string" or lvl == "" then return false end
    local ok_geo, inside = pcall(function() return pos_in_safezone(apos, lvl) end)
    if not ok_geo then return false end
    return inside == true
end

local function on_before_key_press(dik, bind, dis, flags)
    pcall(function()
        if actor_in_zone() and flags and BLOCKED[bind] then flags.ret_value = false end
    end)
end

local function on_before_key_hold(dik, bind, dis, flags)
    pcall(function()
        if actor_in_zone() and flags and BLOCKED[bind] then flags.ret_value = false end
    end)
end

function on_safezone_state(pkt, offset)
    local ok_r, locked, pos = pcall(function() return zone_net.read_uint8(pkt, offset) end)
    if not ok_r then return end
    local ok_s, zone_id_raw, _ = pcall(function() return zone_net.read_string(pkt, pos, 32) end)
    if not ok_s then return end
    local zid = zone_id_raw and zone_id_raw:gsub("%z+", "") or ""

    local is_locked = (locked == 1)

    safe_zone_active = is_locked
    in_safe_zone = is_locked

    if is_locked then
        safe_zone_id = zid
        if zone_hud and zone_hud.notify_safezone then
            pcall(function() zone_hud.notify_safezone(true, zid) end)
        end
    else
        safe_zone_id = ""
        if zone_hud and zone_hud.notify_safezone then
            pcall(function() zone_hud.notify_safezone(false, "") end)
        end
    end
end

function on_before_hit(victim, s_hit, bone_id)
    if not victim or not s_hit then return end
    pcall(function()
        local ok_pos, vpos = pcall(function() return victim:position() end)
        if not ok_pos or not vpos then return end

        local cur_level = nil
        local ok_lvl, lvl = pcall(function() return level.name() end)
        if ok_lvl and type(lvl) == "string" and lvl ~= "" then
            cur_level = lvl
        else
            cur_level = nil
        end

        local ok_geo, inside = pcall(function() return pos_in_safezone(vpos, cur_level) end)
        if not ok_geo or inside ~= true then return end

        pcall(function() s_hit.power = 0 end)
    end)
end

function reset()
    safe_zone_active = false
    in_safe_zone = false
    safe_zone_id = ""
    if zone_hud and zone_hud.notify_safezone then
        pcall(function() zone_hud.notify_safezone(false, "") end)
    end
end

function on_disconnect()
    reset()
end

local function on_level_changing()
    reset()
end

function is_in_safe_zone()
    return safe_zone_active == true or in_safe_zone == true
end

function get_safe_zone_id()
    return safe_zone_id or ""
end

function on_game_start()
    build_blocklist()
    if RegisterScriptCallback then
        pcall(function() RegisterScriptCallback("actor_on_before_hit", on_before_hit) end)
        pcall(function() RegisterScriptCallback("npc_on_before_hit", on_before_hit) end)
        pcall(function() RegisterScriptCallback("monster_on_before_hit", on_before_hit) end)
        pcall(function() RegisterScriptCallback("on_level_changing", on_level_changing) end)
        pcall(function() RegisterScriptCallback("actor_on_net_destroy", reset) end)
        pcall(function() RegisterScriptCallback("on_before_key_press", on_before_key_press) end)
        pcall(function() RegisterScriptCallback("on_before_key_hold", on_before_key_hold) end)
    end
end
