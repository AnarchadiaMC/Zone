-- zone_safezone.script
-- Safe zone enforcement. The server owns the authoritative locked state
-- (SAFEZONE_STATE 0x0020 plus the ZoneNet:IsInSafeZone() client atomic);
-- this script reconciles both, holsters the weapon, blocks offensive input,
-- hard-cancels damage involving protected actors and suppresses AI
-- hostility (enemy acquisition) for anyone standing inside a safe zone.

local SAFE_ZONES = {
    { id = "sz_cordon_rookie", level = "l01_escape", x = -211.3, y = -20.2, z = -145.8, r = 65.0, h = 20.0 },
    { id = "sz_cordon_farm", level = "l01_escape", x = 32.4, y = 3.1, z = 150.2, r = 50.0, h = 20.0 },
    { id = "sz_garbage_flea", level = "l02_garbage", x = -88.5, y = -0.5, z = -8.2, r = 45.0, h = 20.0 },
    { id = "sz_rostok_bar", level = "l05_bar_rostok", x = 30.5, y = 0.5, z = 138.2, r = 120.0, h = 20.0 },
    { id = "sz_darkvalley_base", level = "l04_darkvalley", x = 122.0, y = 1.2, z = -260.5, r = 80.0, h = 20.0 },
    { id = "sz_agroprom_camp", level = "l03_agroprom", x = -150.2, y = 5.4, z = -40.0, r = 55.0, h = 20.0 },
    { id = "sz_warehouses_base", level = "l07_military", x = -15.4, y = -5.2, z = 220.6, r = 110.0, h = 20.0 },
    { id = "sz_yantar_bunker", level = "l08_yantar", x = 32.8, y = -11.5, z = -270.2, r = 45.0, h = 20.0 },
    { id = "sz_deadcity_base", level = "l09_deadcity", x = 5.0, y = 2.1, z = 30.5, r = 75.0, h = 20.0 },
    { id = "sz_swamp_clearsky", level = "k00_marsh", x = -140.2, y = 1.5, z = -305.0, r = 85.0, h = 20.0 },
    { id = "sz_zaton_skadovsk", level = "zaton", x = 112.5, y = -4.5, z = 182.3, r = 65.0, h = 20.0 },
    { id = "sz_jupiter_yanov", level = "jupiter", x = -40.0, y = 3.5, z = 220.0, r = 75.0, h = 20.0 },
}

-- State sources: packet (0x0020), client atomic (polled 1 Hz), enforced (OR).
local packet_locked = false
local auth_locked = false
local enforced = false
local safe_zone_id = ""
local weapon_hidden_by_us = false

-- hide_weapon() maps to SetWeaponHideState(INV_STATE_BLOCK_ALL, true), which
-- increments a per-slot block counter for every inventory slot
-- (Actor_Weapon.cpp:159-169; Inventory.cpp:1447-1471 and 1529-1552) while
-- restore_weapon() is a single decrement per slot. A repeated hide without a
-- matching restore leaves slots blocked forever and trips the <5 VERIFY in
-- debug builds. Default OFF: safemode + key block + CActor_Fire already
-- enforce the lock. Enable only for weapons that refuse safemode.
local ALLOW_HIDE_WEAPON = false

local POLL_INTERVAL_MS = 1000
local last_poll = 0

-- Offensive binds are discovered lazily; key_bindings may not exist yet when
-- on_game_start fires. Rebuild on the first key event if still empty.
--
-- HARD SAFEGUARD: only names in WEAPON_ONLY may ever enter BLOCKED. The
-- engine dispatches on_before_key_press BEFORE UI input (level_input.script:
-- 17-19; Level_input.cpp:187-192 then 285), so eating a UI-relevant key would
-- make vendor/trade/inventory windows unresponsive.
local BLOCKED = {}
local WEAPON_ONLY = {
    "kWPN_FIRE",    -- fire
    "kWPN_FUNC",    -- under-barrel / grenade launcher fire
    "kCUSTOM21",    -- UBGL toggle (key_bindings enum)
    "kQUICK_USE_1", -- quick slots (grenades/bolts)
    "kQUICK_USE_2",
    "kQUICK_USE_3",
    "kQUICK_USE_4",
}

-- Defense-in-depth denylist: even if a future edit adds one of these names to
-- WEAPON_ONLY, its action id can never be blocked. Absent binds are skipped.
local NEVER_BLOCK = {
    "kUSE", "kINVENTORY", "kACTIVE_JOBS", "kBUY", "kDROP",
    "kQUICK_SAVE", "kQUICK_LOAD", "kPAUSE", "kCONSOLE", "kQUIT",
    "kCHAT", "kCHAT_TEAM", "kFREELOOK", "kTORCH", "kDETECTOR",
    -- names used by other engines; honored only when key_bindings exports them
    "kPDA", "kMAP", "kTALK", "kTRADE",
}
local NEVER_BLOCK_IDS = {}

local registered = false
local fire_hook_installed = false
local prev_CActor_Fire = nil

-- Co-op dormancy gate. Delegates to zone_main's single helper so all Zone
-- modules answer "is xrRazom live?" the same way; nil-safe while zone_main is
-- not loaded yet.
local function xrr_is_active()
    local fn = zone_main and zone_main.xrr_is_active
    if type(fn) ~= "function" then return false end
    local ok, res = pcall(fn)
    return ok and res == true
end

-- AI zone-membership cache. xr_combat_ignore.is_enemy is a hot path, so a
-- per-object result lives for ~1 s. Wiped on reset/level change.
local zone_cache = {}
local zone_cache_count = 0
local ZONE_CACHE_MS = 1000

local function pos_in_safezone(pos, cur_level)
    if not pos then return false end
    local px = tonumber(pos.x)
    local py = tonumber(pos.y)
    local pz = tonumber(pos.z)
    if not px or not py or not pz then return false end
    for i = 1, #SAFE_ZONES do
        local sz = SAFE_ZONES[i]
        if sz.level == cur_level then
            local dx = px - sz.x
            local dz = pz - sz.z
            if (dx * dx + dz * dz) <= (sz.r * sz.r) then
                if math.abs(py - sz.y) <= (sz.h / 2) then
                    return true
                end
            end
        end
    end
    return false
end

-- Exported helper (pcall-safe, always a boolean): true when pos lies inside
-- one of the safe zones on the current level.
function is_position_in_safezone(pos)
    if not pos then return false end
    local cur_level = nil
    pcall(function() cur_level = level.name() end)
    if type(cur_level) ~= "string" or cur_level == "" then return false end
    local ok, inside = pcall(pos_in_safezone, pos, cur_level)
    return (ok and inside == true) and true or false
end

local function same_object(a, b)
    if a == b then return true end
    local same = false
    pcall(function() same = (a:id() == b:id()) end)
    return same
end

local function object_in_safezone(obj)
    if not obj then return false end
    if enforced and db and db.actor and same_object(obj, db.actor) then return true end
    local ok_pos, pos = pcall(function() return obj:position() end)
    if not ok_pos or not pos then return false end
    return is_position_in_safezone(pos)
end

local function wipe_zone_cache()
    zone_cache = {}
    zone_cache_count = 0
end

local function ai_in_safezone(obj)
    if not obj then return false end
    local id = nil
    pcall(function() id = obj:id() end)
    if id == nil then return false end
    local now = nil
    pcall(function() now = time_global() end)
    if type(now) ~= "number" then
        return object_in_safezone(obj)
    end
    local e = zone_cache[id]
    if e and (now - e.t) < ZONE_CACHE_MS then
        return e.z == true
    end
    local z = object_in_safezone(obj)
    if not e then
        zone_cache_count = zone_cache_count + 1
        if zone_cache_count > 128 then
            local kept = 0
            for k, v in pairs(zone_cache) do
                if (now - v.t) >= ZONE_CACHE_MS then
                    zone_cache[k] = nil
                else
                    kept = kept + 1
                end
            end
            zone_cache_count = kept + 1
        end
    end
    zone_cache[id] = { t = now, z = z }
    return z
end

-- True when either side of a potential enemy pair is inside a safe zone.
local function safezone_pair_blocked(a, b)
    return ai_in_safezone(a) or ai_in_safezone(b)
end

local function build_blocklist()
    if not key_bindings then return end

    local forbidden = {}
    for i = 1, #NEVER_BLOCK do
        local id = key_bindings[NEVER_BLOCK[i]]
        if type(id) == "number" and id ~= 0 then forbidden[id] = true end
    end
    NEVER_BLOCK_IDS = forbidden

    -- Absolute allowlist: an action id enters BLOCKED only when one of the
    -- explicit weapon-only names resolved to it and it is not forbidden.
    local rebuilt = {}
    for i = 1, #WEAPON_ONLY do
        local id = key_bindings[WEAPON_ONLY[i]]
        if type(id) == "number" and id ~= 0 and not forbidden[id] then
            rebuilt[id] = true
        end
    end
    BLOCKED = rebuilt
end

local function ensure_blocklist()
    if next(BLOCKED) == nil then
        pcall(build_blocklist)
    end
end

local function fire_hook(...)
    -- Co-op live: never veto fire; keep chaining the saved handler.
    if xrr_is_active() then
        if prev_CActor_Fire then return prev_CActor_Fire(...) end
        return true
    end
    -- Stale-state guard: enforcement only applies while a live actor exists.
    -- reset() clears enforced on level change / actor destroy / disconnect, so
    -- a leftover flag on the menu can never block fire.
    if enforced and db and db.actor then return false end
    if prev_CActor_Fire then return prev_CActor_Fire(...) end
    return true
end

-- Idempotent and self-healing: if another script (or a script reload)
-- replaced _G.CActor_Fire after us, re-install our wrapper. Only the FIRST
-- install chains the pre-existing base function; a later replacement is
-- deliberately dropped because it may itself wrap us, and chaining it would
-- create a wrapper loop (ours -> replacement -> ours -> ...).
-- While xrRazom co-op is live, never wrap and never fight a foreign wrapper:
-- the wrapper resumes installing after the session ends.
local function install_fire_hook()
    if xrr_is_active() then return end
    local current = rawget(_G, "CActor_Fire")
    if fire_hook_installed and current == fire_hook then return end
    if not fire_hook_installed and type(current) == "function" and current ~= fire_hook then
        prev_CActor_Fire = current
    end
    _G.CActor_Fire = fire_hook
    fire_hook_installed = true
end

local function actor_weapon_lowered()
    local lowered = false
    pcall(function()
        if game and game.actor_weapon_lowered then
            lowered = game.actor_weapon_lowered() and true or false
        end
    end)
    return lowered
end

local function set_weapon_locked(locked)
    -- Never touch Actor() when no actor exists (menu / net_destroy / level
    -- change): the engine binding dereferences Actor() without a null check.
    if not (db and db.actor) then
        weapon_hidden_by_us = false
        return
    end
    -- game.actor_lower_weapon / game.actor_weapon_lowered are the real
    -- engine bindings (level_script.cpp:2843-2844, registered into
    -- module(L, "game") opened at level_script.cpp:2778). There is no
    -- level.actor_lower_weapon and no level.actor_set_safemode.
    pcall(function()
        if game and game.actor_lower_weapon then
            game.actor_lower_weapon(locked and true or false)
        end
    end)

    if locked then
        -- Opt-in last resort (see ALLOW_HIDE_WEAPON): called at most once per
        -- hidden episode, only when safemode actually failed to lower the
        -- weapon. Never re-called on later ticks, so block counters stay
        -- balanced against the single restore below.
        if ALLOW_HIDE_WEAPON and not weapon_hidden_by_us and not actor_weapon_lowered() then
            pcall(function() db.actor:hide_weapon() end)
            weapon_hidden_by_us = true
        end
    elseif weapon_hidden_by_us then
        pcall(function() db.actor:restore_weapon() end)
        weapon_hidden_by_us = false
    end
end

-- Re-holster enforcement: the engine clears safemode on weapon actions
-- (Weapon.cpp:3195-3196, WeaponMagazined.cpp:1191), so a 1 Hz reconcile plus
-- the actor_item_to_slot hook (bind_stalker_ext.script:381-393 forwards it as
-- SendScriptCallback("actor_item_to_slot", obj)) keeps the weapon down/hidden.
-- Re-runs unconditionally while enforced so a stale hide/recover state is
-- corrected on the next tick.
local function enforce_weapon_lock()
    if not enforced then return end
    if not (db and db.actor) then return end
    set_weapon_locked(true)
end

local function on_actor_item_to_slot(obj)
    pcall(function()
        if enforced then set_weapon_locked(true) end
    end)
end

-- AI hostility suppression. xr_combat_ignore.is_enemy is Anomaly's enemy
-- gate; wrap it with the same save/chain pattern xrRazom uses
-- (xrr_patch_common.script:232-256). Returns false when EITHER side stands in
-- a safe zone, otherwise chain-calls the original pcall-wrapped.
local combat_ignore_hooked = false
local orig_combat_is_enemy = nil
local installed_combat_wrapper = nil
local combat_ignore_reinstall_count = 0
local combat_ignore_reinstall_logged = false
local COMBAT_IGNORE_REINSTALL_CAP = 16

local function install_combat_ignore_hook()
    -- While co-op is live: no fresh install and no re-install (never fight a
    -- wrapper xrRazom installed over ours; its apply() wraps this symbol at
    -- xrr_patch_common.script:232-256).
    if xrr_is_active() then return end
    if type(xr_combat_ignore) ~= "table" then return end
    local current = xr_combat_ignore.is_enemy

    if combat_ignore_hooked then
        -- Another script may re-assign is_enemy after startup (load order /
        -- hot reload). Re-install our wrapper when it is gone; bounded retries
        -- and a single log line so a script that re-wraps every tick cannot
        -- cause an endless wrap/log ping-pong.
        if current == installed_combat_wrapper then return end
        if type(orig_combat_is_enemy) ~= "function" then return end
        if combat_ignore_reinstall_count >= COMBAT_IGNORE_REINSTALL_CAP then return end
        combat_ignore_reinstall_count = combat_ignore_reinstall_count + 1
        xr_combat_ignore.is_enemy = installed_combat_wrapper
        if not combat_ignore_reinstall_logged then
            combat_ignore_reinstall_logged = true
            printf("[zone_safezone] xr_combat_ignore.is_enemy was replaced; wrapper re-installed")
        end
        return
    end

    if type(current) ~= "function" then return end
    orig_combat_is_enemy = current
    installed_combat_wrapper = function(obj, enemy, no_memory)
        -- Dormant wrapper: while co-op is live the saved chain is called
        -- untouched, so neither Zone's veto nor xrRazom's own wrapper
        -- composition is disturbed.
        if xrr_is_active() then
            local ok_orig, result = pcall(orig_combat_is_enemy, obj, enemy, no_memory)
            if ok_orig then return result end
            return true
        end
        local ok_zone, blocked = pcall(safezone_pair_blocked, obj, enemy)
        if ok_zone and blocked then return false end
        local ok, result = pcall(orig_combat_is_enemy, obj, enemy, no_memory)
        if ok then return result end
        -- A wrapper failure must not globally disable enemy acquisition;
        -- fall back to the engine default (hostile).
        return true
    end
    xr_combat_ignore.is_enemy = installed_combat_wrapper
    combat_ignore_hooked = true
end

-- Secondary layer for bases that dispatch on_enemy_eval from within
-- is_enemy. Flag convention verified against xrr_patch_pba.script:29-34 and
-- xrr_patch_common.script:237-246 (flags.override / flags.result).
local function on_enemy_eval(obj, enemy, flags)
    pcall(function()
        -- While co-op is live, never clobber the enemy evaluation; xrRazom
        -- drives its own override convention (xrr_patch_common.script:237-246).
        if xrr_is_active() then return end
        if type(flags) ~= "table" then return end
        if not safezone_pair_blocked(obj, enemy) then return end
        flags.override = true
        flags.result = false
    end)
end

-- Engine-level veto for mutants: every CCustomMonster consults its
-- memory().enemy() useful callback before acquiring a target
-- (enemy_manager.cpp:76-118, invoked at line 109). Stalkers are already
-- covered by the is_enemy wrap.
--
-- LIMITATION: set_enemy_callback is a single-slot setter with no getter in the
-- engine binding (script_game_object_use.cpp:177-211; luabind overloads at
-- script_game_object_script2.cpp:177-182 only set/clear). A previously
-- installed callback cannot be read back, so it cannot be chained; installing
-- this wrapper replaces any other mod's callback for that monster. Install
-- only once per spawned monster so repeated net-spawn callbacks cannot
-- re-wrap it.
local enemy_cb_installed = {}
local enemy_cb_count = 0

local function monster_useful_enemy(monster, enemy)
    -- Callback contract (enemy_manager.cpp:101,109): the engine invokes
    -- m_useful_callback(monster_lua_go, enemy_lua_go) and treats a missing
    -- callback as `true`. Return true = "useful, keep default hostility";
    -- false = drop the target. While co-op is live this callback must be
    -- neutral, so report the engine default.
    if xrr_is_active() then return true end
    local ok, blocked = pcall(safezone_pair_blocked, monster, enemy)
    if ok and blocked then return false end
    return true
end

local function on_monster_net_spawn(monster, se_obj)
    pcall(function()
        -- Never install ours while co-op is live; already-installed callbacks
        -- stay neutral via monster_useful_enemy's dormancy check.
        if xrr_is_active() then return end
        if not (monster and monster.set_enemy_callback) then return end
        local id = nil
        pcall(function() id = monster:id() end)
        if id ~= nil then
            if enemy_cb_installed[id] then return end
            if enemy_cb_count > 256 then
                enemy_cb_installed = {}
                enemy_cb_count = 0
            end
            enemy_cb_installed[id] = true
            enemy_cb_count = enemy_cb_count + 1
        end
        monster:set_enemy_callback(monster_useful_enemy)
    end)
end

local function notify_hud(locked)
    if zone_hud and zone_hud.notify_safezone then
        pcall(function()
            zone_hud.notify_safezone(locked and true or false, locked and (safe_zone_id or "") or "")
        end)
    end
end

local function apply_enter()
    pcall(install_fire_hook)
    pcall(function() set_weapon_locked(true) end)
    -- Release a possibly-held fire key so the engine does not keep firing
    -- while the zone lock is being applied. level.release_action is the
    -- "level" module binding (level_script.cpp:2662; impl 1201-1207) and
    -- bind_to_dik maps a key_bindings action to its DIK (returns 0 unbound,
    -- key_binding_registrator_script.cpp:9-12,26; xr_level_controller.cpp:447-465).
    pcall(function()
        if level and level.release_action and bind_to_dik and key_bindings then
            local dik = bind_to_dik(key_bindings.kWPN_FIRE)
            if dik ~= nil and dik ~= 0 then
                level.release_action(dik)
            end
        end
    end)
    notify_hud(true)
end

local function apply_exit()
    pcall(function() set_weapon_locked(false) end)
    notify_hud(false)
end

local function refresh_enforcement()
    -- Co-op live: never enter enforcement, whatever the (stale) packet/atomic
    -- state says; the next active tick resets the remaining flags.
    local locked = (packet_locked or auth_locked) and not xrr_is_active()
    if locked == enforced then return end
    enforced = locked
    if locked then
        apply_enter()
    else
        apply_exit()
    end
end

-- SAFEZONE_STATE (0x0020): locked u8 + zoneID[32]. Packet state drives the
-- banner/zone id; the atomic poll below only reconciles enforcement.
function on_safezone_state(pkt, offset)
    pcall(function()
        local locked, pos = zone_net.read_uint8(pkt, offset)
        if locked == nil then return end
        local zid = ""
        pcall(function()
            local raw = zone_net.read_string(pkt, pos, 32)
            if type(raw) == "string" then zid = raw:gsub("%z+", "") end
        end)
        packet_locked = (locked == 1)
        if packet_locked and zid ~= "" then safe_zone_id = zid end
        refresh_enforcement()
    end)
end

local function poll_authoritative()
    if not (ZoneNet and ZoneNet.IsInSafeZone) then
        auth_locked = false
        refresh_enforcement()
        return
    end
    local connected = true
    pcall(function()
        if ZoneNet.IsConnected then connected = ZoneNet:IsConnected() and true or false end
    end)
    if not connected then
        -- Never leave local enforcement sticky on a dead session; the
        -- explicit disconnect path also calls reset().
        auth_locked = false
        refresh_enforcement()
        return
    end
    local ok, res = pcall(function() return ZoneNet:IsInSafeZone() end)
    auth_locked = (ok and res == true)
    refresh_enforcement()
end

local function on_actor_update()
    local tg = 0
    pcall(function() tg = time_global() end)
    if type(tg) ~= "number" then return end
    if tg - last_poll < POLL_INTERVAL_MS then return end
    last_poll = tg

    -- Co-op dormancy: release any local Zone state once, then leave input,
    -- fire, hit and AI hooks alone for as long as the session lives.
    if xrr_is_active() then
        if enforced or packet_locked or auth_locked or safe_zone_id ~= "" then
            pcall(reset)
        end
        return
    end

    pcall(poll_authoritative)
    pcall(enforce_weapon_lock)
    pcall(install_combat_ignore_hook)
    -- Re-install the fire veto if another script replaced _G.CActor_Fire.
    pcall(install_fire_hook)
end

-- Hard damage cancel when either the victim or (for direct hits) the
-- draftsman is inside a safe zone, in addition to zeroing the power.
-- Actor hits dispatch WITHOUT a victim (CActor__BeforeHitCallback,
-- _g.script:1221-1238, sends shit/bone_id/flags only), while NPC/monster
-- hits prepend the victim (_g.script:1243-1254). A single shared handler
-- therefore never matched the actor path and the pcall swallowed the error,
-- so actor immunity silently never applied. Separate registrations below.
local function apply_hit_block(victim, s_hit, bone_id, flags)
    if not s_hit then return end
    pcall(function()
        -- Co-op live: never cancel damage; xrRazom owns hit arbitration.
        if xrr_is_active() then return end
        local draftsman = nil
        pcall(function() draftsman = s_hit.draftsman end)

        local block = object_in_safezone(victim)
        if not block and draftsman ~= nil then
            block = object_in_safezone(draftsman)
        end
        if not block then return end

        pcall(function() s_hit.power = 0 end)
        if type(flags) == "table" then
            flags.ret_value = false
            flags.result = false
            flags.override = true
        end
    end)
end

local function on_actor_before_hit(s_hit, bone_id, flags)
    apply_hit_block(db and db.actor or nil, s_hit, bone_id, flags)
end

local function on_npc_before_hit(obj, s_hit, bone_id, flags)
    apply_hit_block(obj, s_hit, bone_id, flags)
end

local function on_monster_before_hit(obj, s_hit, bone_id, flags)
    apply_hit_block(obj, s_hit, bone_id, flags)
end

-- Cheap guard: while the Zone chat edit box is capturing text, do not treat
-- keystrokes as offensive input (the edit box owns the keyboard through the
-- UI, not through this block list).
local function chat_input_open()
    local open = false
    pcall(function()
        if zone_hud and zone_hud.is_chat_open then open = zone_hud.is_chat_open() == true end
    end)
    return open
end

-- actor_menu.is_hud_free() is the base game's canonical "no UI owns input"
-- predicate (actor_menu.script:21-23: actor-menu mode 0, PDA dialog closed,
-- no registered custom GUI). While it is false (inventory/trade/loot/PDA/
-- custom UI), NEVER consume a key: the engine dispatches on_before_key_press
-- before UI input, so an eaten key would also be dead for the open window.
-- FAIL-SAFE: if the probe is missing or throws, treat the UI as open and do
-- NOT block keys (an unknown state must never eat input; a missed weapon-block
-- is recovered by the fire veto and the 1 Hz reconcile).
local function ui_input_open()
    local open = true
    if actor_menu and type(actor_menu.is_hud_free) == "function" then
        local ok, free = pcall(actor_menu.is_hud_free)
        if ok then open = (free ~= true) end
    end
    return open
end

-- dis is g_bDisableAllInput (level.disable_input()), set by scripts -- NOT a
-- UI-open flag. When set, the engine discards the key after this callback
-- anyway (Level_input.cpp:194-198,283), so never eat it either.
local function on_before_key_press(dik, bind, dis, flags)
    if type(flags) ~= "table" then return end
    -- Co-op live: never consume a key (xrRazom binds, e.g. kXRR_CHAT, must
    -- reach the engine untouched).
    if xrr_is_active() then return end
    if dis then return end
    if chat_input_open() then return end
    if ui_input_open() then return end
    pcall(function()
        if not enforced then return end
        ensure_blocklist()
        -- Allowlist floor: only real, explicitly weapon-only action ids can be
        -- blocked; the never-block set wins even if BLOCKED is corrupted.
        if type(bind) ~= "number" or bind == 0 then return end
        if NEVER_BLOCK_IDS[bind] == true then return end
        if BLOCKED[bind] == true then flags.ret_value = false end
    end)
end

local function on_before_key_hold(dik, bind, dis, flags)
    if type(flags) ~= "table" then return end
    -- Co-op live: never consume a held key.
    if xrr_is_active() then return end
    if dis then return end
    if chat_input_open() then return end
    if ui_input_open() then return end
    pcall(function()
        if not enforced then return end
        ensure_blocklist()
        if type(bind) ~= "number" or bind == 0 then return end
        if NEVER_BLOCK_IDS[bind] == true then return end
        if BLOCKED[bind] == true then flags.ret_value = false end
    end)
end

local function on_level_changing()
    reset()
end

function reset()
    packet_locked = false
    auth_locked = false
    enforced = false
    safe_zone_id = ""
    pcall(function() set_weapon_locked(false) end)
    notify_hud(false)
    wipe_zone_cache()
    enemy_cb_installed = {}
    enemy_cb_count = 0
end

function on_game_start()
    if registered then return end
    registered = true
    pcall(build_blocklist)
    pcall(install_fire_hook)
    pcall(install_combat_ignore_hook)

    local function reg(name, fn)
        pcall(function()
            if RegisterScriptCallback then
                RegisterScriptCallback(name, fn)
            end
        end)
    end

    reg("actor_on_before_hit", on_actor_before_hit)
    reg("npc_on_before_hit", on_npc_before_hit)
    reg("monster_on_before_hit", on_monster_before_hit)
    reg("on_level_changing", on_level_changing)
    reg("actor_on_net_destroy", reset)
    reg("on_before_key_press", on_before_key_press)
    reg("on_before_key_hold", on_before_key_hold)
    reg("actor_on_update", on_actor_update)
    reg("on_enemy_eval", on_enemy_eval)
    reg("actor_item_to_slot", on_actor_item_to_slot)
    reg("monster_on_net_spawn", on_monster_net_spawn)
end
