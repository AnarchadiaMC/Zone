-- zone_net.script
-- Network dispatcher and transform sync

local ffi = require("ffi")

local last_tick = 0
local TICK_RATE_MS = 33 -- ~30Hz
local faction_ui_opened = false
local faction_ui = nil
local was_connected = false
local last_level_sent = nil
local last_visual_sent = nil
local last_visual_check = 0
local VISUAL_CHECK_MS = 1000
local DEFAULT_VISUAL = "actors\\stalker_neutral\\stalker_neutral_1"
local zone_callbacks_registered = false

-- Join/spawn flow state ------------------------------------------------------
-- Set by OpLoadLevel (0x0073); applied immediately in-game or on first actor
-- update after the menu-initiated level start. The marker file carries the
-- target across the Lua VM restart that a level load triggers.
local pending_spawn = nil
local pending_inventory = {}
local last_applied_inventory_fingerprint = nil
local apply_inventory_pending = false
local level_start_issued = false
local JOIN_MARKER = "zone_pending_join.ltx"

-- Item ledger state (OpItemAction 0x007D / OpItemUpdate 0x007E, protocol v4).
-- Declared here (before reset_state) so disconnect/reset can clear it.
local next_item_action_id = 0
local pending_item_actions = {}
local spawned_world_items = {}

-- Forward declarations: dispatch_packet references these but they are defined
-- after it (they need the parse helpers declared further down). clear_pending_join
-- is forward-declared so reset_state can disarm the on-disk join marker.
local on_load_level, on_inventory_sync, on_server_error, handle_show_start
local clear_pending_join

function read_uint8(pkt, pos)
    return string.byte(pkt, pos), pos + 1
end

function read_uint16_le(pkt, pos)
    local b1, b2 = string.byte(pkt, pos, pos + 1)
    return b1 + (b2 * 256), pos + 2
end

function read_uint32_le(pkt, pos)
    local b1, b2, b3, b4 = string.byte(pkt, pos, pos + 3)
    return b1 + (b2 * 256) + (b3 * 65536) + (b4 * 16777216), pos + 4
end

local function clean_cstring(raw)
    if type(raw) ~= "string" then return "" end
    local z = string.find(raw, "%z")
    if z then raw = string.sub(raw, 1, z - 1) end
    return raw
end

-- OpServerQueryRes (0x0007) payload:
-- name[32] map[32] players u8 max u8 mode u8 locked u8 proto u8 tick u8
local function parse_server_query_response(raw)
    local info = { name = "", map = "", players = 0, maxPlayers = 0,
                   mode = 0, locked = 0, proto = 0, tick = 0 }
    if type(raw) ~= "string" then return info end
    local len = string.len(raw)
    if len >= 32 then info.name = clean_cstring(string.sub(raw, 1, 32)) end
    if len >= 64 then info.map = clean_cstring(string.sub(raw, 33, 64)) end
    local fields = { "players", "maxPlayers", "mode", "locked", "proto", "tick" }
    local pos = 65
    for i = 1, #fields do
        if pos <= len then info[fields[i]] = string.byte(raw, pos) or 0 end
        pos = pos + 1
    end
    return info
end

-- ZN_PollEvent contract: `buf` is a caller-owned buffer with a capacity fixed
-- at 1500 bytes (enforced by the DLL); `len` is out-only - the DLL writes the
-- byte count, callers must not pre-seed it. g_poll_buf stays 1500 bytes.
ffi.cdef[[
    typedef union { float f; uint8_t b[4]; } znet_float_cast;
    void ZN_Connect(const char* ip, double port, const char* uuid, double hwid, const char* nick);
    void ZN_Disconnect();
    void ZN_SendTransform(float x, float y, float z, int16_t yaw, int16_t pitch, uint8_t flags, uint16_t gvid);
    bool ZN_PollEvent(char* buf, size_t* len);
    bool ZN_IsInSafeZone();
    bool ZN_IsConnected();
    void ZN_GetSessionInfo(uint32_t* sessionID, uint32_t* ping);
    void ZN_SendChatText(const char* text);
    const char* ZN_GetLastError();
    bool ZN_IsPendingCreate();
    bool ZN_HasCharacter();
    void ZN_GetSpawn(float* x, float* y, float* z, uint8_t* level, uint8_t* ecoTier);
    const char* ZN_GetFaction();
    bool ZN_SendCharacterSelect(const char* faction, double money, const char* items_str);
    void ZN_SendLevelChange(const char* level);
    void ZN_SendPlayerVisual(const char* visual);
    int ZN_SendRaw(uint16_t opcode, const char* payload, int payloadLen, int reliable);
    int ZN_QueryServer(const char* ip, int port, char* out, int outLen, int timeoutMs);
    int ZN_QueryStart(const char* ip, int port, int timeoutMs);
    int ZN_QueryPoll(int queryId, char* out, int outLen, int* outRttMs);
    void ZN_QueryCancel(int queryId);
    void ZN_QueryCancelAll();
]]

-- L-31: Pre-allocated FFI buffers at file/module scope
local g_poll_buf = ffi.new("char[1500]")
local g_poll_len = ffi.new("size_t[1]")
local g_float_cast = ffi.new("znet_float_cast")
local QUERY_BUF_LEN = 1024
local g_query_buf = ffi.new("char[1024]")
-- Async query polyfill buffers (ZN_QueryPoll result + measured RTT).
local ASYNC_QUERY_BUF_LEN = 1024
local g_async_query_buf = ffi.new("char[1024]")
local g_async_rtt = ffi.new("int[1]")
-- Cached positive result of the async-export probe (see HasAsyncQuery).
local async_query_supported = nil

local zone_client = nil
pcall(function()
    zone_client = ffi.load("ZoneClient")
end)

-- Expose is_client_loaded() so zone_main.script can detect it
function is_client_loaded()
    return zone_client ~= nil
end

-- Error surfacing ------------------------------------------------------------
-- No failure may stay silent. Every message is logged and routed to whichever
-- player-visible surface is up: game news in-game, the faction dialog or the
-- server browser status line in the menu.
local last_preserved_error = ""
local dispatch_logged = {}
local inv_parse_notified = false

local function tr(id, fallback)
    local ok, s = pcall(function() return game.translate_string(id) end)
    if ok and type(s) == "string" and s ~= "" and s ~= id then return s end
    return fallback or id
end

local function log_dispatch_once(key, fmt, ...)
    if dispatch_logged[key] then return end
    dispatch_logged[key] = true
    printf(fmt, ...)
end

-- Handler isolation: a throwing consumer must not kill the packet pump, but it
-- must not vanish either - log the first failure per opcode/handler.
local function safe_call(key, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        log_dispatch_once("handler_" .. tostring(key),
            "Zone: packet handler %s failed: %s", tostring(key), tostring(err))
    end
    return ok
end

-- Map raw DLL error strings onto localized ids. Falls back to the raw text.
local function localize_net_error(raw)
    if type(raw) ~= "string" or raw == "" then return nil end
    local low = raw:lower()
    if low:find("banned", 1, true) then return tr("ui_zone_err_banned", raw) end
    if low:find("full", 1, true) then return tr("ui_zone_err_server_full", raw) end
    if low:find("version", 1, true) or low:find("proto", 1, true) then
        return tr("ui_zone_err_version", raw)
    end
    if low:find("kick", 1, true) then return tr("ui_zone_err_kick", raw) end
    if low:find("timed out", 1, true) or low:find("timeout", 1, true) then
        return tr("ui_zone_err_timeout", raw)
    end
    if low:find("handshake", 1, true) then return tr("ui_zone_err_handshake", raw) end
    return raw
end

local function peer_faction_dialog()
    local dlg = nil
    pcall(function()
        if type(_G.get_peer_faction_dialog) == "function" then
            dlg = _G.get_peer_faction_dialog()
        end
        if not dlg and zone_ui_peer_faction
            and type(zone_ui_peer_faction.get_peer_faction_dialog) == "function" then
            dlg = zone_ui_peer_faction.get_peer_faction_dialog()
        end
    end)
    return dlg
end

local function surface_message(msg)
    msg = tostring(msg or "")
    if msg == "" then return end
    printf("Zone: %s", msg)
    local shown = false
    pcall(function()
        if db and db.actor then
            db.actor:give_game_news("Zone", msg, "ui_inGame2_PDA_icon", 0, 6000, 0)
            shown = true
        end
    end)
    if shown then return end
    -- Menu context: the faction dialog or the server browser is the surface.
    pcall(function()
        local dlg = peer_faction_dialog()
        if dlg and dlg.IsShown and dlg:IsShown() and dlg.OnServerError then
            dlg:OnServerError(msg)
        end
    end)
    pcall(function()
        local dlg = nil
        if zone_ui_server_list and type(zone_ui_server_list.get_dialog) == "function" then
            dlg = zone_ui_server_list.get_dialog()
        end
        if dlg and dlg.ReportError then dlg:ReportError(msg) end
    end)
end

-- Tracks co-op-takeover cleanup so dormant-branch release runs once.
local xrr_was_active = false

-- L-06: Exported reset_state for reconnecting
function reset_state()
    -- Preserve the last DLL error across the reset so a rejection reason is
    -- never lost before the UI has had a chance to display it.
    local prev = ZoneNet and ZoneNet.GetLastError and ZoneNet:GetLastError() or ""
    if type(prev) == "string" and prev ~= "" then last_preserved_error = prev end
    last_tick = 0
    xrr_was_active = false
    was_connected = false
    last_level_sent = nil
    last_visual_sent = nil
    last_visual_check = 0
    -- Disarm any menu-initiated join marker: without this a later
    -- actor_on_first_update in a fresh session could apply a stale
    -- spawn/faction from a previous join attempt.
    pending_spawn = nil
    pending_inventory = {}
    last_applied_inventory_fingerprint = nil
    apply_inventory_pending = false
    level_start_issued = false
    inv_parse_notified = false
    -- Item ledger: drop pending actions and tracking. Visual world items made
    -- for remote drops stay in the level until the engine clears them; the
    -- server re-tells them after a reconnect (0x007E), so no release here.
    next_item_action_id = 0
    pending_item_actions = {}
    spawned_world_items = {}
    if clear_pending_join then pcall(clear_pending_join) end
end

-- Polyfill ZoneNet global object for compatibility
_G.ZoneNet = {}
function ZoneNet:Connect(ip, port, uuid, hwid, nick)
    reset_state()
    if zone_client then zone_client.ZN_Connect(ip, port, uuid, hwid, nick) end
end
function ZoneNet:Disconnect()
    reset_state()
    if zone_client then pcall(function() zone_client.ZN_Disconnect() end) end
    pcall(function()
        if zone_safezone and zone_safezone.reset then zone_safezone.reset() end
    end)
end
function ZoneNet:SendTransform(x, y, z, yaw, pitch, flags, gvid)
    if zone_client then
        zone_client.ZN_SendTransform(x, y, z, yaw or 0, pitch or 0, flags or 0, gvid or 0)
    end
end
function ZoneNet:SendLevelChange(level_name)
    if not zone_client then return false end
    local ok = pcall(function()
        zone_client.ZN_SendLevelChange(level_name or "")
    end)
    return ok
end
function ZoneNet:SendPlayerVisual(visual)
    if not zone_client then return false end
    local ok = pcall(function()
        zone_client.ZN_SendPlayerVisual(visual or "")
    end)
    return ok
end
-- Raw opcode send (protocol v4). Payload may be a Lua string or an FFI
-- char buffer. Returns true only when the DLL reported success (>= 0), false
-- on any failure (missing export on an older DLL raises inside pcall).
function ZoneNet:SendRaw(opcode, payload, len, reliable)
    if not zone_client then return false end
    local op = tonumber(opcode)
    if not op or op < 0 or op > 65535 then return false end
    local n = tonumber(len) or 0
    if n < 0 or n > 4096 then return false end
    local rel = reliable and 1 or 0
    local ok, res = pcall(function()
        return zone_client.ZN_SendRaw(math.floor(op), payload, math.floor(n), rel)
    end)
    if not ok then return false end
    return (type(res) == "number" and res >= 0)
end
-- Synchronous server query (server browser). Returns the parsed
-- OpServerQueryRes payload table plus measured ping, or nil, error.
function ZoneNet:QueryServer(ip, port, timeout_ms)
    if not zone_client then return nil, "client not loaded" end
    local ip_s = ip
    if type(ip_s) ~= "string" or ip_s == "" then ip_s = "127.0.0.1" end
    local port_n = tonumber(port) or 27015
    port_n = math.floor(port_n)
    if port_n < 1 or port_n > 65535 then return nil, "invalid port" end
    local timeout = tonumber(timeout_ms) or 1500
    timeout = math.floor(timeout)
    if timeout < 1 then timeout = 1 end
    if timeout > 10000 then timeout = 10000 end

    local started = os.clock()
    local ok, res = pcall(function()
        return zone_client.ZN_QueryServer(ip_s, port_n, g_query_buf, QUERY_BUF_LEN, timeout)
    end)
    if not ok then return nil, "query call failed" end
    if type(res) ~= "number" or res <= 0 then
        return nil, string.format("no response (%s)", tostring(res))
    end
    if res > QUERY_BUF_LEN then res = QUERY_BUF_LEN end

    local elapsed_ms = math.floor(((os.clock() - started) * 1000) + 0.5)
    if elapsed_ms < 0 then elapsed_ms = 0 end

    local info = parse_server_query_response(ffi.string(g_query_buf, res))
    info.ping_ms = elapsed_ms
    return info
end
-- Async query API (server browser): start N queries, poll them from the UI
-- update without blocking. ZN_QueryPoll returns >0 payload bytes when ready,
-- 0 while pending, -1 on failure/timeout (the id is cleaned up by the DLL).
function ZoneNet:QueryStart(ip, port, timeout_ms)
    if not zone_client then return nil, "client not loaded" end
    local ip_s = ip
    if type(ip_s) ~= "string" or ip_s == "" then ip_s = "127.0.0.1" end
    local port_n = tonumber(port) or 27015
    port_n = math.floor(port_n)
    if port_n < 1 or port_n > 65535 then return nil, "invalid port" end
    local timeout = tonumber(timeout_ms) or 750
    timeout = math.floor(timeout)
    if timeout < 1 then timeout = 1 end
    if timeout > 10000 then timeout = 10000 end

    local ok, id = pcall(function()
        return zone_client.ZN_QueryStart(ip_s, port_n, timeout)
    end)
    if not ok then return nil, "query start call failed" end
    if type(id) ~= "number" or id <= 0 then
        return nil, string.format("query start rejected (%s)", tostring(id))
    end
    return math.floor(id)
end
function ZoneNet:QueryPoll(query_id)
    if not zone_client then return false, "client not loaded" end
    local qid = tonumber(query_id)
    if not qid or qid <= 0 then return false, "invalid query id" end
    qid = math.floor(qid)

    local ok, res = pcall(function()
        return zone_client.ZN_QueryPoll(qid, g_async_query_buf, ASYNC_QUERY_BUF_LEN, g_async_rtt)
    end)
    if not ok then return false, "query poll call failed" end
    if type(res) ~= "number" then return false, "query poll bad result" end
    if res == 0 then return nil end
    if res < 0 then return false, "query failed or timed out" end
    if res > ASYNC_QUERY_BUF_LEN then res = ASYNC_QUERY_BUF_LEN end

    local info = parse_server_query_response(ffi.string(g_async_query_buf, res))
    local rtt = tonumber(g_async_rtt[0]) or 0
    if rtt < 0 then rtt = 0 end
    info.ping_ms = rtt
    return info
end
function ZoneNet:QueryCancel(query_id)
    if not zone_client then return end
    local qid = tonumber(query_id)
    if not qid or qid <= 0 then return end
    pcall(function() zone_client.ZN_QueryCancel(math.floor(qid)) end)
end
function ZoneNet:QueryCancelAll()
    if not zone_client then return end
    pcall(function() zone_client.ZN_QueryCancelAll() end)
end
-- True when the loaded DLL exports the async query API. Detected once by
-- starting and immediately cancelling a throwaway query. Failure is not
-- cached: the DLL may be redeployed between scans.
function ZoneNet:HasAsyncQuery()
    if not zone_client then return false end
    if async_query_supported ~= nil then return async_query_supported end
    local ok = pcall(function()
        local id = zone_client.ZN_QueryStart("127.0.0.1", 1, 1)
        if type(id) == "number" and id > 0 then
            zone_client.ZN_QueryCancel(id)
        end
    end)
    if ok then async_query_supported = true end
    return ok and true or false
end
function ZoneNet:PollEvent()
    if not zone_client then return nil end
    if zone_client.ZN_PollEvent(g_poll_buf, g_poll_len) then
        return ffi.string(g_poll_buf, g_poll_len[0])
    end
    return nil
end
function ZoneNet:IsInSafeZone()
    return zone_client and zone_client.ZN_IsInSafeZone() or false
end
function ZoneNet:IsConnected()
    return zone_client and zone_client.ZN_IsConnected() or false
end
function ZoneNet:GetSessionInfo()
    if not zone_client then return 0, 0 end
    local sid = ffi.new("uint32_t[1]")
    local ping = ffi.new("uint32_t[1]")
    zone_client.ZN_GetSessionInfo(sid, ping)
    return sid[0], ping[0]
end
function ZoneNet:SendChatText(text)
    if zone_client then zone_client.ZN_SendChatText(text) end
end
function ZoneNet:GetLastError()
    if not zone_client then return "" end
    local ok, err = pcall(function() return zone_client.ZN_GetLastError() end)
    if ok and err then
        local ok2, s = pcall(function() return ffi.string(err) end)
        if ok2 and s then return s end
    end
    return ""
end
-- Last error preserved across reset_state (connect/disconnect). Lets the UI
-- show a handshake rejection even after a fast retry cleared the DLL error.
function ZoneNet:GetPreservedError()
    return last_preserved_error
end
function ZoneNet:ClearPreservedError()
    last_preserved_error = ""
end
function ZoneNet:LocalizeError(raw)
    return localize_net_error(raw)
end
function ZoneNet:IsClientLoaded()
    return is_client_loaded()
end
function ZoneNet:IsPendingCreate()
    return zone_client and zone_client.ZN_IsPendingCreate() or false
end
function ZoneNet:HasCharacter()
    return zone_client and zone_client.ZN_HasCharacter() or false
end
function ZoneNet:GetSpawn()
    if not zone_client then return 0, 0, 0 end
    local x = ffi.new("float[1]")
    local y = ffi.new("float[1]")
    local z = ffi.new("float[1]")
    -- Real C signature is 5 pointers (level/ecoTier out params) - pass
    -- throwaway buffers instead of calling the old 3-arg ABI bug.
    local lvl = ffi.new("uint8_t[1]")
    local eco = ffi.new("uint8_t[1]")
    local ok = pcall(function() zone_client.ZN_GetSpawn(x, y, z, lvl, eco) end)
    if not ok then return 0, 0, 0 end
    return x[0], y[0], z[0], lvl[0], eco[0]
end
function ZoneNet:GetFaction()
    if not zone_client then return "" end
    local ok, ptr = pcall(function() return zone_client.ZN_GetFaction() end)
    if ok and ptr then
        local ok2, s = pcall(function() return ffi.string(ptr) end)
        if ok2 and s then return s end
    end
    return ""
end
-- Economy tier delivered by the handshake (ZN_GetSpawn out-param).
function ZoneNet:GetEcoTier()
    local _, _, _, _, eco = self:GetSpawn()
    return tonumber(eco) or 0
end
-- Back-compat alias used by zone_ui_peer_faction.zone_eco_tier().
function ZoneNet:HostEcoTier()
    return self:GetEcoTier()
end
function ZoneNet:SendCharacterSelect(faction, money, items_str)
    if not zone_client then return false end
    local ok, res = pcall(function() return zone_client.ZN_SendCharacterSelect(faction or "", money or 0, items_str or "") end)
    if ok then return res end
    return false
end
local function close_faction_ui()
    pcall(function()
        if faction_ui and faction_ui.Show then faction_ui:Show(false) end
    end)
    pcall(function()
        if faction_ui and faction_ui.HideDialog then faction_ui:HideDialog() end
    end)
    faction_ui = nil
end
local function open_faction_ui_once(owner)
    if faction_ui_opened then return end
    faction_ui_opened = true
    pcall(function()
        -- Sole owner of the pending-create UI: prefer the shared global, then
        -- the script table (per-file env isolation), then the raw UI class.
        local open_fn = _G.open_peer_faction
        if type(open_fn) ~= "function" and zone_ui_peer_faction then
            open_fn = zone_ui_peer_faction.open_peer_faction
        end
        if type(open_fn) == "function" then
            faction_ui = open_fn(owner)
        elseif _G.UIZonePeerFaction then
            local ui = _G.UIZonePeerFaction(owner)
            if ui and ui.ShowDialog then ui:ShowDialog(true) end
            if ui and ui.Show then ui:Show(true) end
            faction_ui = ui
        end
    end)
end
-- OpShowStart handling lives in zone_main.on_show_start (single owner);
-- dispatch reaches it through handle_show_start (defined below).

function read_float_le(pkt, pos)
    local b1, b2, b3, b4 = string.byte(pkt, pos, pos + 3)
    g_float_cast.b[0] = b1
    g_float_cast.b[1] = b2
    g_float_cast.b[2] = b3
    g_float_cast.b[3] = b4
    return g_float_cast.f, pos + 4
end

function read_string(pkt, pos, len)
    return string.sub(pkt, pos, pos + len - 1), pos + len
end

-- ---------------------------------------------------------------------------
-- Item ledger (OpItemAction 0x007D C->S / OpItemUpdate 0x007E S->C, v4).
-- Small zone_item section kept INSIDE this file: creating a new .script would
-- require an embedding manifest update. Dispatch prefers an external
-- _G.zone_item module when one exists, otherwise uses these. Everything is
-- pcall-wrapped and gated off while xrRazom co-op owns the session.
-- Wire layouts:
--   0x007D 88 B: ActionID u32, Action u8, ItemID u32, Section[64], Count u16,
--                X f32, Y f32, Z f32, Condition u8
--   0x007E 89 B: ActionID u32, Result u8, Action u8, ItemID u32, Count i16,
--                Section[64], X f32, Y f32, Z f32, Condition u8
-- Condition is u8 0..100 (matches the 0x0076 inventory-sync convention).
-- ---------------------------------------------------------------------------
local ITEM_ACTION_TTL_MS = 30000
local ITEM_ACTION_PAYLOAD_LEN = 88
local ITEM_DROP_FORWARD = 1.0
local g_item_payload = ffi.new("char[88]")

local function item_payload_u8(buf, off, v)
    buf[off] = bit.band(tonumber(v) or 0, 0xFF)
end

local function item_payload_u16(buf, off, v)
    v = bit.band(tonumber(v) or 0, 0xFFFF)
    buf[off] = v % 256
    buf[off + 1] = math.floor(v / 256) % 256
end

local function item_payload_u32(buf, off, v)
    v = (tonumber(v) or 0) % 4294967296
    buf[off] = v % 256
    buf[off + 1] = math.floor(v / 256) % 256
    buf[off + 2] = math.floor(v / 65536) % 256
    buf[off + 3] = math.floor(v / 16777216) % 256
end

local function item_payload_f32(buf, off, v)
    g_float_cast.f = tonumber(v) or 0
    for i = 0, 3 do buf[off + i] = g_float_cast.b[i] end
end

local function item_payload_section(buf, off, section)
    local n = 0
    if type(section) == "string" then
        n = string.len(section)
        if n > 64 then n = 64 end
    end
    for i = 1, 64 do
        local b = 0
        if i <= n then b = string.byte(section, i) or 0 end
        buf[off + i - 1] = b
    end
end

-- Wire condition is 0..100. item:condition() is 0..1.
local function item_condition_u8(cond)
    if type(cond) ~= "number" then return 100 end
    local v = math.floor(cond * 100 + 0.5)
    if v < 0 then v = 0 end
    if v > 100 then v = 100 end
    return v
end

-- Stack count when the game object exposes it (ammo); 1 otherwise.
local function item_stack_count(item)
    local count = 1
    pcall(function()
        if item.is_ammo and item:is_ammo() and item.ammo_get_count then
            local c = item:ammo_get_count()
            if type(c) == "number" and c > 1 then count = math.floor(c) end
        end
    end)
    if count > 65535 then count = 65535 end
    if count < 1 then count = 1 end
    return count
end

-- Sends are legal only while connected and outside an xrRazom co-op session.
local function item_send_allowed()
    local connected = false
    pcall(function()
        connected = ZoneNet and ZoneNet.IsConnected and ZoneNet:IsConnected() and true or false
    end)
    if not connected then return false end
    local co_op = false
    pcall(function()
        if zone_main and type(zone_main.xrr_is_active) == "function" then
            co_op = zone_main.xrr_is_active() and true or false
        end
    end)
    if co_op then return false end
    return (db and db.actor) ~= nil
end

local function prune_pending_item_actions(tg)
    local stale = nil
    for id, entry in pairs(pending_item_actions) do
        if tg - (entry.time or 0) > ITEM_ACTION_TTL_MS then
            if not stale then stale = {} end
            stale[#stale + 1] = id
        end
    end
    if stale then
        for i = 1, #stale do pending_item_actions[stale[i]] = nil end
    end
end

local function send_item_action(action, item_id, section, count, x, y, z, condition, local_se_id)
    if not item_send_allowed() then return nil end
    if type(section) ~= "string" or section == "" then return nil end
    if not (ZoneNet and type(ZoneNet.SendRaw) == "function") then
        log_dispatch_once("item_no_raw", "Zone: ZN_SendRaw unavailable; item action dropped")
        return nil
    end

    next_item_action_id = next_item_action_id + 1
    if next_item_action_id > 0x7FFFFFFF then next_item_action_id = 1 end
    local action_id = next_item_action_id

    local buf = g_item_payload
    item_payload_u32(buf, 0, action_id)
    item_payload_u8(buf, 4, action)
    item_payload_u32(buf, 5, item_id or 0)
    item_payload_section(buf, 9, section)
    item_payload_u16(buf, 73, count or 1)
    item_payload_f32(buf, 75, x or 0)
    item_payload_f32(buf, 79, y or 0)
    item_payload_f32(buf, 83, z or 0)
    item_payload_u8(buf, 87, condition or 0)

    local sent = ZoneNet:SendRaw(0x007D, buf, ITEM_ACTION_PAYLOAD_LEN, 1)
    if not sent then
        printf("Zone: failed to send item action %d for section %s",
            tonumber(action) or 0, section)
        return nil
    end

    local tg = time_global()
    prune_pending_item_actions(tg)
    pending_item_actions[action_id] = {
        action = action, section = section, count = count or 1,
        time = tg, local_se_id = local_se_id,
    }
    return action_id
end

local function release_world_item_visual(entry)
    if not entry or not entry.se_id then return end
    pcall(function()
        local sim = alife()
        if not sim then return end
        local se = sim:object(entry.se_id)
        if se then sim:release(se, true) end
    end)
end

-- Visual world item for a remote drop. lvid is queried at the packet
-- position; gvid falls back to the local actor's (packet carries none).
local function spawn_world_item_visual(item_id, section, x, y, z, condition)
    if type(section) ~= "string" or section == "" then return false end
    local sim = nil
    pcall(function() sim = alife() end)
    if not sim then return false end

    local pos = nil
    pcall(function() pos = vector():set(x, y, z) end)
    if not pos then return false end

    local lvid = nil
    pcall(function()
        if level and level.vertex_id then lvid = level.vertex_id(pos) end
    end)
    if lvid == nil or lvid >= 0xFFFFFFFE then return false end

    local gvid = 0
    pcall(function()
        if db and db.actor then gvid = db.actor:game_vertex_id() or 0 end
    end)
    if gvid <= 0 then
        printf("Zone: item update: no game vertex for world item %s", section)
        return false
    end

    local se = nil
    pcall(function() se = sim:create(section, pos, lvid, gvid) end)
    if not se then
        printf("Zone: item update: failed to create world item %s", section)
        return false
    end
    local sid = nil
    pcall(function() sid = (type(se.id) == "function") and se:id() or se.id end)
    spawned_world_items[item_id] = { se_id = sid, section = section }
    if sid and type(condition) == "number" and condition > 0 then
        pcall(function()
            local obj = level.object_by_id(sid)
            if obj and obj.set_condition then
                local c = condition / 100
                if c > 1 then c = 1 end
                obj:set_condition(c)
            end
        end)
    end
    return true
end

-- Post-drop hook. Fires after the engine moved the item to the world;
-- position is recomputed from the actor + forward offset (the callback does
-- not hand us the dropped position). Never fatal.
local function on_actor_item_drop(item)
    if not item then return end
    if not item_send_allowed() then return end
    local actor = db.actor

    local section, cond, local_se_id = nil, nil, nil
    pcall(function() section = item:section() end)
    if type(section) ~= "string" or section == "" then return end
    pcall(function() cond = item:condition() end)
    pcall(function() local_se_id = item:id() end)
    local count = item_stack_count(item)

    local x, y, z = 0, 0, 0
    pcall(function()
        local p = actor:position()
        local d = actor:direction()
        x = p.x + (d.x or 0) * ITEM_DROP_FORWARD
        y = p.y + (d.y or 0) * ITEM_DROP_FORWARD
        z = p.z + (d.z or 0) * ITEM_DROP_FORWARD
    end)

    send_item_action(1, 0, section, count, x, y, z, item_condition_u8(cond), local_se_id)
end

-- Post-take hook. ItemID is the server id when we tracked the world object
-- (we or the server made it), otherwise 0 so the server can reject/ignore
-- without breaking the local pickup that already happened.
local function on_actor_item_take(item)
    if not item then return end
    if not item_send_allowed() then return end

    local section, cond, local_id = nil, nil, nil
    pcall(function() section = item:section() end)
    if type(section) ~= "string" or section == "" then return end
    pcall(function() cond = item:condition() end)
    pcall(function() local_id = item:id() end)
    local count = item_stack_count(item)

    local item_id = 0
    if local_id then
        for sid, entry in pairs(spawned_world_items) do
            if entry.se_id == local_id then
                item_id = sid
                break
            end
        end
    end

    local x, y, z = 0, 0, 0
    pcall(function()
        local p = item:position()
        x, y, z = p.x, p.y, p.z
    end)
    if x == 0 and y == 0 and z == 0 then
        pcall(function()
            local p = db.actor:position()
            x, y, z = p.x, p.y, p.z
        end)
    end

    send_item_action(2, item_id, section, count, x, y, z, item_condition_u8(cond))
end

local function on_item_update(pkt, offset)
    local len = string.len(pkt)
    if len < offset + 89 - 1 then
        log_dispatch_once("short_007E", "Zone: dropped short ITEM_UPDATE packet (%d bytes)", len)
        return
    end

    local action_id, pos = read_uint32_le(pkt, offset)
    local result, pos = read_uint8(pkt, pos)
    local action, pos = read_uint8(pkt, pos)
    local item_id, pos = read_uint32_le(pkt, pos)
    local count_raw, pos = read_uint16_le(pkt, pos)
    local count = count_raw
    if count > 32767 then count = count - 65536 end
    local section, pos = read_string(pkt, pos, 64)
    section = clean_cstring(section)
    local x, pos = read_float_le(pkt, pos)
    local y, pos = read_float_le(pkt, pos)
    local z, pos = read_float_le(pkt, pos)
    local condition, _ = read_uint8(pkt, pos)

    local own = pending_item_actions[action_id]
    if own then pending_item_actions[action_id] = nil end
    prune_pending_item_actions(time_global())

    if result == 1 then
        if own then
            local tmpl = tr("ui_zone_item_action_rejected", "Server rejected item action: %s")
            surface_message(string.format(tmpl, tostring(section)))
            printf("Zone: item action rejected (ActionID %u action %d section %s count %d); no inventory resync request path exists (0x0076 is server->client only)",
                tonumber(action_id) or 0, tonumber(action) or 0, tostring(section), tonumber(count) or 0)
        end
        return
    end

    if action == 1 then
        if own then
            -- Our own drop: the engine already created the object locally.
            -- Bind the server ItemID to the local object id captured at drop
            -- time so a later pickup can reference it.
            if item_id ~= 0 and own.local_se_id and not spawned_world_items[item_id] then
                spawned_world_items[item_id] = { se_id = own.local_se_id, section = section, own = true }
            end
            if result == 2 then
                printf("Zone: server corrected our drop of %s (ItemID %u); local object kept",
                    tostring(section), tonumber(item_id) or 0)
            end
        else
            if result == 2 and spawned_world_items[item_id] then
                release_world_item_visual(spawned_world_items[item_id])
                spawned_world_items[item_id] = nil
            end
            if not spawned_world_items[item_id] then
                spawn_world_item_visual(item_id, section, x, y, z, condition)
            end
        end
    elseif action == 2 then
        local entry = spawned_world_items[item_id]
        if entry then
            if (not own) or result == 2 then
                release_world_item_visual(entry)
            end
            spawned_world_items[item_id] = nil
        end
        if own and result == 2 then
            printf("Zone: server corrected pickup of %s (ItemID %u); awaiting server inventory sync if one follows",
                tostring(section), tonumber(item_id) or 0)
        end
    end
end

-- External consumers (and the dispatch fallback) reach the ledger through
-- this global. An external zone_item module (loaded at any point) keeps
-- precedence: only install the local table when none is present.
if type(_G.zone_item) ~= "table" or type(_G.zone_item.on_item_update) ~= "function" then
    _G.zone_item = {
        on_item_update = on_item_update,
        send_item_action = send_item_action,
    }
end

-- ENTITY_ENTER_AOI v3 carries section[64] and a trailing name[32]
-- (entityID u32, type u8, section[64], x/y/z f32, faction[16], health u8,
-- gvid u16, name[32], 132-byte payload). Consumers (zone_dummy/zone_ai_proxy)
-- parse the v3 layout natively.

function dispatch_packet(pkt)
    local plen = (type(pkt) == "string") and string.len(pkt) or 0
    if plen < 12 then
        log_dispatch_once("short_header", "Zone: dropped short packet (%d bytes)", plen)
        return
    end
    
    -- Parse Header (12 bytes)
    -- 2(magic) + 1(proto) + 1(flags) + 4(seq) + 2(opcode) + 2(paylen)
    local magic, pos = read_uint16_le(pkt, 1)
    local proto, pos = read_uint8(pkt, pos)
    local flags, pos = read_uint8(pkt, pos)
    local seq, pos = read_uint32_le(pkt, pos)
    local opcode, pos = read_uint16_le(pkt, pos)
    local paylen, pos = read_uint16_le(pkt, pos)
    
    -- L-10: Validate magic == 0x5A4F and proto == 1
    if magic ~= 0x5A4F or proto ~= 1 then
        log_dispatch_once("bad_header",
            "Zone: dropped packet with bad header (magic 0x%04X proto %d)",
            tonumber(magic) or 0, tonumber(proto) or 0)
        return
    end
    
    -- L-02: Validate payload length (drop truncated packets)
    if plen < 12 + paylen then
        log_dispatch_once(string.format("trunc_%04X", opcode),
            "Zone: dropped truncated packet opcode 0x%04X (have %d bytes, need %d)",
            opcode, plen, 12 + paylen)
        return
    end
    
    local offset = 13 -- 1-based index after 12 bytes
    
    if opcode == 0x0011 then
        if zone_dummy and zone_dummy.on_snapshot then
            safe_call("snapshot", zone_dummy.on_snapshot, pkt, offset)
        end
    elseif opcode == 0x0012 then
        -- Fan out to BOTH player proxies (typ 1) and AI puppets (typ 0/2/3);
        -- each handler filters by type and parses the v3 payload layout.
        if zone_dummy and zone_dummy.on_entity_enter then
            safe_call("entity_enter_dummy", zone_dummy.on_entity_enter, pkt, offset)
        end
        if zone_ai_proxy and zone_ai_proxy.on_entity_enter then
            safe_call("entity_enter_ai", zone_ai_proxy.on_entity_enter, pkt, offset)
        end
    elseif opcode == 0x0013 then
        if zone_dummy and zone_dummy.on_entity_leave then
            safe_call("entity_leave_dummy", zone_dummy.on_entity_leave, pkt, offset)
        end
        if zone_ai_proxy and zone_ai_proxy.on_entity_leave then
            safe_call("entity_leave_ai", zone_ai_proxy.on_entity_leave, pkt, offset)
        end
    elseif opcode == 0x0041 then
        -- Stash responses have no consumer UI yet (no committed stash sender).
        -- Parse minimally and surface errors; never fatal. Future stash UI
        -- should hook here for full contents display.
        safe_call("stash_response", function()
            if string.len(pkt) >= offset + 5 - 1 then
                local stash_id, ppos = read_uint32_le(pkt, offset)
                local status, _ = read_uint8(pkt, ppos)
                if status ~= 0 and db.actor then
                    db.actor:give_game_news("Zone", "Stash unavailable.", "ui_inGame2_PDA_icon", 0, 3000, 0)
                end
            else
                log_dispatch_once("short_0041", "Zone: dropped short STASH_RESPONSE packet (%d bytes)", string.len(pkt))
            end
        end)
    elseif opcode == 0x0020 then
        if zone_safezone and zone_safezone.on_safezone_state then
            safe_call("safezone", zone_safezone.on_safezone_state, pkt, offset)
        end
    elseif opcode == 0x0030 then
        if zone_worldevent and zone_worldevent.on_world_event then
            safe_call("world_event", zone_worldevent.on_world_event, pkt, offset)
        end
    elseif opcode == 0x0050 then
        -- 4+4+4+1 = 13 bytes; bounds-check before parsing (malicious server safe)
        safe_call("damage_notify", function()
            if string.len(pkt) < offset + 13 - 1 then
                log_dispatch_once("short_0050", "Zone: dropped short DAMAGE_NOTIFY packet (%d bytes)", string.len(pkt))
                return
            end
            local target_id, ppos = read_uint32_le(pkt, offset)
            local attacker_id, ppos = read_uint32_le(pkt, ppos)
            local damage, ppos = read_float_le(pkt, ppos)
            local bone_id, ppos = read_uint8(pkt, ppos)
            if zone_dummy and zone_dummy.on_damage_notify then
                safe_call("damage_notify_dummy", zone_dummy.on_damage_notify, target_id, attacker_id, damage, bone_id)
            end
        end)
    elseif opcode == 0x0060 then
        -- L-03: Chat text: sender ID (4 bytes) + text length (1 byte) + text
        -- Clamp text_len to actual payload to prevent overread on forged packets.
        safe_call("chat_text", function()
            if string.len(pkt) < offset + 5 - 1 then
                log_dispatch_once("short_0060", "Zone: dropped short CHAT_TEXT packet (%d bytes)", string.len(pkt))
                return
            end
            local sender_id, cpos = read_uint32_le(pkt, offset)
            local text_len, cpos = read_uint8(pkt, cpos)
            local avail = string.len(pkt) - cpos + 1
            if text_len > avail then text_len = avail end
            if text_len < 0 then text_len = 0 end
            local txt, _ = read_string(pkt, cpos, text_len)
            if db.actor and txt and txt ~= "" then
                db.actor:give_game_news("ZoneNetwork", txt, "ui_inGame2_PDA_icon", 0, 5000, 0)
            end
            -- Chat history overlay (zone_hud) parses the same payload.
            if zone_hud and zone_hud.on_chat_message then
                safe_call("chat_hud", zone_hud.on_chat_message, pkt, offset)
            end
        end)
    elseif opcode == 0x0070 then
        if zone_ai_proxy and zone_ai_proxy.on_ai_action then
            safe_call("ai_action", zone_ai_proxy.on_ai_action, pkt, offset)
        end
    elseif opcode == 0x0071 then
        safe_call("show_start", function()
            if type(handle_show_start) == "function" then handle_show_start(pkt, offset) end
        end)
    elseif opcode == 0x0072 then
        close_faction_ui()
    elseif opcode == 0x0073 then
        safe_call("load_level", function()
            if type(on_load_level) == "function" then on_load_level(pkt, offset) end
        end)
    elseif opcode == 0x0076 then
        safe_call("inventory_sync", function()
            if type(on_inventory_sync) == "function" then on_inventory_sync(pkt, offset) end
        end)
    elseif opcode == 0x0077 then
        safe_call("server_error", function()
            if type(on_server_error) == "function" then on_server_error(pkt, offset) end
        end)
    elseif opcode == 0x0078 then
        -- OpGroupInviteNotify (S->C): inviterSessionID u32, name[32], faction[16].
        if zone_hud and zone_hud.on_group_invite then
            safe_call("group_invite", zone_hud.on_group_invite, pkt, offset)
        end
    elseif opcode == 0x007A then
        -- OpGroupState (S->C): memberCount u8, then per member sessionID u32,
        -- name[32], faction[16], isLeader u8. 0x0079 (OpGroupResponse) is
        -- client->server only, sent as chat text (/accept, /decline).
        if zone_hud and zone_hud.on_group_state then
            safe_call("group_state", zone_hud.on_group_state, pkt, offset)
        end
    elseif opcode == 0x007B then
        -- OpPositionCorrection (S->C unreliable, 12 B): x f32, y f32, z f32.
        safe_call("position_correction", function()
            if string.len(pkt) < offset + 12 - 1 then
                log_dispatch_once("short_007B", "Zone: dropped short POSITION_CORRECTION packet (%d bytes)", string.len(pkt))
                return
            end
            local x, p2 = read_float_le(pkt, offset)
            local y, p3 = read_float_le(pkt, p2)
            local z, _ = read_float_le(pkt, p3)
            if zone_dummy and zone_dummy.on_position_correction then
                safe_call("position_correction_dummy", zone_dummy.on_position_correction, x, y, z)
            end
        end)
    elseif opcode == 0x007E then
        -- OpItemUpdate (S->C reliable, 89 B). Prefer an external zone_item
        -- module when present; otherwise the ledger section in this file.
        safe_call("item_update", function()
            local mod = _G.zone_item
            if mod and type(mod.on_item_update) == "function" then
                mod.on_item_update(pkt, offset)
            else
                on_item_update(pkt, offset)
            end
        end)
    else
        log_dispatch_once(string.format("unknown_%04X", opcode),
            "Zone: unknown opcode 0x%04X ignored (%d payload bytes)", opcode, paylen)
    end
end

-- Level / visual replication helpers (OpLevelChange 0x0074, OpPlayerVisual 0x0075)
local function current_level_name()
    local lvl = nil
    pcall(function()
        if level and level.name then lvl = level.name() end
    end)
    if type(lvl) == "string" and lvl ~= "" then return lvl end
    return nil
end

local function current_player_visual()
    local visual = nil
    pcall(function()
        if db and db.actor and db.actor.get_visual_name then
            visual = db.actor:get_visual_name()
        end
    end)
    if type(visual) ~= "string" or visual == "" then
        -- Fallback: outfit slot (7) section's "visual" key via system_ini.
        pcall(function()
            if not (db and db.actor) then return end
            local outfit = db.actor:item_in_slot(7)
            if not outfit then return end
            local sec = outfit:section()
            if type(sec) ~= "string" or sec == "" then return end
            local ini = system_ini and system_ini()
            if not ini then return end
            local v = ini:r_string(sec, "visual")
            if type(v) == "string" and v ~= "" then visual = v end
        end)
    end
    if type(visual) ~= "string" or visual == "" then
        visual = DEFAULT_VISUAL
    end
    return visual
end

local function send_level_change(force)
    local lvl = current_level_name()
    if not lvl then return end
    if not force and lvl == last_level_sent then return end
    last_level_sent = lvl
    ZoneNet:SendLevelChange(lvl)
end

local function send_player_visual(force)
    local visual = current_player_visual()
    if not force and visual == last_visual_sent then return end
    last_visual_sent = visual
    ZoneNet:SendPlayerVisual(visual)
end

-- ---------------------------------------------------------------------------
-- Join / spawn flow (OpLoadLevel 0x0073, OpInventorySync 0x0076, OpError 0x0077)
-- ---------------------------------------------------------------------------

local function in_game()
    local present = false
    pcall(function() present = (level ~= nil and level.present() == true) end)
    return present
end

-- Main-menu-safe packet pump. actor_on_update only fires in-game, but the
-- pre-game join packets (handshake status, SHOW_START 0x0071, LOAD_LEVEL
-- 0x0073, ERROR 0x0077, SAFEZONE_STATE 0x0020) arrive while the player is
-- still in the main menu. Drains only that subset. Once LOAD_LEVEL has
-- requested the level start it stops consuming, so packets that belong to the
-- in-game pump (e.g. INVENTORY_SYNC 0x0076) stay in the native event ring
-- across the Lua VM restart. Re-entrancy safe and pcall-wrapped.
local MENU_PUMP_OPCODES = {
    [0x0002] = true,
    [0x0071] = true,
    [0x0073] = true,
    [0x0077] = true,
    [0x0020] = true,
}
local menu_pumping = false

function pump_menu()
    if menu_pumping or level_start_issued then return end
    menu_pumping = true
    pcall(function()
        if in_game() then return end
        while true do
            local pkt = nil
            local ok_poll = pcall(function() pkt = ZoneNet:PollEvent() end)
            if not ok_poll or not pkt then break end
            local opcode = nil
            if string.len(pkt) >= 12 then
                opcode = read_uint16_le(pkt, 9)
            end
            if opcode and MENU_PUMP_OPCODES[opcode] then
                pcall(dispatch_packet, pkt)
            elseif opcode then
                -- Consumed but intentionally not handled in the menu: log once.
                log_dispatch_once(string.format("menu_skip_%04X", opcode),
                    "Zone: menu pump ignored opcode 0x%04X", opcode)
            else
                log_dispatch_once("short_header", "Zone: menu pump dropped short packet (%d bytes)", string.len(pkt))
            end
            if level_start_issued then break end
        end
    end)
    menu_pumping = false
end

local function apply_faction(faction)
    if not (db and db.actor) then return false end
    faction = tostring(faction or "")
    if faction == "" then return false end
    local comm = faction
    if string.sub(comm, 1, 6) ~= "actor_" then comm = "actor_" .. comm end
    local ok = pcall(function() db.actor:set_character_community(comm, 0, 0) end)
    if not ok then
        printf("Zone: failed to apply faction %s", tostring(faction))
    end
    return ok
end

local function apply_spawn_position(x, y, z)
    if not (db and db.actor) then return false end
    local ok = pcall(function() db.actor:set_actor_position(vector():set(x, y, z), false, false) end)
    if not ok then
        ok = pcall(function() db.actor:set_npc_position(vector():set(x, y, z)) end)
    end
    if not ok then
        printf("Zone: failed to apply spawn position")
    end
    return ok
end

local function console_exec(cmd)
    local ok = false
    pcall(function()
        if get_console then
            get_console():execute(cmd)
            ok = true
        end
    end)
    if not ok then
        pcall(function()
            if type(_G.exec_console_cmd) == "function" then
                _G.exec_console_cmd(cmd)
                ok = true
            end
        end)
    end
    return ok
end

-- A new game can only be created from the main menu: the engine's KERNEL:start
-- handler asserts no level is loaded. Console "start" runs Anomaly's own
-- new-game flow from all.spawn; the spawn registry picks the start level
-- (l01_escape), so this is the stock path with no xrRazom dependency.
local function start_singleplayer_game()
    return console_exec("start server(all/single/alife/new) client(localhost)")
end

local function level_name_from_id(level_id)
    -- Server level ids: 0 = l01_escape (only hosted world).
    if tonumber(level_id) == 0 then return "l01_escape" end
    return "l01_escape"
end

-- Pending-join marker: survives the Lua VM restart caused by a level load.
local function join_marker_path()
    local path = nil
    pcall(function()
        local fs = getFS and getFS()
        if fs and fs.update_path then
            path = fs:update_path("$app_data_root$", JOIN_MARKER)
        end
    end)
    return path
end

local function save_pending_join(sp)
    local path = join_marker_path()
    if not path then return false end
    local ok = pcall(function()
        local f = io.open(path, "w")
        if not f then return end
        f:write(string.format("level = %s\n", tostring(sp.level or "")))
        f:write(string.format("x = %.4f\n", tonumber(sp.x) or 0))
        f:write(string.format("y = %.4f\n", tonumber(sp.y) or 0))
        f:write(string.format("z = %.4f\n", tonumber(sp.z) or 0))
        f:write(string.format("faction = %s\n", tostring(sp.faction or "")))
        f:close()
    end)
    return ok
end

clear_pending_join = function()
    local path = join_marker_path()
    if not path then return end
    pcall(function()
        local f = io.open(path, "w")
        if f then
            f:write("")
            f:close()
        end
    end)
end

local function load_pending_join()
    local path = join_marker_path()
    if not path then return nil end
    local sp = nil
    pcall(function()
        local f = io.open(path, "r")
        if not f then return end
        local t = { level = "", faction = "", x = 0, y = 0, z = 0 }
        for line in f:lines() do
            local k, v = string.match(line, "^%s*(%w+)%s*=%s*(.-)%s*$")
            if k and v then t[k] = v end
        end
        f:close()
        if t.level ~= "" or t.faction ~= "" then sp = t end
    end)
    if not sp then return nil end
    sp.x = tonumber(sp.x) or 0
    sp.y = tonumber(sp.y) or 0
    sp.z = tonumber(sp.z) or 0
    return sp
end

local function create_inventory_entry(entry)
    local actor = db and db.actor
    if not actor then return false end
    local section = entry.section
    if type(section) ~= "string" or section == "" then return false end
    if ini_sys and ini_sys.section_exist and not ini_sys:section_exist(section) then
        printf("Zone: inventory sync: unknown section %s", tostring(section))
        return false
    end

    local copies = math.floor(tonumber(entry.count) or 1)
    if copies < 1 then copies = 1 end
    if copies > 100 then copies = 100 end

    local pos  = actor:position()
    local lvid = actor:level_vertex_id()
    local gvid = actor:game_vertex_id()
    local actor_id = actor:id()
    local created = 0

    for _ = 1, copies do
        local se = nil
        pcall(function() se = alife():create(section, pos, lvid, gvid, actor_id) end)
        if not se then
            -- Some classes (e.g. ammo) can fail with an online parent; create
            -- unparented, then move the spawned object into the actor.
            pcall(function() se = alife():create(section, pos, lvid, gvid) end)
            if se then
                local sid = nil
                pcall(function() sid = (type(se.id) == "function") and se:id() or se.id end)
                if sid then
                    local obj = nil
                    pcall(function() obj = level.object_by_id(sid) end)
                    if obj then pcall(function() actor:transfer_item(obj, actor) end) end
                end
            end
        end
        if se then
            created = created + 1
            local sid = nil
            pcall(function() sid = (type(se.id) == "function") and se:id() or se.id end)
            local obj = nil
            if sid then pcall(function() obj = level.object_by_id(sid) end) end
            if obj then
                local cond = tonumber(entry.condition)
                if cond and cond >= 0 and cond <= 100 then
                    pcall(function() obj:set_condition(cond / 100) end)
                end
                local ammo = tonumber(entry.ammo)
                if ammo and ammo > 0 then
                    pcall(function() obj:set_ammo_elapsed(math.floor(ammo)) end)
                end
                local slot = tonumber(entry.slot)
                if slot then
                    slot = math.floor(slot)
                    if slot >= 0 and slot <= 15 then
                        pcall(function() actor:move_to_slot(obj, slot, true) end)
                    end
                end
            end
        end
    end

    if created == 0 then
        printf("Zone: inventory sync: failed to create %s", tostring(section))
        return false
    end
    return true
end

local function inventory_fingerprint(entries)
    local parts = {}
    for _, it in ipairs(entries) do
        parts[#parts + 1] = string.format("%s:%d:%d:%d",
            tostring(it.section), tonumber(it.count) or 1,
            tonumber(it.condition) or 0, tonumber(it.ammo) or 0)
    end
    return table.concat(parts, "|")
end

local function drain_inventory_queue()
    if not in_game() then return end
    if #pending_inventory == 0 then return end

    local queue = pending_inventory
    pending_inventory = {}
    local fingerprint = inventory_fingerprint(queue)

    -- Same kit already delivered to this Lua session (reconnect without a
    -- level reload): the actor still owns it, do not spawn a second copy.
    if fingerprint == last_applied_inventory_fingerprint then
        printf("Zone: inventory sync already applied, skipping (%d entries)", #queue)
        return
    end

    local applied = 0
    for _, entry in ipairs(queue) do
        if create_inventory_entry(entry) then applied = applied + 1 end
    end
    if applied > 0 then
        last_applied_inventory_fingerprint = fingerprint
    end
    printf("Zone: inventory sync applied (%d/%d entries)", applied, #queue)
    local failed = #queue - applied
    if failed > 0 then
        local tmpl = tr("ui_zone_inv_sync_incomplete",
            "Inventory sync incomplete: %d of %d items failed")
        local msg = string.format(tmpl, failed, #queue)
        surface_message(msg)
    end
end

local function apply_pending_spawn()
    if not pending_spawn then return end
    if not in_game() then return end
    local sp = pending_spawn
    pending_spawn = nil
    apply_faction(sp.faction)
    apply_spawn_position(sp.x, sp.y, sp.z)
    apply_inventory_pending = true
end

-- Applied on the first actor update after a menu-initiated level start.
-- The marker is cleared only when the join was actually applied; otherwise it
-- survives for a retry or is disarmed by reset_state on disconnect.
local function apply_join_after_load()
    local sp = load_pending_join()
    if sp then
        local faction_ok = apply_faction(sp.faction)
        local position_ok = apply_spawn_position(sp.x, sp.y, sp.z)
        if faction_ok or position_ok then
            clear_pending_join()
        else
            printf("Zone: pending join not applied; marker kept until disconnect")
        end
    end
    if in_game() then
        apply_inventory_pending = true
    end
end

on_load_level = function(pkt, offset)
    -- LevelLoad payload (30 bytes): level u8, x/y/z f32, faction[16], eco u8.
    local len = string.len(pkt)
    if len < offset + 30 - 1 then
        log_dispatch_once("short_0073", "Zone: dropped short LOAD_LEVEL packet (%d bytes)", len)
        return
    end

    local level_id, pos = read_uint8(pkt, offset)
    local x, pos = read_float_le(pkt, pos)
    local y, pos = read_float_le(pkt, pos)
    local z, pos = read_float_le(pkt, pos)
    local faction, pos = read_string(pkt, pos, 16)
    faction = clean_cstring(faction)
    local eco, _ = read_uint8(pkt, pos)

    local target_level = level_name_from_id(level_id)
    local sp = { level = target_level, x = x, y = y, z = z, faction = faction, eco = eco }

    if in_game() then
        local cur = current_level_name()
        if not cur or cur == target_level then
            pending_spawn = sp
            apply_pending_spawn()
            apply_inventory_pending = true
        else
            -- No engine API loads an arbitrary level by name while a level is
            -- loaded (KERNEL:start asserts no level; ChangeLevel needs graph
            -- vertex ids). Surface it instead of silently doing nothing.
            printf("Zone: server wants level %s but %s is loaded; reconnect from the main menu",
                tostring(target_level), tostring(cur))
            surface_message(tr("ui_zone_level_change_unsupported",
                "Server level change is not supported in-game. Reconnect from the main menu."))
        end
        return
    end

    -- Main menu: persist the target (the reload wipes this Lua VM), then start.
    pending_spawn = sp
    save_pending_join(sp)
    if not level_start_issued then
        level_start_issued = true
        if start_singleplayer_game() then
            printf("Zone: starting game for level %s", tostring(target_level))
        else
            printf("Zone: failed to start game (console start unavailable)")
            surface_message(tr("ui_zone_join_start_failed",
                "Could not start the game for the server level"))
            level_start_issued = false
            -- No VM restart is coming, so the marker would only be a stale
            -- time bomb for a manual new game: disarm it.
            pending_spawn = nil
            clear_pending_join()
        end
    end
end

on_inventory_sync = function(pkt, offset)
    local len = string.len(pkt)
    if len < offset then
        log_dispatch_once("short_0076", "Zone: dropped short INVENTORY_SYNC packet (%d bytes)", len)
        return
    end
    local item_count, pos = read_uint8(pkt, offset)
    if not item_count or item_count == 0 then return end

    local entries = {}
    for _ = 1, item_count do
        if pos + 69 > len then
            printf("Zone: inventory sync packet truncated")
            if not inv_parse_notified then
                inv_parse_notified = true
                surface_message(tr("ui_zone_inv_sync_malformed",
                    "Inventory sync data was malformed; some items may be missing"))
            end
            return
        end
        local section, p2 = read_string(pkt, pos, 64); pos = p2
        section = clean_cstring(section)
        local count, p3 = read_uint16_le(pkt, pos); pos = p3
        local condition, p4 = read_uint8(pkt, pos); pos = p4
        local ammo, p5 = read_uint16_le(pkt, pos); pos = p5
        local slot_raw, p6 = read_uint8(pkt, pos); pos = p6
        local slot = slot_raw
        if slot_raw > 127 then slot = slot_raw - 256 end
        entries[#entries + 1] = {
            section = section, count = count,
            condition = condition, ammo = ammo, slot = slot,
        }
    end
    if #entries == 0 then return end

    -- Server retry defense: never queue a kit whose fingerprint was already
    -- applied. Without this, a double send would spawn the items twice when
    -- both batches land in pending_inventory before the next drain.
    if inventory_fingerprint(entries) == last_applied_inventory_fingerprint then
        printf("Zone: inventory sync already applied, dropping duplicate batch (%d entries)", #entries)
        return
    end

    for _, entry in ipairs(entries) do
        pending_inventory[#pending_inventory + 1] = entry
    end
    if in_game() then
        apply_inventory_pending = true
    end
end

on_server_error = function(pkt, offset)
    local len = string.len(pkt)
    if len < offset then
        log_dispatch_once("short_0077", "Zone: dropped short ERROR packet (%d bytes)", len)
        return
    end
    local code, pos = read_uint8(pkt, offset)
    local msg = ""
    if len >= pos + 96 - 1 then
        msg, pos = read_string(pkt, pos, 96)
        msg = clean_cstring(msg)
    end

    -- Server message wins (it carries the specific rejection); fall back to a
    -- localized string for known codes when the payload message is empty.
    if msg == "" then
        local key = "ui_zone_error_generic"
        if code == 1 then key = "ui_zone_error_faction"
        elseif code == 2 then key = "ui_zone_error_loadout"
        elseif code == 3 then key = "ui_zone_error_create" end
        msg = tr(key, string.format("Server rejected the character (code %d).", tonumber(code) or 0))
    end

    printf("Zone: server error: %s", tostring(msg))
    surface_message(msg)

    local dlg = peer_faction_dialog()
    if dlg and dlg.OnServerError then
        pcall(function() dlg:OnServerError(msg) end)
    end
end

handle_show_start = function(pkt, offset)
    -- Single owner of OpShowStart handling lives in zone_main.
    local owned = false
    pcall(function()
        if zone_main and type(zone_main.on_show_start) == "function" then
            owned = true
            zone_main.on_show_start(pkt, offset)
        end
    end)
    if not owned then
        pcall(function()
            if _G.open_peer_faction then _G.open_peer_faction(nil) end
        end)
    end
end

local function on_actor_first_update()
    pcall(send_level_change, true)
    pcall(send_player_visual, true)
    pcall(apply_join_after_load)
end

local function on_level_changing()
    -- If level.name() already reports the new level, send now; otherwise the
    -- on_tick comparison and actor_on_first_update send it after the load.
    pcall(send_level_change, false)
    last_level_sent = nil
    last_visual_sent = nil
    last_visual_check = 0
    -- Level change destroys every online world item; tracking becomes stale.
    pending_item_actions = {}
    spawned_world_items = {}
end

local function on_actor_net_destroy()
    last_level_sent = nil
    last_visual_sent = nil
    last_visual_check = 0
end

function register_level_callbacks()
    if zone_callbacks_registered then return end
    zone_callbacks_registered = true
    pcall(function()
        if RegisterScriptCallback then
            RegisterScriptCallback("actor_on_first_update", on_actor_first_update)
            RegisterScriptCallback("on_level_changing", on_level_changing)
            RegisterScriptCallback("actor_on_net_destroy", on_actor_net_destroy)
            -- Verified base callbacks: declared in axr_main.script:66/69 and
            -- dispatched by bind_stalker_ext.script:142/156.
            RegisterScriptCallback("actor_on_item_take", on_actor_item_take)
            RegisterScriptCallback("actor_on_item_drop", on_actor_item_drop)
        end
    end)
    pcall(send_level_change, true)
    pcall(send_player_visual, true)
end

function on_game_start()
    register_level_callbacks()
end

-- xrRazom guard: when co-op is live, Zone stays dormant so the two proxy
-- systems (XrrPlayers dummies vs zone_dummy proxies) never fight over alife.
local function xrr_session_active()
    local active = false
    pcall(function()
        if _G.XrrIsConnected and _G.XrrIsConnected() then active = true end
        if _G.XrrIsHosted and _G.XrrIsHosted() then active = true end
    end)
    return active
end

function on_tick()
    local tg = time_global()

    -- Let dummy system interpolate every frame (pcall: never fatal)
    if zone_dummy and zone_dummy.interpolate_proxies then
        pcall(zone_dummy.interpolate_proxies)
    end

    if last_tick == 0 then
        -- Init on first frame to avoid a giant dt velocity spike.
        last_tick = tg
        return
    end
    if tg - last_tick < TICK_RATE_MS then
        return
    end
    last_tick = tg

    if not ZoneNet or not ZoneNet.IsConnected or not ZoneNet:IsConnected() then
        faction_ui_opened = false
        pcall(close_faction_ui)
        if was_connected then
            was_connected = false
            -- Server-side drop (no explicit Disconnect call): release local
            -- safezone enforcement so weapons/input are never left locked.
            pcall(function()
                if zone_safezone and zone_safezone.reset then zone_safezone.reset() end
            end)
            -- Surface the drop reason captured by the DLL (kick, liveness
            -- timeout, ...). Never leave a silent disconnect.
            local raw = (ZoneNet and ZoneNet.GetLastError and ZoneNet:GetLastError()) or ""
            local reason = localize_net_error(raw)
                or tr("ui_zone_drop_generic", "Connection to the server was lost")
            surface_message(tr("ui_zone_drop_prefix", "Disconnected") .. ": " .. reason)
        end
        return
    end
    was_connected = true
    if last_preserved_error ~= "" then last_preserved_error = "" end

    -- Mutual exclusion with xrRazom: do not send Zone telemetry or consume
    -- Zone snapshots while co-op owns the world. On the transition tick,
    -- release Zone-side enforcement/proxies once so no sticky safezone
    -- holstering or ghost puppets leak into the co-op session.
    if xrr_session_active() then
        if not xrr_was_active then
            xrr_was_active = true
            pcall(function()
                if zone_safezone and zone_safezone.reset then zone_safezone.reset() end
            end)
            pcall(function()
                if zone_dummy and zone_dummy.on_level_changing then zone_dummy.on_level_changing() end
            end)
            pcall(function()
                if zone_ai_proxy and zone_ai_proxy.release_puppets then zone_ai_proxy.release_puppets() end
            end)
        end
        return
    end
    xrr_was_active = false
    pcall(function()
        local pending = false
        local has = false
        if ZoneNet.IsPendingCreate then pending = ZoneNet:IsPendingCreate() and true or false end
        if ZoneNet.HasCharacter then has = ZoneNet:HasCharacter() and true or false end
        if has then
            if faction_ui ~= nil then
                local sx, sy, sz = ZoneNet:GetSpawn()
                if sx and db.actor then
                    pcall(function() db.actor:set_npc_position(vector():set(sx, sy, sz)) end)
                end
            end
            close_faction_ui()
        elseif pending then
            open_faction_ui_once()
        end
    end)

    -- Deliver queued starter/restored inventory once the actor exists; deferred
    -- to the tick after the spawn so physics and the inventory owner are ready.
    if apply_inventory_pending and in_game() and db and db.actor then
        apply_inventory_pending = false
        pcall(drain_inventory_queue)
    end

    if db.actor then
        pcall(function()
            local pos = db.actor:position()
            local dir = db.actor:direction()

            local yaw = math.atan2(dir.x, dir.z)
            local dir_y_clamped = math.max(-1.0, math.min(1.0, dir.y))
            local pitch = math.asin(dir_y_clamped)

            -- L-04: Moving state bitmask detection (mcCrouch = 0x10, mcSprint = 0x1000)
            local animflags = 0
            local mstate = (level.actor_moving_state and level.actor_moving_state()) or 0
            if bit.band(mstate, 16) ~= 0 then animflags = bit.bor(animflags, 1) end -- Crouch (mcCrouch = 0x10)
            if bit.band(mstate, 4096) ~= 0 then animflags = bit.bor(animflags, 2) end -- Sprint (mcSprint = 0x1000)
            -- Basic aiming detection removed due to db.actor:is_zoom_aiming_mode() CTD

            local gvid = 0
            pcall(function() gvid = db.actor:game_vertex_id() or 0 end)
            if gvid < 0 or gvid > 65535 then gvid = 0 end

            -- Send yaw * 100 and pitch * 100 matching server decoding float32(ct.Yaw)/100.0
            ZoneNet:SendTransform(pos.x, pos.y, pos.z,
                math.floor(yaw * 100 + 0.5), math.floor(pitch * 100 + 0.5),
                animflags, gvid)
        end)
    end

    -- Level + visual replication: level on change, visual at 1 Hz or on change.
    pcall(send_level_change, false)
    if tg - last_visual_check >= VISUAL_CHECK_MS then
        last_visual_check = tg
        pcall(send_player_visual, false)
    end

    -- Poll all pending events (each dispatch isolated; one bad packet can't kill tick)
    while true do
        local pkt = nil
        local ok_poll = pcall(function() pkt = ZoneNet:PollEvent() end)
        if not ok_poll or not pkt then break end
        pcall(dispatch_packet, pkt)
    end
end

