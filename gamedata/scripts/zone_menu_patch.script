module("zone_menu_patch", package.seeall)

-- zone_menu_patch.script
-- Handles the behavior of the "Zone" button injected by modxml_zone_main_menu.script.

-- ============================================================
-- on_main_menu_init callback
-- ============================================================
-- Called by dxml via modxml_zone_main_menu's registration of main_menu_on_init
function on_main_menu_init(menu)
    if not menu then return end

    menu:AddCallback(
        "btn_zone_online",
        ui_events.BUTTON_CLICKED,
        function()
            if zone_ui_server_list and zone_ui_server_list.open_server_browser then
                zone_ui_server_list.open_server_browser()
            else
                printf("Zone: zone_ui_server_list module not loaded!")
            end
        end,
        menu
    )
end

-- ============================================================
-- on_main_menu_quit fallback callback
-- ============================================================
local function on_main_menu_quit(menu_obj)
    -- Just for cleanup if needed in the future
end

-- ============================================================
-- on_game_start — Anomaly script entrypoint
-- ============================================================
function on_game_start()
    -- Register any global cleanup callbacks for the main menu
    if RegisterScriptCallback then
        RegisterScriptCallback("main_menu_on_quit", on_main_menu_quit)
    end
end
