-- zone_menu_patch.script
-- Handles the behavior of the "Zone" button injected by modxml_zone_main_menu.script.

local mm_class = nil
local function install_methods()
    if mm_class then return end
    local cls = ui_main_menu.main_menu
    mm_class = cls
    cls.OnButton_zone_online_clicked = function(self)
        if self.zone_server_browser_dlg == nil then
            if zone_ui_server_list and zone_ui_server_list.UIZoneServerList then
                self.zone_server_browser_dlg = zone_ui_server_list.UIZoneServerList(self)
                self.zone_server_browser_dlg:InitControls()
                self.zone_server_browser_dlg:InitCallBacks()
            end
        else
            self.zone_server_browser_dlg:LoadFavorites()
        end
        if self.zone_server_browser_dlg then
            self.zone_server_browser_dlg:ShowDialog(true)
            self.zone_server_browser_dlg:Show(true)
            self:HideDialog()
            self:Show(false)
        end
    end
end

function on_main_menu_init(menu)
    if not menu then return end
    install_methods()
    menu:AddCallback("btn_zone_online", ui_events.BUTTON_CLICKED, mm_class.OnButton_zone_online_clicked, menu)
end

function on_game_start()
    -- Optional global callbacks
end
