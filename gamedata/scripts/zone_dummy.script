-- zone_dummy.script
-- Proxy stalker system with Hermite Spline Interpolation

local spawned_proxies = {}
local peer_factions = {}
local peer_names = {}
-- ENTITY_ENTER_AOI may arrive before the level/graph exists. Wire data is kept
-- here (keyed by entity id) until a snapshot tick can spawn with valid data.
local pending_peers = {}
local MAX_HISTORY = 8
local JITTER_BUFFER_MS = 100
local DEFAULT_PROXY_VISUAL = "actors\\stalker_neutral\\stalker_neutral_1"
local PROXY_SECTION = "zone_proxy_stalker"
local FALLBACK_PROXY_SECTION = "sim_default_stalker_0"
local INVALID_LEVEL_VERTEX = 0xFFFFFFFE
local PENDING_PEER_CAP = 32
local PENDING_PEER_TTL_MS = 120000
local pending_prune_logged = false

-- Ring buffer helper functions (L-30: avoid table.remove(tbl, 1) in hot path)
local function add_history_sample(proxy, sample)
    if proxy.hist_count < MAX_HISTORY then
        proxy.hist_count = proxy.hist_count + 1
        local idx = ((proxy.hist_head + proxy.hist_count - 2) % MAX_HISTORY) + 1
        proxy.pos_history[idx] = sample
    else
        -- Ring buffer full: overwrite oldest sample at hist_head and advance
        proxy.pos_history[proxy.hist_head] = sample
        proxy.hist_head = (proxy.hist_head % MAX_HISTORY) + 1
    end
end

local function get_history_sample(proxy, i)
    if i < 1 or i > proxy.hist_count then return nil end
    local idx = ((proxy.hist_head + i - 2) % MAX_HISTORY) + 1
    return proxy.pos_history[idx]
end

local function get_latest_sample(proxy)
    if proxy.hist_count == 0 then return nil end
    return get_history_sample(proxy, proxy.hist_count)
end

-- Resolve entity by ID (attacker lookup: db.actor, remote proxy, or level entity) (L-18)
local function resolve_entity(id)
    if not id then return nil end
    -- Never touch xrRazom co-op dummies (guarded; absent when co-op not installed).
    local ok_dummy, is_dummy = pcall(function()
        return XrrPlayers and XrrPlayers():IsPlayerDummy(id)
    end)
    if ok_dummy and is_dummy then return nil end
    if db.actor and (id == db.actor:id()) then
        return db.actor
    end
    local proxy = spawned_proxies[id]
    if proxy then
        local gid = proxy.game_id or proxy.se_id
        if gid and level and level.object_by_id then
            local obj = level.object_by_id(gid)
            if obj then return obj end
        end
    end
    if level and level.object_by_id then
        local obj = level.object_by_id(id)
        if obj then return obj end
    end
    return nil
end

-- Spawn section: [zone_proxy_stalker] is DLTX-merged into system.ltx from
-- mod_system_zone_online.ltx and inherits sim_default_stalker_0.
local function resolve_spawn_section()
    if ini_sys and ini_sys.section_exist then
        if ini_sys:section_exist(PROXY_SECTION) then return PROXY_SECTION end
        if ini_sys:section_exist(FALLBACK_PROXY_SECTION) then return FALLBACK_PROXY_SECTION end
    end
    return nil
end

-- Server ENTITY_ENTER never carries a visual for AI puppets; player peers do.
-- Applied only once the object is online (create is queued, not instant).
local function try_apply_visual(proxy, obj)
    if proxy.visual_applied then return end
    local visual = proxy.visual
    if not visual or visual == "" then
        visual = DEFAULT_PROXY_VISUAL
    end
    local current = nil
    pcall(function() current = obj:visual() end)
    if current and current ~= "" and current == visual then
        proxy.visual_applied = true
        return
    end
    local ok = pcall(function() obj:set_visual_name(visual, true) end)
    if ok then
        proxy.visual_applied = true
    end
end

-- Hold ENTITY_ENTER wire data until the level graph is available.
local function store_pending_peer(eid, x, y, z, faction, visual, health, gvid, name)
    if pending_peers[eid] then
        local entry = pending_peers[eid]
        entry.x, entry.y, entry.z = x, y, z
        entry.faction, entry.visual = faction, visual
        entry.health, entry.gvid = health, gvid
        entry.name = name
    else
        local n = 0
        for _ in pairs(pending_peers) do n = n + 1 end
        if n >= PENDING_PEER_CAP then
            local oldest_eid, oldest_t = nil, nil
            for id, entry in pairs(pending_peers) do
                if oldest_t == nil or entry.t < oldest_t then
                    oldest_eid, oldest_t = id, entry.t
                end
            end
            if oldest_eid then
                pending_peers[oldest_eid] = nil
            end
        end
        pending_peers[eid] = {
            x = x, y = y, z = z,
            faction = faction, visual = visual,
            health = health, gvid = gvid, name = name,
            t = time_global()
        }
    end
    if faction and faction ~= "" then
        peer_factions[eid] = faction
    end
    if name and name ~= "" then
        peer_names[eid] = name
    end
end

local function prune_pending_peers(tg)
    local removed = 0
    for eid, entry in pairs(pending_peers) do
        if entry.t and (tg - entry.t) > PENDING_PEER_TTL_MS then
            pending_peers[eid] = nil
            removed = removed + 1
        end
    end
    if removed > 0 and not pending_prune_logged then
        pending_prune_logged = true
        printf("[zone_dummy] pruned %d expired pending peer(s)", removed)
    end
end

local function try_spawn_pending(eid)
    local pending = pending_peers[eid]
    if not pending then return false end
    if spawned_proxies[eid] then
        pending_peers[eid] = nil
        return true
    end
    -- Never spawn before the level graph exists (vertex_id needs it).
    if not (level and level.vertex_id) then return false end
    local pos = nil
    pcall(function() pos = vector():set(pending.x, pending.y, pending.z) end)
    if not pos then return false end
    if spawn_proxy(eid, pos, pending.faction, pending.visual, pending.gvid) then
        pending_peers[eid] = nil
        return true
    end
    return false
end

-- Spawn from validated ENTITY_ENTER_AOI v2 data only: real visual + packet
-- gvid. No actor lvid/gvid fallback (that spawned peers at the wrong graph
-- vertex). Returns true when the alife object was queued for spawn.
function spawn_proxy(session_id, pos, faction, visual, gvid)
    if spawned_proxies[session_id] then return false end
    if not pos then return false end

    -- Never spawn while xrRazom owns the world (dual proxy systems conflict).
    local xrr_active = false
    pcall(function()
        if _G.XrrIsConnected and _G.XrrIsConnected() then xrr_active = true end
        if _G.XrrIsHosted and _G.XrrIsHosted() then xrr_active = true end
    end)
    if xrr_active then return false end

    -- Game vertex is packet-authoritative; 0 means the server had none.
    if not gvid or gvid == 0 then return false end

    -- Level vertex queried at the ENTITY position, never at the local actor.
    -- level.vertex_id returns u32(-1) off-graph; never feed that to create.
    local lvid = nil
    pcall(function()
        if level and level.vertex_id then
            lvid = level.vertex_id(pos)
        end
    end)
    if lvid == nil or lvid >= INVALID_LEVEL_VERTEX then return false end

    local section = resolve_spawn_section()
    if not section then return false end

    local sim = nil
    pcall(function() sim = alife() end)
    if not sim then return false end

    local se_obj = nil
    pcall(function() se_obj = sim:create(section, pos, lvid, gvid) end)
    if not se_obj then return false end

    local resolved_faction = (faction and faction ~= "") and faction or (peer_factions[session_id] or "stalker")
    peer_factions[session_id] = resolved_faction

    spawned_proxies[session_id] = {
        se_id = se_obj.id,
        game_id = nil,
        pos_history = {},
        hist_head = 1,
        hist_count = 0,
        faction = resolved_faction,
        name = peer_names[session_id] or "",
        visual = (visual and visual ~= "") and visual or DEFAULT_PROXY_VISUAL,
        visual_applied = false,
        last_attacker_id = nil,
        last_update = time_global()
    }
    -- Tag for death manager bypass (needs integration in death_manager.script)
    pcall(function() se_obj.is_zone_proxy = true end)
    return true
end

function despawn_proxy(session_id)
    pending_peers[session_id] = nil
    peer_names[session_id] = nil
    local proxy = spawned_proxies[session_id]
    if proxy then
        -- Guarded: alife() is nil in menu / during level change.
        pcall(function()
            local sim = nil
            if alife then
                local ok, res = pcall(alife)
                if ok then sim = res end
            end
            if sim and proxy.se_id then
                local se_obj = nil
                pcall(function() se_obj = sim:object(proxy.se_id) end)
                if se_obj then
                    pcall(function() sim:release(se_obj, true) end)
                end
            end
        end)
        spawned_proxies[session_id] = nil
    end
end

function update_proxy(session_id, x, y, z, yaw, pitch, animflags, health)
    local proxy = spawned_proxies[session_id]
    if not proxy then return end
    
    add_history_sample(proxy, {
        x = x, y = y, z = z, yaw = yaw, pitch = pitch, animflags = animflags, health = health, t = time_global()
    })
    
    proxy.last_update = time_global()
    
    -- Resolve game_id once online and apply the peer's real visual.
    if not proxy.game_id and level and level.object_by_id then
        local obj = level.object_by_id(proxy.se_id)
        if obj then
            proxy.game_id = proxy.se_id
            try_apply_visual(proxy, obj)
        end
    end
    
    -- Apply anim flags / health if game object exists
    local obj = (proxy.game_id and level and level.object_by_id) and level.object_by_id(proxy.game_id) or nil
    if obj then
        try_apply_visual(proxy, obj)
        if health <= 0 and obj:alive() then
            -- L-18: Attribute killer to actual attacker entity instead of self
            local killer_obj = resolve_entity(proxy.last_attacker_id) or obj
            obj:kill(killer_obj)
        end
    end
end

-- Hard TTL leak guard; explicit ENTITY_LEAVE is the normal despawn path.
local STALE_PROXY_MS = 300000
local function reap_stale_proxies(tg)
    for sid, proxy in pairs(spawned_proxies) do
        if proxy.last_update and (tg - proxy.last_update) > STALE_PROXY_MS then
            pcall(despawn_proxy, sid)
        end
    end
end

-- Hermite spline interpolation for smooth proxy movement (L-05 & L-24)
function interpolate_proxies()
    local tg = time_global()
    local target_t = tg - JITTER_BUFFER_MS

    reap_stale_proxies(tg)

    for sid, proxy in pairs(spawned_proxies) do
        -- Resolve game_id once online if not yet resolved
        if not proxy.game_id and level and level.object_by_id then
            local obj = level.object_by_id(proxy.se_id)
            if obj then
                proxy.game_id = proxy.se_id
                try_apply_visual(proxy, obj)
            end
        end

        local count = proxy.hist_count
        if count >= 2 then
            local s_first = get_history_sample(proxy, 1)
            local s_last = get_history_sample(proxy, count)
            
            -- Find the interval [idx, idx+1]
            local idx = 1
            if target_t <= s_first.t then
                idx = 1
            elseif target_t >= s_last.t then
                idx = count - 1
            else
                for i = 1, count - 1 do
                    local s1 = get_history_sample(proxy, i)
                    local s2 = get_history_sample(proxy, i + 1)
                    if s1.t <= target_t and s2.t >= target_t then
                        idx = i
                        break
                    end
                end
            end
            
            local p1 = get_history_sample(proxy, idx)
            local p2 = get_history_sample(proxy, idx + 1)
            
            local dt12 = p2.t - p1.t
            local t = 0
            if dt12 > 0 then
                t = math.max(0, math.min(1, (target_t - p1.t) / dt12))
            else
                t = 1
            end
            
            -- Time-scaled Catmull-Rom tangents with clamped/linear edge handling (L-05 & L-24)
            local m1x, m1y, m1z
            if idx > 1 then
                local p0 = get_history_sample(proxy, idx - 1)
                local dt02 = p2.t - p0.t
                local scale1 = (dt02 > 0) and (dt12 / dt02) or 0.5
                m1x = (p2.x - p0.x) * scale1
                m1y = (p2.y - p0.y) * scale1
                m1z = (p2.z - p0.z) * scale1
            else
                -- Clamped Catmull-Rom / linear tangent at start interval
                m1x = p2.x - p1.x
                m1y = p2.y - p1.y
                m1z = p2.z - p1.z
            end
            
            local m2x, m2y, m2z
            if idx < count - 1 then
                local p3 = get_history_sample(proxy, idx + 2)
                local dt13 = p3.t - p1.t
                local scale2 = (dt13 > 0) and (dt12 / dt13) or 0.5
                m2x = (p3.x - p1.x) * scale2
                m2y = (p3.y - p1.y) * scale2
                m2z = (p3.z - p1.z) * scale2
            else
                -- Clamped Catmull-Rom / linear tangent at end interval
                m2x = p2.x - p1.x
                m2y = p2.y - p1.y
                m2z = p2.z - p1.z
            end
            
            -- Hermite basis functions
            local t2 = t * t
            local t3 = t2 * t
            local h00 = (2 * t3 - 3 * t2 + 1)
            local h10 = (t3 - 2 * t2 + t)
            local h01 = (-2 * t3 + 3 * t2)
            local h11 = (t3 - t2)
            
            local ix = h00 * p1.x + h10 * m1x + h01 * p2.x + h11 * m2x
            local iy = h00 * p1.y + h10 * m1y + h01 * p2.y + h11 * m2y
            local iz = h00 * p1.z + h10 * m1z + h01 * p2.z + h11 * m2z
            
            if proxy.game_id and level and level.object_by_id then
                pcall(function()
                    local obj = level.object_by_id(proxy.game_id)
                    if obj and obj:alive() and obj.set_npc_position then
                        obj:set_npc_position(vector():set(ix, iy, iz))
                    end
                end)
            end
        elseif count == 1 then
            local p1 = get_history_sample(proxy, 1)
            if proxy.game_id and level and level.object_by_id then
                pcall(function()
                    local obj = level.object_by_id(proxy.game_id)
                    if obj and obj:alive() and obj.set_npc_position then
                        obj:set_npc_position(vector():set(p1.x, p1.y, p1.z))
                    end
                end)
            end
        end
    end
end

function on_snapshot(pkt, offset)
    local pkt_len = string.len(pkt)
    prune_pending_peers(time_global())
    -- count(1) + 22 bytes per SnapshotEntry; validate before walking (forged count safe)
    local count, pos = zone_net.read_uint8(pkt, offset)
    if not count then return end
    if count > 32 then count = 32 end
    if pkt_len < (pos - 1) + count * 22 then return end
    for i = 1, count do
        local sid, pos2 = zone_net.read_uint32_le(pkt, pos)
        local x, pos3 = zone_net.read_float_le(pkt, pos2)
        local y, pos4 = zone_net.read_float_le(pkt, pos3)
        local z, pos5 = zone_net.read_float_le(pkt, pos4)
        local yaw, pos6 = zone_net.read_uint16_le(pkt, pos5)
        local pitch, pos7 = zone_net.read_uint16_le(pkt, pos6)
        local animflags, pos8 = zone_net.read_uint8(pkt, pos7)
        local health, pos9 = zone_net.read_uint8(pkt, pos8)
        pos = pos9
        
        -- Convert pseudo-floats
        if yaw > 32767 then yaw = yaw - 65536 end
        if pitch > 32767 then pitch = pitch - 65536 end
        
        -- Snapshot never spawns from scratch. It only flushes a pending
        -- ENTITY_ENTER (peer seen before level load) with the latest position,
        -- then updates proxies that already have valid spawn data.
        local pending = pending_peers[sid]
        if pending and not spawned_proxies[sid] then
            pending.x, pending.y, pending.z = x, y, z
            pending.health = health
            try_spawn_pending(sid)
        end
        if spawned_proxies[sid] then
            update_proxy(sid, x, y, z, yaw / 100.0, pitch / 100.0, animflags, health)
        end
    end
end

-- ENTITY_ENTER_AOI v3 (132 bytes): entityID u32, type u8, section[64] (visual
-- path), x/y/z f32, faction[16], health u8, gvid u16, name[32].
function on_entity_enter(pkt, offset)
    if not pkt or not offset then return end
    -- Full v3 payload before parsing (forged/truncated packet safe).
    if string.len(pkt) < offset + 132 - 1 then return end

    local eid, pos = zone_net.read_uint32_le(pkt, offset)
    local typ, pos = zone_net.read_uint8(pkt, pos)
    local section, pos = zone_net.read_string(pkt, pos, 64)
    -- clean null bytes from section
    section = section:gsub("%z+", "")
    
    local x, pos = zone_net.read_float_le(pkt, pos)
    local y, pos = zone_net.read_float_le(pkt, pos)
    local z, pos = zone_net.read_float_le(pkt, pos)
    
    local faction, pos = zone_net.read_string(pkt, pos, 16)
    faction = faction:gsub("%z+", "")
    local health, pos = zone_net.read_uint8(pkt, pos)
    local gvid, pos = zone_net.read_uint16_le(pkt, pos)
    local name, pos = zone_net.read_string(pkt, pos, 32)
    name = name:gsub("%z+", "")
    
    -- Store peer metadata (L-25): faction + display name for the HUD.
    if faction and faction ~= "" then
        peer_factions[eid] = faction
    end
    if name and name ~= "" then
        peer_names[eid] = name
    end
    
    if typ == 1 then -- Player
        local proxy = spawned_proxies[eid]
        if proxy then
            proxy.faction = faction
            proxy.name = name
            if section and section ~= "" then
                proxy.visual = section
                proxy.visual_applied = false
            end
            if proxy.game_id and level and level.object_by_id then
                local obj = level.object_by_id(proxy.game_id)
                if obj then
                    pcall(try_apply_visual, proxy, obj)
                    if obj.set_character_community then
                        pcall(function() obj:set_character_community(faction, 0, 0) end)
                    end
                end
            end
        else
            -- Store first; spawn only with valid level vertex + packet gvid.
            store_pending_peer(eid, x, y, z, faction, section, health, gvid, name)
            try_spawn_pending(eid)
        end
    end
end

-- Peer metadata getters (HUD). Missing entry => "".
function get_peer_name(sid)
    if sid == nil then return "" end
    return peer_names[sid] or ""
end

function get_peer_faction(sid)
    if sid == nil then return "" end
    return peer_factions[sid] or ""
end

-- Connected player proxies within max_dist of db.actor, sorted by distance.
-- Returns { { session_id, name, faction, distance }, ... }. Never fatal.
function get_nearby_players(max_dist)
    local out = {}
    local actor = db and db.actor
    if not actor then return out end
    local max_d = tonumber(max_dist) or 120
    if max_d <= 0 then max_d = 120 end

    local ax, ay, az = nil, nil, nil
    pcall(function()
        local p = actor:position()
        ax, ay, az = p.x, p.y, p.z
    end)
    if ax == nil or not (level and level.object_by_id) then return out end

    for sid, proxy in pairs(spawned_proxies) do
        if proxy.game_id then
            local obj = nil
            pcall(function() obj = level.object_by_id(proxy.game_id) end)
            if obj then
                local px, py, pz = nil, nil, nil
                pcall(function()
                    local p = obj:position()
                    px, py, pz = p.x, p.y, p.z
                end)
                if px ~= nil then
                    local dx, dy, dz = px - ax, py - ay, pz - az
                    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
                    if dist <= max_d then
                        out[#out + 1] = {
                            session_id = sid,
                            name = peer_names[sid] or proxy.name or "",
                            faction = peer_factions[sid] or proxy.faction or "",
                            distance = dist,
                        }
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.distance < b.distance end)
    return out
end

function on_damage_notify(target_id, attacker_id, damage, bone_id)
    local proxy = spawned_proxies[target_id]
    if not proxy then return end

    if attacker_id then
        proxy.last_attacker_id = attacker_id
    end

    local latest = get_latest_sample(proxy)
    local current_health = latest and latest.health or 100
    local new_health = math.max(0, current_health - damage)
    
    if latest then
        latest.health = new_health
    else
        add_history_sample(proxy, {
            x = 0, y = 0, z = 0, yaw = 0, pitch = 0, animflags = 0, health = new_health, t = time_global()
        })
    end

    if new_health <= 0 and proxy.game_id and level and level.object_by_id then
        local obj = level.object_by_id(proxy.game_id)
        if obj and obj:alive() then
            -- L-18: Attribute killer to actual attacker entity instead of self
            local killer_obj = resolve_entity(attacker_id) or obj
            obj:kill(killer_obj)
        end
    end
end

function on_entity_leave(pkt, offset)
    if not pkt or not offset then return end
    local eid = nil
    pcall(function() eid = zone_net.read_uint32_le(pkt, offset) end)
    if not eid then return end
    despawn_proxy(eid)
end

function on_level_changing()
    pcall(function()
        local sim = nil
        if alife then
            local ok, res = pcall(alife)
            if ok then sim = res end
        end
        for sid, proxy in pairs(spawned_proxies) do
            if sim and proxy.se_id then
                local se_obj = nil
                pcall(function() se_obj = sim:object(proxy.se_id) end)
                if se_obj then
                    pcall(function() sim:release(se_obj, true) end)
                end
            end
        end
    end)
    spawned_proxies = {}
    peer_factions = {}
    peer_names = {}
    pending_peers = {}
end

function on_game_start()
    if RegisterScriptCallback then
        RegisterScriptCallback("on_level_changing", on_level_changing)
    end
end
