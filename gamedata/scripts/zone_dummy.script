-- zone_dummy.script
-- Proxy stalker system with Hermite Spline Interpolation

local ffi = require("ffi")
-- Distinct union name: zone_net.script already cdefs znet_float_cast in the
-- same Lua state. pcall keeps a same-state script reload (ctype already
-- defined) from raising; the type then simply already exists.
pcall(function()
    ffi.cdef[[
        typedef union { float f; uint8_t b[4]; } zone_hit_float_cast;
    ]]
end)

local spawned_proxies = {}
local peer_factions = {}
local peer_names = {}
-- ENTITY_ENTER_AOI may arrive before the level/graph exists. Wire data is kept
-- here (keyed by entity id) until a snapshot tick can spawn with valid data.
local pending_peers = {}
local MAX_HISTORY = 8
local JITTER_BUFFER_MS = 100
local DEFAULT_PROXY_VISUAL = "actors\\stalker_neutral\\stalker_neutral_1"
local PROXY_SECTION = "zone_proxy_stalker"
local FALLBACK_PROXY_SECTION = "sim_default_stalker_0"
local INVALID_LEVEL_VERTEX = 0xFFFFFFFE
local PENDING_PEER_CAP = 32
local PENDING_PEER_TTL_MS = 120000
local pending_prune_logged = false

-- Snapshot rotation/anim application. MonsterSpace enums mirror
-- zone_ai_proxy.script (ai_monster_space.h:22-34):
--   EBodyState:    eBodyStateCrouch = 0, eBodyStateStand = 1
--   EMovementType: eMovementTypeWalk = 0, eMovementTypeRun = 1
-- Wire animflags (same bits zone_net produces): bit 0 crouch, bit 1 sprint.
local BODY_CROUCH = 0
local BODY_STAND = 1
local MOVE_WALK = 0
local MOVE_RUN = 1
local ANIM_FLAG_CROUCH = 1
local ANIM_FLAG_SPRINT = 2
-- Snap the proxy with set_npc_position only when the interpolated target moved
-- more than this since the last snap; between snaps the puppet is steered with
-- set_desired_position, which avoids a teleport-driven animation reset every
-- frame.
local PROXY_SNAP_EPS_M = 0.1
local PROXY_SNAP_EPS_SQ = PROXY_SNAP_EPS_M * PROXY_SNAP_EPS_M

-- Snapshot-gap extrapolation (v4 smoothing): when no snapshot arrived for a
-- proxy for > 150 ms, continue along the last known velocity for at most
-- 250 ms / 1.5 m, then blend back to authoritative data over 150 ms.
local EXTRAPOLATE_START_MS = 150
local EXTRAPOLATE_STOP_MS = 2000
local EXTRAPOLATE_CAP_MS = 250
local EXTRAPOLATE_MAX_DIST = 1.5
local EXTRAPOLATE_BLEND_MS = 150

-- Reusable vectors for the per-frame path: one module-level instance instead of
-- a vector allocation per proxy per frame. Created lazily because vector() may
-- not be bound during the very first script load pass.
local g_render_pos, g_render_dir

local function ensure_render_vectors()
    if g_render_pos then return end
    g_render_pos = vector():set(0, 0, 0)
    g_render_dir = vector():set(0, 0, 1)
end

-- Named wrappers so pcall(fn, ...) does not allocate a closure per proxy per
-- frame. Each one feeds the corresponding reusable vector.
local function obj_set_npc_position(obj)
    obj:set_npc_position(g_render_pos)
end

local function obj_set_desired_position(obj)
    obj:set_desired_position(g_render_pos)
end

local function obj_set_desired_direction(obj)
    obj:set_desired_direction(g_render_dir)
end

local function obj_set_body_state(obj, state)
    obj:set_body_state(state)
end

local function obj_set_movement_type(obj, movement_type)
    obj:set_movement_type(movement_type)
end

local function obj_alive(obj)
    return obj:alive()
end

-- level.object_by_id is an engine call; always reached through pcall.
local function level_object_by_id(id)
    return level.object_by_id(id)
end

-- Ring buffer helper functions (L-30: avoid table.remove(tbl, 1) in hot path)
local function add_history_sample(proxy, sample)
    if proxy.hist_count < MAX_HISTORY then
        proxy.hist_count = proxy.hist_count + 1
        local idx = ((proxy.hist_head + proxy.hist_count - 2) % MAX_HISTORY) + 1
        proxy.pos_history[idx] = sample
    else
        -- Ring buffer full: overwrite oldest sample at hist_head and advance
        proxy.pos_history[proxy.hist_head] = sample
        proxy.hist_head = (proxy.hist_head % MAX_HISTORY) + 1
    end
end

local function get_history_sample(proxy, i)
    if i < 1 or i > proxy.hist_count then return nil end
    local idx = ((proxy.hist_head + i - 2) % MAX_HISTORY) + 1
    return proxy.pos_history[idx]
end

local function get_latest_sample(proxy)
    if proxy.hist_count == 0 then return nil end
    return get_history_sample(proxy, proxy.hist_count)
end

-- Resolve entity by ID (attacker lookup: db.actor or remote proxy). Wire IDs
-- are server-side entity IDs, not local engine IDs: for arbitrary IDs a direct
-- level.object_by_id(id) lookup is wrong (u16 engine-ID overload fed a wire
-- u32) and is intentionally skipped; only a spawned proxy's own local
-- game_id/se_id may be resolved. (L-18)
local function resolve_entity(id)
    if not id then return nil end
    -- Never touch xrRazom co-op dummies (guarded; absent when co-op not installed).
    local ok_dummy, is_dummy = pcall(function()
        return XrrPlayers and XrrPlayers():IsPlayerDummy(id)
    end)
    if ok_dummy and is_dummy then return nil end
    if db.actor and (id == db.actor:id()) then
        return db.actor
    end
    local proxy = spawned_proxies[id]
    if proxy then
        local gid = proxy.game_id or proxy.se_id
        if gid and level and level.object_by_id then
            local obj = level.object_by_id(gid)
            if obj then return obj end
        end
    end
    return nil
end

-- Spawn section: [zone_proxy_stalker] is DLTX-merged into system.ltx from
-- mod_system_zone_online.ltx and inherits sim_default_stalker_0.
local function resolve_spawn_section()
    if ini_sys and ini_sys.section_exist then
        if ini_sys:section_exist(PROXY_SECTION) then return PROXY_SECTION end
        if ini_sys:section_exist(FALLBACK_PROXY_SECTION) then return FALLBACK_PROXY_SECTION end
    end
    return nil
end

-- Co-op dormancy gate. Single owner is zone_main.xrr_is_active(), which also
-- covers XrrNet; the raw Xrr* globals are only a fallback while zone_main is
-- not loaded (nil-safe, never fatal).
local function xrr_is_active()
    local fn = zone_main and zone_main.xrr_is_active
    if type(fn) == "function" then
        local ok, res = pcall(fn)
        if ok then return res == true end
    end
    local active = false
    pcall(function()
        if _G.XrrIsConnected and _G.XrrIsConnected() then active = true end
        if _G.XrrIsHosted and _G.XrrIsHosted() then active = true end
    end)
    return active
end

-- Server ENTITY_ENTER never carries a visual for AI puppets; player peers do.
-- Applied only once the object is online (create is queued, not instant).
local function try_apply_visual(proxy, obj)
    if proxy.visual_applied then return end
    local visual = proxy.visual
    if not visual or visual == "" then
        visual = DEFAULT_PROXY_VISUAL
    end
    local current = nil
    pcall(function() current = obj:get_visual_name() end)
    if current and current ~= "" and current == visual then
        proxy.visual_applied = true
        return
    end
    local ok = pcall(function() obj:set_visual_name(visual, true) end)
    if ok then
        proxy.visual_applied = true
    end
end

-- Hold ENTITY_ENTER wire data until the level graph is available.
local function store_pending_peer(eid, x, y, z, faction, visual, health, gvid, name)
    if pending_peers[eid] then
        local entry = pending_peers[eid]
        entry.x, entry.y, entry.z = x, y, z
        entry.faction, entry.visual = faction, visual
        entry.health, entry.gvid = health, gvid
        entry.name = name
    else
        local n = 0
        for _ in pairs(pending_peers) do n = n + 1 end
        if n >= PENDING_PEER_CAP then
            local oldest_eid, oldest_t = nil, nil
            for id, entry in pairs(pending_peers) do
                if oldest_t == nil or entry.t < oldest_t then
                    oldest_eid, oldest_t = id, entry.t
                end
            end
            if oldest_eid then
                pending_peers[oldest_eid] = nil
            end
        end
        pending_peers[eid] = {
            x = x, y = y, z = z,
            faction = faction, visual = visual,
            health = health, gvid = gvid, name = name,
            t = time_global()
        }
    end
    if faction and faction ~= "" then
        peer_factions[eid] = faction
    end
    if name and name ~= "" then
        peer_names[eid] = name
    end
end

local function prune_pending_peers(tg)
    local removed = 0
    for eid, entry in pairs(pending_peers) do
        if entry.t and (tg - entry.t) > PENDING_PEER_TTL_MS then
            pending_peers[eid] = nil
            removed = removed + 1
        end
    end
    if removed > 0 and not pending_prune_logged then
        pending_prune_logged = true
        printf("[zone_dummy] pruned %d expired pending peer(s)", removed)
    end
end

local function try_spawn_pending(eid)
    local pending = pending_peers[eid]
    if not pending then return false end
    if spawned_proxies[eid] then
        pending_peers[eid] = nil
        return true
    end
    -- Never spawn before the level graph exists (vertex_id needs it).
    if not (level and level.vertex_id) then return false end
    local pos = nil
    pcall(function() pos = vector():set(pending.x, pending.y, pending.z) end)
    if not pos then return false end
    if spawn_proxy(eid, pos, pending.faction, pending.visual, pending.gvid) then
        pending_peers[eid] = nil
        return true
    end
    return false
end

-- Spawn from validated ENTITY_ENTER_AOI v2 data only: real visual + packet
-- gvid. No actor lvid/gvid fallback (that spawned peers at the wrong graph
-- vertex). Returns true when the alife object was queued for spawn.
function spawn_proxy(session_id, pos, faction, visual, gvid)
    if spawned_proxies[session_id] then return false end
    if not pos then return false end

    -- Never spawn while xrRazom owns the world (dual proxy systems conflict).
    if xrr_is_active() then return false end

    -- Game vertex is packet-authoritative; 0 means the server had none.
    if not gvid or gvid == 0 then return false end

    -- Level vertex queried at the ENTITY position, never at the local actor.
    -- level.vertex_id returns u32(-1) off-graph; never feed that to create.
    local lvid = nil
    pcall(function()
        if level and level.vertex_id then
            lvid = level.vertex_id(pos)
        end
    end)
    if lvid == nil or lvid >= INVALID_LEVEL_VERTEX then return false end

    local section = resolve_spawn_section()
    if not section then return false end

    local sim = nil
    pcall(function() sim = alife() end)
    if not sim then return false end

    local se_obj = nil
    pcall(function() se_obj = sim:create(section, pos, lvid, gvid) end)
    if not se_obj then return false end

    local resolved_faction = (faction and faction ~= "") and faction or (peer_factions[session_id] or "stalker")
    peer_factions[session_id] = resolved_faction

    spawned_proxies[session_id] = {
        se_id = se_obj.id,
        game_id = nil,
        pos_history = {},
        hist_head = 1,
        hist_count = 0,
        faction = resolved_faction,
        name = peer_names[session_id] or "",
        visual = (visual and visual ~= "") and visual or DEFAULT_PROXY_VISUAL,
        visual_applied = false,
        last_attacker_id = nil,
        last_update = time_global()
    }
    return true
end

function despawn_proxy(session_id)
    pending_peers[session_id] = nil
    peer_names[session_id] = nil
    local proxy = spawned_proxies[session_id]
    if proxy then
        -- Guarded: alife() is nil in menu / during level change.
        pcall(function()
            local sim = nil
            if alife then
                local ok, res = pcall(alife)
                if ok then sim = res end
            end
            if sim and proxy.se_id then
                local se_obj = nil
                pcall(function() se_obj = sim:object(proxy.se_id) end)
                if se_obj then
                    pcall(function() sim:release(se_obj, true) end)
                end
            end
        end)
        spawned_proxies[session_id] = nil
    end
end

-- Apply decoded animflags as body/movement state. Only called when the flags
-- actually changed, so no engine call is issued for unchanged state.
local function apply_proxy_anim(proxy, obj)
    if proxy.applied_animflags == proxy.animflags then return end
    proxy.applied_animflags = proxy.animflags
    local flags = proxy.animflags or 0
    local crouch = bit.band(flags, ANIM_FLAG_CROUCH) ~= 0
    local sprint = bit.band(flags, ANIM_FLAG_SPRINT) ~= 0
    pcall(obj_set_body_state, obj, crouch and BODY_CROUCH or BODY_STAND)
    pcall(obj_set_movement_type, obj, sprint and MOVE_RUN or MOVE_WALK)
end

-- Re-apply the cached snapshot yaw every interpolation tick as a desired
-- direction, and move the proxy. Pitch is decoded and cached but intentionally
-- not applied: the script API has no verified cheap NPC pitch binding and
-- folding pitch into set_desired_direction is not verified to aim the puppet.
-- set_npc_position is only used when the render target moved more than
-- PROXY_SNAP_EPS_M since the last snap (teleport resets animation state);
-- otherwise set_desired_position steers the puppet smoothly.
local function apply_proxy_motion(proxy, obj, ix, iy, iz)
    if proxy.target_yaw then
        g_render_dir:set(math.sin(proxy.target_yaw), 0, math.cos(proxy.target_yaw))
        pcall(obj_set_desired_direction, obj)
    end
    g_render_pos:set(ix, iy, iz)
    local moved_sq = nil
    if proxy.render_applied_x then
        local dx = ix - proxy.render_applied_x
        local dy = iy - proxy.render_applied_y
        local dz = iz - proxy.render_applied_z
        moved_sq = dx * dx + dy * dy + dz * dz
    end
    if moved_sq == nil or moved_sq > PROXY_SNAP_EPS_SQ then
        pcall(obj_set_npc_position, obj)
        proxy.render_applied_x, proxy.render_applied_y, proxy.render_applied_z = ix, iy, iz
    else
        pcall(obj_set_desired_position, obj)
    end
end

local function apply_motion_if_alive(proxy, obj, ix, iy, iz)
    if obj_alive(obj) then
        apply_proxy_motion(proxy, obj, ix, iy, iz)
        apply_proxy_anim(proxy, obj)
    end
end

function update_proxy(session_id, x, y, z, yaw, pitch, animflags, health)
    local proxy = spawned_proxies[session_id]
    if not proxy then return end

    local tg = time_global()
    add_history_sample(proxy, {
        x = x, y = y, z = z, yaw = yaw, pitch = pitch, animflags = animflags, health = health, t = tg
    })
    -- Cache rotation/animation so the interpolate tick can re-apply it even
    -- between snapshots.
    proxy.target_yaw = yaw
    proxy.target_pitch = pitch
    proxy.animflags = animflags

    -- Last known velocity in m/ms from the two newest samples (scalars only).
    if proxy.hist_count >= 2 then
        local latest = get_history_sample(proxy, proxy.hist_count)
        local prev = get_history_sample(proxy, proxy.hist_count - 1)
        local dtms = latest.t - prev.t
        if dtms > 0 then
            proxy.vel_x = (latest.x - prev.x) / dtms
            proxy.vel_y = (latest.y - prev.y) / dtms
            proxy.vel_z = (latest.z - prev.z) / dtms
        end
    end

    -- Fresh authoritative data after an extrapolation gap: blend from the last
    -- rendered position instead of popping to the new sample.
    if proxy.extrapolating then
        proxy.blend_start = tg
        proxy.blend_from_x = proxy.render_x or x
        proxy.blend_from_y = proxy.render_y or y
        proxy.blend_from_z = proxy.render_z or z
        proxy.extrapolating = false
    end

    proxy.last_update = tg
    
    -- Resolve game_id once online and apply the peer's real visual.
    if not proxy.game_id and level and level.object_by_id then
        local ok_obj, obj = pcall(level_object_by_id, proxy.se_id)
        if ok_obj and obj then
            proxy.game_id = proxy.se_id
            try_apply_visual(proxy, obj)
        end
    end

    -- Apply rotation-independent state / health if the game object exists.
    local obj = nil
    if proxy.game_id then
        local ok_obj, resolved = pcall(level_object_by_id, proxy.game_id)
        if ok_obj then obj = resolved end
    end
    if obj then
        try_apply_visual(proxy, obj)
        apply_proxy_anim(proxy, obj)
        if health <= 0 and obj:alive() then
            -- L-18: Attribute killer to actual attacker entity instead of self
            local killer_obj = resolve_entity(proxy.last_attacker_id) or obj
            obj:kill(killer_obj, false)
        end
    end
end

-- Hard TTL leak guard; explicit ENTITY_LEAVE is the normal despawn path.
local STALE_PROXY_MS = 300000
local function reap_stale_proxies(tg)
    for sid, proxy in pairs(spawned_proxies) do
        if proxy.last_update and (tg - proxy.last_update) > STALE_PROXY_MS then
            pcall(despawn_proxy, sid)
        end
    end
end

-- Hermite spline interpolation for smooth proxy movement (L-05 & L-24)
function interpolate_proxies()
    ensure_render_vectors()
    local tg = time_global()
    local target_t = tg - JITTER_BUFFER_MS

    reap_stale_proxies(tg)

    for sid, proxy in pairs(spawned_proxies) do
        -- Resolve game_id once online if not yet resolved
        if not proxy.game_id and level and level.object_by_id then
            local ok_obj, obj = pcall(level_object_by_id, proxy.se_id)
            if ok_obj and obj then
                proxy.game_id = proxy.se_id
                try_apply_visual(proxy, obj)
            end
        end

        local count = proxy.hist_count
        if count >= 2 then
            local s_first = get_history_sample(proxy, 1)
            local s_last = get_history_sample(proxy, count)
            
            -- Find the interval [idx, idx+1]
            local idx = 1
            if target_t <= s_first.t then
                idx = 1
            elseif target_t >= s_last.t then
                idx = count - 1
            else
                for i = 1, count - 1 do
                    local s1 = get_history_sample(proxy, i)
                    local s2 = get_history_sample(proxy, i + 1)
                    if s1.t <= target_t and s2.t >= target_t then
                        idx = i
                        break
                    end
                end
            end
            
            local p1 = get_history_sample(proxy, idx)
            local p2 = get_history_sample(proxy, idx + 1)
            
            local dt12 = p2.t - p1.t
            local t = 0
            if dt12 > 0 then
                t = math.max(0, math.min(1, (target_t - p1.t) / dt12))
            else
                t = 1
            end
            
            -- Time-scaled Catmull-Rom tangents with clamped/linear edge handling (L-05 & L-24)
            local m1x, m1y, m1z
            if idx > 1 then
                local p0 = get_history_sample(proxy, idx - 1)
                local dt02 = p2.t - p0.t
                local scale1 = (dt02 > 0) and (dt12 / dt02) or 0.5
                m1x = (p2.x - p0.x) * scale1
                m1y = (p2.y - p0.y) * scale1
                m1z = (p2.z - p0.z) * scale1
            else
                -- Clamped Catmull-Rom / linear tangent at start interval
                m1x = p2.x - p1.x
                m1y = p2.y - p1.y
                m1z = p2.z - p1.z
            end
            
            local m2x, m2y, m2z
            if idx < count - 1 then
                local p3 = get_history_sample(proxy, idx + 2)
                local dt13 = p3.t - p1.t
                local scale2 = (dt13 > 0) and (dt12 / dt13) or 0.5
                m2x = (p3.x - p1.x) * scale2
                m2y = (p3.y - p1.y) * scale2
                m2z = (p3.z - p1.z) * scale2
            else
                -- Clamped Catmull-Rom / linear tangent at end interval
                m2x = p2.x - p1.x
                m2y = p2.y - p1.y
                m2z = p2.z - p1.z
            end
            
            -- Hermite basis functions
            local t2 = t * t
            local t3 = t2 * t
            local h00 = (2 * t3 - 3 * t2 + 1)
            local h10 = (t3 - 2 * t2 + t)
            local h01 = (-2 * t3 + 3 * t2)
            local h11 = (t3 - t2)
            
            local ix = h00 * p1.x + h10 * m1x + h01 * p2.x + h11 * m2x
            local iy = h00 * p1.y + h10 * m1y + h01 * p2.y + h11 * m2y
            local iz = h00 * p1.z + h10 * m1z + h01 * p2.z + h11 * m2z

            -- Snapshot-gap extrapolation: no packet for > 150 ms, continue on
            -- the last velocity (caps: 250 ms / 1.5 m); stop past 2 s.
            local gap = tg - (proxy.last_update or 0)
            if proxy.vel_x and gap > EXTRAPOLATE_START_MS and gap < EXTRAPOLATE_STOP_MS then
                local dt = gap - EXTRAPOLATE_START_MS
                if dt > EXTRAPOLATE_CAP_MS then dt = EXTRAPOLATE_CAP_MS end
                local dxv = proxy.vel_x * dt
                local dyv = proxy.vel_y * dt
                local dzv = proxy.vel_z * dt
                local dlen = math.sqrt(dxv * dxv + dyv * dyv + dzv * dzv)
                if dlen > EXTRAPOLATE_MAX_DIST then
                    local k = EXTRAPOLATE_MAX_DIST / dlen
                    dxv, dyv, dzv = dxv * k, dyv * k, dzv * k
                end
                ix, iy, iz = s_last.x + dxv, s_last.y + dyv, s_last.z + dzv
                proxy.extrapolating = true
            else
                proxy.extrapolating = false
            end

            -- Blend back to authoritative interpolation after a new snapshot.
            if proxy.blend_start then
                local bt = tg - proxy.blend_start
                if bt < EXTRAPOLATE_BLEND_MS then
                    local a = bt / EXTRAPOLATE_BLEND_MS
                    ix = proxy.blend_from_x + (ix - proxy.blend_from_x) * a
                    iy = proxy.blend_from_y + (iy - proxy.blend_from_y) * a
                    iz = proxy.blend_from_z + (iz - proxy.blend_from_z) * a
                else
                    proxy.blend_start = nil
                end
            end
            proxy.render_x, proxy.render_y, proxy.render_z = ix, iy, iz

            if proxy.game_id then
                local ok_obj, obj = pcall(level_object_by_id, proxy.game_id)
                if ok_obj and obj then
                    pcall(apply_motion_if_alive, proxy, obj, ix, iy, iz)
                end
            end
        elseif count == 1 then
            local p1 = get_history_sample(proxy, 1)
            proxy.render_x, proxy.render_y, proxy.render_z = p1.x, p1.y, p1.z
            if proxy.game_id then
                local ok_obj, obj = pcall(level_object_by_id, proxy.game_id)
                if ok_obj and obj then
                    pcall(apply_motion_if_alive, proxy, obj, p1.x, p1.y, p1.z)
                end
            end
        end
    end
end

function on_snapshot(pkt, offset)
    local pkt_len = string.len(pkt)
    prune_pending_peers(time_global())
    -- count(1) + 22 bytes per SnapshotEntry; validate before walking (forged count safe)
    local count, pos = zone_net.read_uint8(pkt, offset)
    if not count then return end
    if count > 32 then count = 32 end
    if pkt_len < (pos - 1) + count * 22 then return end
    for i = 1, count do
        local sid, pos2 = zone_net.read_uint32_le(pkt, pos)
        local x, pos3 = zone_net.read_float_le(pkt, pos2)
        local y, pos4 = zone_net.read_float_le(pkt, pos3)
        local z, pos5 = zone_net.read_float_le(pkt, pos4)
        local yaw, pos6 = zone_net.read_uint16_le(pkt, pos5)
        local pitch, pos7 = zone_net.read_uint16_le(pkt, pos6)
        local animflags, pos8 = zone_net.read_uint8(pkt, pos7)
        local health, pos9 = zone_net.read_uint8(pkt, pos8)
        pos = pos9
        
        -- Convert pseudo-floats
        if yaw > 32767 then yaw = yaw - 65536 end
        if pitch > 32767 then pitch = pitch - 65536 end
        
        -- Snapshot never spawns from scratch. It only flushes a pending
        -- ENTITY_ENTER (peer seen before level load) with the latest position,
        -- then updates proxies that already have valid spawn data.
        local pending = pending_peers[sid]
        if pending and not spawned_proxies[sid] then
            pending.x, pending.y, pending.z = x, y, z
            pending.health = health
            try_spawn_pending(sid)
        end
        if spawned_proxies[sid] then
            update_proxy(sid, x, y, z, yaw / 100.0, pitch / 100.0, animflags, health)
        end
    end
end

-- ENTITY_ENTER_AOI v3 (132 bytes): entityID u32, type u8, section[64] (visual
-- path), x/y/z f32, faction[16], health u8, gvid u16, name[32].
function on_entity_enter(pkt, offset)
    if not pkt or not offset then return end
    -- Full v3 payload before parsing (forged/truncated packet safe).
    if string.len(pkt) < offset + 132 - 1 then return end

    local eid, pos = zone_net.read_uint32_le(pkt, offset)
    local typ, pos = zone_net.read_uint8(pkt, pos)
    local section, pos = zone_net.read_string(pkt, pos, 64)
    -- clean null bytes from section
    section = section:gsub("%z+", "")
    
    local x, pos = zone_net.read_float_le(pkt, pos)
    local y, pos = zone_net.read_float_le(pkt, pos)
    local z, pos = zone_net.read_float_le(pkt, pos)
    
    local faction, pos = zone_net.read_string(pkt, pos, 16)
    faction = faction:gsub("%z+", "")
    local health, pos = zone_net.read_uint8(pkt, pos)
    local gvid, pos = zone_net.read_uint16_le(pkt, pos)
    local name, pos = zone_net.read_string(pkt, pos, 32)
    name = name:gsub("%z+", "")
    
    -- Store peer metadata (L-25): faction + display name for the HUD.
    if faction and faction ~= "" then
        peer_factions[eid] = faction
    end
    if name and name ~= "" then
        peer_names[eid] = name
    end
    
    if typ == 1 then -- Player
        local proxy = spawned_proxies[eid]
        if proxy then
            proxy.faction = faction
            proxy.name = name
            if section and section ~= "" then
                proxy.visual = section
                proxy.visual_applied = false
            end
            if proxy.game_id and level and level.object_by_id then
                local obj = level.object_by_id(proxy.game_id)
                if obj then
                    pcall(try_apply_visual, proxy, obj)
                    if obj.set_character_community then
                        pcall(function() obj:set_character_community(faction, 0, 0) end)
                    end
                end
            end
        else
            -- Store first; spawn only with valid level vertex + packet gvid.
            store_pending_peer(eid, x, y, z, faction, section, health, gvid, name)
            try_spawn_pending(eid)
        end
    end
end

-- Peer metadata getters (HUD). Missing entry => "".
function get_peer_name(sid)
    if sid == nil then return "" end
    return peer_names[sid] or ""
end

function get_peer_faction(sid)
    if sid == nil then return "" end
    return peer_factions[sid] or ""
end

-- Connected player proxies within max_dist of db.actor, sorted by distance.
-- Returns { { session_id, name, faction, distance }, ... }. Never fatal.
function get_nearby_players(max_dist)
    local out = {}
    local actor = db and db.actor
    if not actor then return out end
    local max_d = tonumber(max_dist) or 120
    if max_d <= 0 then max_d = 120 end

    local ax, ay, az = nil, nil, nil
    pcall(function()
        local p = actor:position()
        ax, ay, az = p.x, p.y, p.z
    end)
    if ax == nil or not (level and level.object_by_id) then return out end

    for sid, proxy in pairs(spawned_proxies) do
        if proxy.game_id then
            local obj = nil
            pcall(function() obj = level.object_by_id(proxy.game_id) end)
            if obj then
                local px, py, pz = nil, nil, nil
                pcall(function()
                    local p = obj:position()
                    px, py, pz = p.x, p.y, p.z
                end)
                if px ~= nil then
                    local dx, dy, dz = px - ax, py - ay, pz - az
                    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
                    if dist <= max_d then
                        out[#out + 1] = {
                            session_id = sid,
                            name = peer_names[sid] or proxy.name or "",
                            faction = peer_factions[sid] or proxy.faction or "",
                            distance = dist,
                        }
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.distance < b.distance end)
    return out
end

-- ---------------------------------------------------------------------------
-- Hit registration (protocol 0x0050, frozen layout: TargetID u32, AttackerID
-- u32, Damage f32, BoneID u8 = 13 bytes).
--
-- Outgoing: when the local actor hits one of our spawned player proxies, the
-- proxy's engine HP is not locally authoritative, so the hit is reported to the
-- server and cancelled locally. The callback signature and flags contract are
-- the base-game ones: _g.script:1243-1247 dispatches
-- npc_on_before_hit(npc, shit, bone_id, flags) from
-- _G.CAI_Stalker__BeforeHitCallback and returns flags.ret_value; returning
-- false skips the hit entirely (ai_stalker_fire.cpp:408-423).
-- ---------------------------------------------------------------------------
local HIT_SEND_MIN_MS = 50 -- <= 20 sends/s
local HIT_NOTICE_MS = 1000
local last_hit_send_tg = 0
local last_hit_notice_tg = 0

local g_hit_payload = ffi.new("char[13]")
local g_hit_float = ffi.new("zone_hit_float_cast")

local function hit_payload_u32(buf, off, v)
    v = (tonumber(v) or 0) % 4294967296
    buf[off] = v % 256
    buf[off + 1] = math.floor(v / 256) % 256
    buf[off + 2] = math.floor(v / 65536) % 256
    buf[off + 3] = math.floor(v / 16777216) % 256
end

local function hit_payload_f32(buf, off, v)
    g_hit_float.f = tonumber(v) or 0
    for i = 0, 3 do buf[off + i] = g_hit_float.b[i] end
end

-- Reverse lookup: the engine hands us a game object, the wire addresses the
-- proxy by its session id. Proxy se_id/game_id are both the local alife/engine
-- object id (spawn_proxy stores se_obj.id; update_proxy promotes it to
-- game_id), so either comparison resolves the wire id.
local function proxy_session_for_object(obj)
    if not obj then return nil end
    local id = nil
    pcall(function() id = obj:id() end)
    if id == nil then return nil end
    for sid, proxy in pairs(spawned_proxies) do
        if proxy.game_id == id or proxy.se_id == id then
            return sid
        end
    end
    return nil
end

local function is_local_actor(obj)
    if not obj then return false end
    if obj == db.actor then return true end
    local same = false
    pcall(function()
        if db and db.actor then same = (obj:id() == db.actor:id()) end
    end)
    return same
end

local function local_session_id()
    local sid = 0
    pcall(function()
        if ZoneNet and ZoneNet.GetSessionInfo then
            sid = select(1, ZoneNet:GetSessionInfo()) or 0
        end
    end)
    return tonumber(sid) or 0
end

-- Never let a callback error escape into the engine dispatcher.
local function on_npc_before_hit(npc, s_hit, bone_id, flags)
    pcall(function()
        if not s_hit then return end
        local sid = proxy_session_for_object(npc)
        if not sid then return end
        if not is_local_actor(s_hit.draftsman) then return end

        local damage = tonumber(s_hit.power) or 0
        if damage <= 0 then damage = 1 end
        local bone = tonumber(bone_id) or 0
        if bone < 0 then bone = 0 end
        if bone > 255 then bone = 255 end

        local tg = time_global()
        if tg - last_hit_send_tg >= HIT_SEND_MIN_MS then
            last_hit_send_tg = tg
            hit_payload_u32(g_hit_payload, 0, sid)
            hit_payload_u32(g_hit_payload, 4, local_session_id())
            hit_payload_f32(g_hit_payload, 8, damage)
            g_hit_payload[12] = bit.band(bone, 0xFF)
            if ZoneNet and type(ZoneNet.SendRaw) == "function" then
                ZoneNet:SendRaw(0x0050, g_hit_payload, 13, true)
            end
        end

        -- Proxy HP is server-authoritative: cancel the local engine hit. The
        -- flag veto is the verified contract; zeroing power is defence in
        -- depth in case another npc_on_before_hit subscriber re-asserts the
        -- flag after us.
        pcall(function() s_hit.power = 0 end)
        if type(flags) == "table" then
            flags.ret_value = false
        end
    end)
end

-- Incoming: a server-relayed 0x0050 addressed to this client. The wire target
-- is the local session id; db.actor:id() is also accepted (legacy/engine-id
-- shape) so a relay cannot silently miss. Damage is applied through the
-- verified CScriptGameObject binding (script_game_object_script2.cpp:83,
-- EntityCondition.cpp:181) and never in a safe zone. Death (health <= 0) is
-- left entirely to the engine: ChangeHealth only accumulates a delta and the
-- engine's condition update clamps/raises the death path; no extra logic here.
local function local_actor_target(target_id)
    if not (db and db.actor) then return false end
    if target_id == db.actor:id() then return true end
    local sid = local_session_id()
    return sid ~= 0 and target_id == sid
end

local function actor_in_safezone()
    local inside = false
    pcall(function()
        if ZoneNet and ZoneNet.IsInSafeZone then
            inside = ZoneNet:IsInSafeZone() == true
        end
    end)
    if inside then return true end
    pcall(function()
        if zone_safezone and type(zone_safezone.is_position_in_safezone) == "function" then
            inside = zone_safezone.is_position_in_safezone(db.actor:position()) == true
        end
    end)
    return inside
end

local function apply_actor_hit(damage, attacker_id)
    local dmg = tonumber(damage) or 0
    if dmg <= 0 then return end
    if not (db and db.actor) then return end
    if actor_in_safezone() then return end

    local hp = nil
    pcall(function() hp = db.actor:health() end)
    if hp ~= nil then
        hp = tonumber(hp) or 0
        if hp <= 0 then return end
        if dmg > hp then dmg = hp end
    end

    pcall(function() db.actor:change_health(-dmg) end)

    local tg = time_global()
    if tg - last_hit_notice_tg >= HIT_NOTICE_MS then
        last_hit_notice_tg = tg
        local attacker_name = peer_names[attacker_id] or ""
        local msg = attacker_name ~= ""
            and string.format("%s hit you: %.1f", attacker_name, dmg)
            or string.format("Incoming hit: %.1f", dmg)
        pcall(function()
            db.actor:give_game_news("Zone", msg, "ui_inGame2_PDA_icon", 0, 3000, 0)
        end)
    end
end

function on_damage_notify(target_id, attacker_id, damage, bone_id)
    if local_actor_target(target_id) then
        apply_actor_hit(damage, attacker_id)
        return
    end

    local proxy = spawned_proxies[target_id]
    if not proxy then return end

    if attacker_id then
        proxy.last_attacker_id = attacker_id
    end

    local latest = get_latest_sample(proxy)
    local current_health = latest and latest.health or 100
    local new_health = math.max(0, current_health - damage)
    
    if latest then
        latest.health = new_health
    else
        add_history_sample(proxy, {
            x = 0, y = 0, z = 0, yaw = 0, pitch = 0, animflags = 0, health = new_health, t = time_global()
        })
    end

    if new_health <= 0 and proxy.game_id and level and level.object_by_id then
        local obj = level.object_by_id(proxy.game_id)
        if obj and obj:alive() then
            -- L-18: Attribute killer to actual attacker entity instead of self
            local killer_obj = resolve_entity(attacker_id) or obj
            obj:kill(killer_obj, false)
        end
    end
end

function on_entity_leave(pkt, offset)
    if not pkt or not offset then return end
    local eid = nil
    pcall(function() eid = zone_net.read_uint32_le(pkt, offset) end)
    if not eid then return end
    despawn_proxy(eid)
end

-- Release every online proxy and drop all wire state. Shared by level change
-- and server-drop cleanup (zone_net calls on_disconnect when the DLL reports
-- the session lost, so proxies do not freeze until the next level load).
local function release_all_proxies()
    pcall(function()
        local sim = nil
        if alife then
            local ok, res = pcall(alife)
            if ok then sim = res end
        end
        for sid, proxy in pairs(spawned_proxies) do
            if sim and proxy.se_id then
                local se_obj = nil
                pcall(function() se_obj = sim:object(proxy.se_id) end)
                if se_obj then
                    pcall(function() sim:release(se_obj, true) end)
                end
            end
        end
    end)
    spawned_proxies = {}
    peer_factions = {}
    peer_names = {}
    pending_peers = {}
end

function on_level_changing()
    release_all_proxies()
end

function on_disconnect()
    release_all_proxies()
end

function on_game_start()
    if RegisterScriptCallback then
        RegisterScriptCallback("on_level_changing", on_level_changing)
        RegisterScriptCallback("actor_on_net_destroy", on_disconnect)
        -- Outgoing player-vs-player hit registration (0x0050).
        RegisterScriptCallback("npc_on_before_hit", on_npc_before_hit)
    end
end
