-- zone_hud.script
-- Native in-game HUD indicator and status notifications for Zone.
-- Displays real-time connection status and ping overlay, and issues PDA news tips.

local last_update_time = 0
local UPDATE_INTERVAL_MS = 1000 -- 1 Hz HUD status polling

local last_connected   = nil    -- nil (uninitialized), true, false
local last_ping        = -1
local safe_zone_active = false
local last_dev_w       = 0
local last_dev_h       = 0

-- Persistent HUD static widget
local hud_static       = nil

-- Color definitions (ARGB)
local COLOR_CONNECTED    = (GetARGB and GetARGB(220, 80,  220, 80))  or 0xDC50DC50 -- Green
local COLOR_SAFEZONE     = (GetARGB and GetARGB(220, 80,  160, 255)) or 0xDC50A0FF -- Blue
local COLOR_DISCONNECTED = (GetARGB and GetARGB(220, 220, 80,  80))  or 0xDCDC5050 -- Red
local COLOR_DLL_MISSING  = (GetARGB and GetARGB(220, 180, 180, 180)) or 0xDCB4B4B4 -- Grey

-- ============================================================
-- Status Helpers
-- ============================================================

local function is_dll_loaded()
    return type(ZoneNet) == "table" or type(ZoneNet) == "userdata"
end

-- notify_safezone is the primary source; fall back to the client atomic so a
-- missed 0x0020 packet cannot desync the banner (mirrors zone_safezone poll).
local function in_safezone()
    if safe_zone_active then return true end
    local ok, res = pcall(function()
        return ZoneNet and ZoneNet.IsInSafeZone and ZoneNet:IsInSafeZone()
    end)
    return ok and res == true
end

local function get_status_data()
    if not is_dll_loaded() then
        return false, 0, 0, "[ZO] DLL Offline", COLOR_DLL_MISSING
    end

    local connected = false
    local ok, res = pcall(function() return ZoneNet:IsConnected() end)
    if ok and res then connected = true end

    if connected then
        local sid, ping = 0, 0
        local ok_info, s, p = pcall(function() return ZoneNet:GetSessionInfo() end)
        if ok_info then
            sid = s or 0
            ping = p or 0
        end

        local text, color
        if in_safezone() then
            text = string.format("[ZO] Safe Zone | Ping: %d ms", ping)
            color = COLOR_SAFEZONE
        else
            text = string.format("[ZO] Online | Ping: %d ms", ping)
            color = COLOR_CONNECTED
        end
        return true, sid, ping, text, color
    end

    return false, 0, 0, "[ZO] Offline", COLOR_DISCONNECTED
end

-- ============================================================
-- HUD Static Widget Management
-- ============================================================

local function get_hud_rect()
    -- device() is an engine call: pcall-guard it so a mid-load failure
    -- degrades to the default 1024x768 layout instead of a fatal CTD.
    local dev = nil
    if device then
        local ok_dev, d = pcall(function() return device() end)
        if ok_dev then dev = d end
    end
    local dev_w = (dev and dev.width) or 1024
    local dev_h = (dev and dev.height) or 768
    local screen_ratio = dev_w / dev_h
    -- In X-Ray, 1024x768 is the base UI virtual coordinate system.
    -- On widescreen displays, X coordinates stretch with screen ratio.
    -- Scale X dimension by (4:3 / current_aspect_ratio) to preserve aspect ratio.
    local ratio = (1024 / 768) / screen_ratio

    local base_w = 216
    local base_h = 22
    local margin_right = 8
    local margin_top = 8

    local w = base_w * ratio
    local x2 = 1024 - (margin_right * ratio)
    local x1 = x2 - w
    local y1 = margin_top
    local y2 = y1 + base_h

    -- Frect():set() is an engine call: never let it throw out of here.
    -- Callers invoke SetWndRect inside pcall, so a nil return degrades
    -- to "skip HUD creation this tick" instead of a fatal CTD.
    local ok_rect, rect = pcall(function() return Frect():set(x1, y1, x2, y2) end)
    if ok_rect and rect then return rect end
    return nil
end

local function clear_hud_static()
    if hud_static then
        -- get_hud()/GetUI() are engine calls: guard them so cleanup during
        -- level change / actor destroy can never throw (fatal CTD on load).
        local ok_mgr, hud_mgr = pcall(function() return get_hud and get_hud() end)
        if ok_mgr and hud_mgr then
            local ok_ui, ui = pcall(function()
                return (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
            end)
            if ok_ui and ui and ui.DetachChild then
                pcall(function() ui:DetachChild(hud_static) end)
            end
        end
        hud_static = nil
    end
end

local function get_or_create_static()
    -- get_hud() is an engine call: guard it for the save-load window where
    -- the HUD manager may not exist yet.
    local ok_mgr, hud_mgr = pcall(function() return get_hud and get_hud() end)
    if not ok_mgr or not hud_mgr then return nil end

    local ok_ui, ui = pcall(function()
        return (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
    end)
    if not ok_ui or not ui then return nil end

    if hud_static then
        return hud_static
    end

    -- The ENTIRE creation sequence runs inside one pcall: any single
    -- engine failure returns nil (callers nil-check) instead of a fatal
    -- CTD via CScriptEngine::lua_pcall_failed in actor_on_update.
    -- ROOT CAUSE of the save-load crash: CUIStatic exposes NO SetFont
    -- method (see CUIStatic::script_register in UIStatic_script.cpp —
    -- only CUILines and CUITextWnd bind SetFont), so the old
    -- s:SetFont(...) call raised "attempt to call method 'SetFont'
    -- (a nil value)". The engine-correct equivalent is
    -- s:TextControl():SetFont(...) (CUILines::SetFont binding).
    local ok, s = pcall(function()
        local st = CUIStatic()
        if not st then error("CUIStatic() returned nil") end
        local rect = get_hud_rect()
        if not rect then error("get_hud_rect() returned nil") end
        st:SetWndRect(rect)

        if GetFontLetterica16Russian and st.TextControl then
            local tc_font = st:TextControl()
            if tc_font and tc_font.SetFont then
                tc_font:SetFont(GetFontLetterica16Russian())
            end
        end

        local tc = nil
        if st.TextControl then tc = st:TextControl() end
        if not tc then error("TextControl() returned nil") end
        tc:SetTextColor(COLOR_CONNECTED)
        tc:SetText("")
        st:Show(true)

        if not ui.AttachChild then error("ui:AttachChild missing") end
        ui:AttachChild(st)
        return st
    end)
    if not ok or not s then return nil end
    hud_static = s
    return hud_static
end

local function update_hud_display(text, color)
    local s = get_or_create_static()
    if not s then return end

    -- All engine calls pcall-guarded: TextControl()/SetText/SetTextColor/
    -- Show must never throw out of actor_on_update (fatal CTD on load).
    pcall(function()
        if s.TextControl then
            local tc = s:TextControl()
            if tc then
                if text ~= nil and tc.SetText then tc:SetText(text) end
                if color ~= nil and tc.SetTextColor then tc:SetTextColor(color) end
            end
        end
        if s.Show then s:Show(true) end
    end)
end

local function hide_hud_display()
    if hud_static and hud_static.Show then
        pcall(function() hud_static:Show(false) end)
    end
end

-- ============================================================
-- Peer / group / chat overlay state
-- ============================================================

local PANEL_MAX_PLAYERS  = 8
local NEARBY_MAX_DIST    = 120
local PANEL_LINE_H       = 15
local PANEL_WIDTH        = 216
local PANEL_MARGIN_RIGHT = 8
local NEARBY_TITLE_Y     = 32
local GROUP_TITLE_Y      = NEARBY_TITLE_Y + PANEL_LINE_H * (PANEL_MAX_PLAYERS + 1) + 6
local CHAT_HISTORY_MAX   = 8
local CHAT_FADE_START_MS = 10000
local CHAT_FADE_MS       = 5000
local INVITE_TTL_MS      = 15000

local function argb(a, r, g, b)
    if GetARGB then return GetARGB(a, r, g, b) end
    return (a * 16777216) + (r * 65536) + (g * 256) + b
end

local COLOR_LINE_GREEN = argb(235, 90, 220, 90)
local COLOR_LINE_RED   = argb(235, 230, 80, 80)
local COLOR_LINE_AMBER = argb(235, 235, 190, 70)
local COLOR_LINE_WHITE = argb(230, 225, 225, 215)
local COLOR_LINE_TITLE = argb(230, 255, 195, 5)

-- Translation-capable label lookup: falls back to the literal key.
local function tr(key, fallback)
    local out = fallback or key
    pcall(function()
        local s = game.translate_string(key)
        if type(s) == "string" and s ~= "" and s ~= key then out = s end
    end)
    return out
end

local nearby_title  = nil
local nearby_lines  = {}
local group_title   = nil
local group_lines   = {}
local invite_static = nil
local invite        = nil
local history_lines = {}
local chat_history  = {}
local group_members = {}
local panel_widgets = {}

local chat_window = nil
local chat_open   = false
local chat_warned = false

-- ============================================================
-- Overlay widget helpers (mirror the status CUIStatic pattern)
-- ============================================================

local function get_ui_root()
    local ok_mgr, hud_mgr = pcall(function() return get_hud and get_hud() end)
    if not ok_mgr or not hud_mgr then return nil end
    local ok_ui, ui = pcall(function()
        return (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
    end)
    if not ok_ui then return nil end
    return ui
end

local function screen_scale_ratio()
    local dev = nil
    if device then
        local ok_dev, d = pcall(function() return device() end)
        if ok_dev then dev = d end
    end
    local dev_w = (dev and dev.width) or 1024
    local dev_h = (dev and dev.height) or 768
    if not dev_w or dev_w <= 0 then dev_w = 1024 end
    if not dev_h or dev_h <= 0 then dev_h = 768 end
    return (1024 / 768) / (dev_w / dev_h)
end

local function make_rect(x1, y1, x2, y2)
    local ok, rect = pcall(function() return Frect():set(x1, y1, x2, y2) end)
    if ok and rect then return rect end
    return nil
end

local function right_panel_rect(y, h, w)
    local ratio = screen_scale_ratio()
    local width = w * ratio
    local x2 = 1024 - PANEL_MARGIN_RIGHT * ratio
    return make_rect(x2 - width, y, x2, y + h)
end

local function track_widget(st)
    if st then panel_widgets[#panel_widgets + 1] = st end
    return st
end

local function create_panel_widget(rect, color)
    local root = get_ui_root()
    if not root or not rect then return nil end
    local ok, st = pcall(function()
        local s = CUIStatic()
        if not s then error("CUIStatic() returned nil") end
        s:SetWndRect(rect)
        local tc = s.TextControl and s:TextControl() or nil
        if tc then
            if GetFontLetterica16Russian and tc.SetFont then tc:SetFont(GetFontLetterica16Russian()) end
            if tc.SetText then tc:SetText("") end
            if tc.SetTextColor then tc:SetTextColor(color or COLOR_LINE_WHITE) end
        end
        if s.Show then s:Show(true) end
        if not root.AttachChild then error("AttachChild missing") end
        root:AttachChild(s)
        return s
    end)
    if ok and st then return st end
    return nil
end

local function widget_set(st, text, color)
    if not st then return end
    pcall(function()
        local tc = st.TextControl and st:TextControl() or nil
        if tc then
            if tc.SetText then tc:SetText(text or "") end
            if color and tc.SetTextColor then tc:SetTextColor(color) end
        end
        if st.Show then st:Show(text ~= nil and text ~= "") end
    end)
end

local function widget_hide(st)
    if st and st.Show then
        pcall(function() st:Show(false) end)
    end
end

local function ensure_lines(pool, count, rect_fn, color)
    for i = #pool + 1, count do
        pool[i] = track_widget(create_panel_widget(rect_fn(i), color))
    end
    for i = 1, count do
        if pool[i] then
            local r = rect_fn(i)
            if r then pcall(function() pool[i]:SetWndRect(r) end) end
        end
    end
end

local function destroy_panels()
    local root = get_ui_root()
    for i = 1, #panel_widgets do
        local st = panel_widgets[i]
        if st then
            pcall(function() if st.Show then st:Show(false) end end)
            if root and root.DetachChild then
                pcall(function() root:DetachChild(st) end)
            end
        end
    end
    panel_widgets = {}
    nearby_title, group_title, invite_static = nil, nil, nil
    nearby_lines, group_lines, history_lines = {}, {}, {}
    group_members = {}
    invite = nil
    chat_history = {}
end

-- ============================================================
-- Faction relations (configs/mod_system_zone_faction_relations.ltx)
-- section [faction_relations]: faction = other:value, other:value, ...
-- The file ships with the DLTX-style mod_system_* name so the engine merges
-- it into system_ini. When the merge is absent (older engine or missing FS
-- cache entry), the file is parsed directly; engine path aliases work with
-- io.open. Missing file / unreadable row => all neutral.
-- ============================================================

local RELATIONS_SEC = "faction_relations"
local RELATIONS_PATH = "$game_config$\\mod_system_zone_faction_relations.ltx"
local RELATIONS_RETRY_MS = 15000

local relation_cache = {}
-- Whole parsed file table (faction -> { other -> value }); nil = not loaded.
local relations_file = nil
local relations_file_retry_at = 0

local function normalize_faction(f)
    f = tostring(f or ""):lower()
    f = f:gsub("^%s+", ""):gsub("%s+$", "")
    if f:sub(1, 6) == "actor_" then f = f:sub(7) end
    return f
end

local function parse_relation_payload(raw, map)
    if type(raw) ~= "string" or raw == "" then return end
    for token in string.gmatch(raw, "([^,]+)") do
        local name, val = string.match(token, "^%s*([%w_]+)%s*:%s*(-?%d+)%s*$")
        if name and val then
            map[normalize_faction(name)] = tonumber(val) or 0
        end
    end
end

-- Direct file fallback. Returns faction -> relation table, or nil when the
-- file is missing/unreadable. Comments, blank lines and other sections are
-- ignored; the prefix match on the first non-space character skips them.
local function load_relations_file()
    local ok_open, file = pcall(io.open, RELATIONS_PATH, "r")
    if not ok_open or not file then return nil end
    local parsed = {}
    local ok_read = pcall(function()
        local in_section = false
        for line in file:lines() do
            local head = line:match("^%s*(.)")
            if head == ";" or head == "#" or head == nil then
                -- comment or blank line
            else
                local sec = line:match("^%s*%[([^%]]+)%]")
                if sec then
                    in_section = (sec:lower() == RELATIONS_SEC)
                elseif in_section then
                    local key, val = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
                    if key and val then
                        key = normalize_faction(key)
                        local map = parsed[key]
                        if not map then
                            map = {}
                            parsed[key] = map
                        end
                        parse_relation_payload(val, map)
                    end
                end
            end
        end
    end)
    pcall(function() file:close() end)
    if not ok_read then return nil end
    return parsed
end

local function current_local_faction()
    local f = ""
    pcall(function()
        if ZoneNet and ZoneNet.GetFaction then f = ZoneNet:GetFaction() end
    end)
    f = normalize_faction(f)
    if f == "" then
        pcall(function()
            if db and db.actor and db.actor.character_community then
                f = normalize_faction(db.actor:character_community())
            end
        end)
    end
    return f
end

local function load_relation_row(faction)
    if faction == "" then return {} end
    local now = 0
    pcall(function() now = time_global() end)
    -- Retry an empty (missing-config) row every 15 s so a late file is picked up.
    local cached = relation_cache[faction]
    if cached and (next(cached.map) ~= nil or (now - cached.t) < RELATIONS_RETRY_MS) then
        return cached.map
    end

    local map = nil

    -- Preferred source: system_ini, which the engine populates when the
    -- mod_system_* override is merged.
    pcall(function()
        local ini = system_ini()
        if not ini or not ini.section_exist then return end
        if not ini:section_exist(RELATIONS_SEC) then return end
        local raw = ini:r_string(RELATIONS_SEC, faction)
        if type(raw) ~= "string" or raw == "" then return end
        map = {}
        parse_relation_payload(raw, map)
    end)

    -- Fallback: parse the file directly. Cache it; while it is missing, do not
    -- touch the disk more than once per RELATIONS_RETRY_MS.
    if map == nil then
        if relations_file == nil and now >= relations_file_retry_at then
            relations_file = load_relations_file()
            if relations_file == nil then
                relations_file_retry_at = now + RELATIONS_RETRY_MS
            end
        end
        if relations_file ~= nil then
            map = relations_file[faction] or {}
        end
    end

    if map == nil then map = {} end
    relation_cache[faction] = { map = map, t = now }
    return map
end

local function relation_value(local_faction, other_faction)
    if local_faction == "" or other_faction == "" then return 0 end
    if local_faction == other_faction then return 2000 end
    local row = load_relation_row(local_faction)
    return row[other_faction] or 0
end

local function faction_relation_color(other_faction, is_group_member)
    if is_group_member then return COLOR_LINE_GREEN end
    local lf = current_local_faction()
    local of = normalize_faction(other_faction)
    if lf ~= "" and of ~= "" and lf == of then return COLOR_LINE_GREEN end
    local rel = relation_value(lf, of)
    if rel < -999 then return COLOR_LINE_RED end
    if rel > 999 then return COLOR_LINE_GREEN end
    if rel < 0 then return COLOR_LINE_AMBER end
    return COLOR_LINE_WHITE
end

local function group_member_set()
    local set = {}
    for i = 1, #group_members do set[group_members[i].sid] = true end
    return set
end

-- ============================================================
-- Chat history buffer (opcode 0x0060 + system notices)
-- ============================================================

local function push_history(text, r, g, b)
    if type(text) ~= "string" or text == "" then return end
    local tg = 0
    pcall(function() tg = time_global() end)
    chat_history[#chat_history + 1] = { text = text, t = tg, r = r or 225, g = g or 225, b = b or 215 }
    while #chat_history > CHAT_HISTORY_MAX do table.remove(chat_history, 1) end
end

local function render_history(tg)
    if type(tg) ~= "number" or tg <= 0 then
        pcall(function() tg = time_global() end)
    end
    if type(tg) ~= "number" then tg = 0 end

    local kept = {}
    for i = 1, #chat_history do
        local e = chat_history[i]
        local age = tg - (e.t or 0)
        if age < (CHAT_FADE_START_MS + CHAT_FADE_MS) then kept[#kept + 1] = e end
    end
    chat_history = kept
    while #chat_history > CHAT_HISTORY_MAX do table.remove(chat_history, 1) end

    local n = #chat_history
    if n == 0 then
        for i = 1, #history_lines do widget_hide(history_lines[i]) end
        return
    end

    local base_x, width, bottom = 12, 520, 10
    ensure_lines(history_lines, n, function(i)
        local y1 = 768 - bottom - (n - i + 1) * PANEL_LINE_H
        return make_rect(base_x, y1, base_x + width, y1 + PANEL_LINE_H)
    end, COLOR_LINE_WHITE)

    for i = 1, n do
        local e = chat_history[i]
        local age = tg - (e.t or 0)
        local alpha = 235
        if age > CHAT_FADE_START_MS then
            alpha = math.floor(235 * (1 - (age - CHAT_FADE_START_MS) / CHAT_FADE_MS))
            if alpha < 0 then alpha = 0 end
        end
        widget_set(history_lines[i], e.text or "", argb(alpha, e.r or 225, e.g or 225, e.b or 215))
    end
    for i = n + 1, #history_lines do widget_hide(history_lines[i]) end
end

function push_system_line(text)
    push_history(text, 255, 210, 90)
    render_history()
end

-- ============================================================
-- Nearby / group / invite panels
-- ============================================================

local function update_nearby_panel()
    local players = {}
    if zone_dummy and zone_dummy.get_nearby_players then
        local ok, res = pcall(zone_dummy.get_nearby_players, NEARBY_MAX_DIST)
        if ok and type(res) == "table" then players = res end
    end

    if not nearby_title then
        nearby_title = track_widget(create_panel_widget(
            right_panel_rect(NEARBY_TITLE_Y, PANEL_LINE_H, PANEL_WIDTH), COLOR_LINE_TITLE))
    end

    local n = #players
    if n > PANEL_MAX_PLAYERS then n = PANEL_MAX_PLAYERS end
    if n == 0 then
        widget_hide(nearby_title)
        for i = 1, #nearby_lines do widget_hide(nearby_lines[i]) end
        return
    end

    widget_set(nearby_title,
        string.format("%s (%d)", tr("ui_zone_nearby_title", "Nearby"), n),
        COLOR_LINE_TITLE)

    local in_group = group_member_set()
    ensure_lines(nearby_lines, n, function(i)
        return right_panel_rect(NEARBY_TITLE_Y + PANEL_LINE_H + (i - 1) * PANEL_LINE_H, PANEL_LINE_H, PANEL_WIDTH)
    end, COLOR_LINE_WHITE)

    for i = 1, n do
        local p = players[i]
        local name = tostring(p.name or "")
        if name == "" then name = "#" .. tostring(p.session_id or 0) end
        local faction = tostring(p.faction or "")
        local is_member = p.session_id ~= nil and in_group[p.session_id] == true
        local prefix = is_member and "* " or ""
        widget_set(nearby_lines[i], prefix .. name .. " [" .. faction .. "]",
            faction_relation_color(faction, is_member))
    end
    for i = n + 1, #nearby_lines do widget_hide(nearby_lines[i]) end
end

local function update_group_panel()
    local n = #group_members
    if n <= 1 then
        widget_hide(group_title)
        for i = 1, #group_lines do widget_hide(group_lines[i]) end
        return
    end
    if n > PANEL_MAX_PLAYERS then n = PANEL_MAX_PLAYERS end

    if not group_title then
        group_title = track_widget(create_panel_widget(
            right_panel_rect(GROUP_TITLE_Y, PANEL_LINE_H, PANEL_WIDTH), COLOR_LINE_TITLE))
    end
    widget_set(group_title,
        string.format("%s (%d)", tr("ui_zone_group_title", "Group"), #group_members),
        COLOR_LINE_TITLE)

    ensure_lines(group_lines, n, function(i)
        return right_panel_rect(GROUP_TITLE_Y + PANEL_LINE_H + (i - 1) * PANEL_LINE_H, PANEL_LINE_H, PANEL_WIDTH)
    end, COLOR_LINE_WHITE)

    for i = 1, n do
        local m = group_members[i]
        local name = tostring(m.name or "")
        if name == "" then name = "#" .. tostring(m.sid or 0) end
        local faction = tostring(m.faction or "")
        local prefix = m.is_leader and "* " or "  "
        widget_set(group_lines[i], prefix .. name .. " [" .. faction .. "]",
            m.is_leader and COLOR_LINE_TITLE or COLOR_LINE_WHITE)
    end
    for i = n + 1, #group_lines do widget_hide(group_lines[i]) end
end

local function invite_text(name, faction)
    local tmpl = tr("ui_zone_group_invite", "INVITE: %s (%s) - /accept or /decline")
    local ok, formatted = pcall(string.format, tmpl, name, faction)
    if ok and type(formatted) == "string" then return formatted end
    return string.format("INVITE: %s (%s) - /accept or /decline", name, faction)
end

local function render_invite(tg)
    if not invite then
        widget_hide(invite_static)
        return
    end
    if type(tg) == "number" and tg > 0 and tg > invite.expire then
        invite = nil
        widget_hide(invite_static)
        return
    end
    if not invite_static then
        invite_static = track_widget(create_panel_widget(make_rect(312, 32, 712, 54), COLOR_LINE_AMBER))
    end
    local name = (invite.name ~= "") and invite.name or ("#" .. tostring(invite.sid or 0))
    local faction = (invite.faction ~= "") and invite.faction or "?"
    widget_set(invite_static, invite_text(name, faction), COLOR_LINE_AMBER)
end

local function update_panels(tg, connected)
    if not connected then
        widget_hide(nearby_title)
        for i = 1, #nearby_lines do widget_hide(nearby_lines[i]) end
        widget_hide(group_title)
        for i = 1, #group_lines do widget_hide(group_lines[i]) end
        widget_hide(invite_static)
        render_history(tg)
        return
    end
    update_nearby_panel()
    update_group_panel()
    render_invite(tg)
    render_history(tg)
end

-- ============================================================
-- Inbound peer / group packets
-- ============================================================

function on_chat_message(pkt, offset)
    if not pkt or not offset then return end
    local got = false
    pcall(function()
        if string.len(pkt) < offset + 5 - 1 then return end
        local sender_id, pos = zone_net.read_uint32_le(pkt, offset)
        local text_len, cpos = zone_net.read_uint8(pkt, pos)
        local avail = string.len(pkt) - cpos + 1
        if text_len > avail then text_len = avail end
        if text_len < 0 then text_len = 0 end
        local txt = zone_net.read_string(pkt, cpos, text_len)
        if type(txt) ~= "string" then return end
        txt = txt:gsub("%z+", "")
        if txt == "" then return end
        local name = nil
        if zone_dummy and zone_dummy.get_peer_name then
            local ok, n = pcall(zone_dummy.get_peer_name, sender_id)
            if ok and type(n) == "string" and n ~= "" then name = n end
        end
        if not name then name = "#" .. tostring(sender_id) end
        push_history(name .. ": " .. txt, 235, 235, 228)
        got = true
    end)
    if got then render_history() end
end

function on_group_invite(pkt, offset)
    if not pkt or not offset then return end
    pcall(function()
        if string.len(pkt) < offset + 52 - 1 then return end
        local sid, pos = zone_net.read_uint32_le(pkt, offset)
        local name, pos = zone_net.read_string(pkt, pos, 32)
        local faction, pos = zone_net.read_string(pkt, pos, 16)
        name = tostring(name or ""):gsub("%z+", "")
        faction = tostring(faction or ""):gsub("%z+", "")
        local tg = 0
        pcall(function() tg = time_global() end)
        invite = { sid = sid, name = name, faction = faction, expire = tg + INVITE_TTL_MS }
        render_invite(tg)
        local shown = (name ~= "") and name or ("#" .. tostring(sid))
        push_system_line(invite_text(shown, (faction ~= "") and faction or "?"))
    end)
end

function on_group_state(pkt, offset)
    if not pkt or not offset then return end
    pcall(function()
        local len = string.len(pkt)
        local count, pos = zone_net.read_uint8(pkt, offset)
        if not count then return end
        if count > 16 then count = 16 end
        if len < (pos - 1) + count * 53 then return end
        local members = {}
        for _ = 1, count do
            local sid, p2 = zone_net.read_uint32_le(pkt, pos)
            local name, p3 = zone_net.read_string(pkt, p2, 32)
            local faction, p4 = zone_net.read_string(pkt, p3, 16)
            local is_leader, p5 = zone_net.read_uint8(pkt, p4)
            pos = p5
            name = tostring(name or ""):gsub("%z+", "")
            faction = tostring(faction or ""):gsub("%z+", "")
            if name == "" and zone_dummy and zone_dummy.get_peer_name then
                local ok, n = pcall(zone_dummy.get_peer_name, sid)
                if ok and type(n) == "string" then name = n end
            end
            if faction == "" and zone_dummy and zone_dummy.get_peer_faction then
                local ok, f = pcall(zone_dummy.get_peer_faction, sid)
                if ok and type(f) == "string" then faction = f end
            end
            members[#members + 1] = {
                sid = sid, name = name, faction = faction,
                is_leader = (is_leader == 1),
            }
        end
        group_members = members
        update_group_panel()
    end)
end

-- ============================================================
-- Chat input window (configs/ui/zone_ui_chat.xml)
-- ============================================================

class "UIZoneChat" (CUIScriptWnd)

function UIZoneChat:__init() super()
    self.built = false
    local rect = make_rect(0, 0, 1024, 768)
    if rect then pcall(function() self:SetWndRect(rect) end) end
    pcall(function() self:Enable(true) end)
    pcall(function()
        local xml = CScriptXmlInit()
        xml:ParseFile("zone_ui_chat.xml")
        self.xml = xml
        self.bg = xml:InitStatic("bg", self)
        self.hint = xml:InitStatic("hint", self)
        self.edit = xml:InitEditBox("edit_chat", self)
        if self.edit then self:Register(self.edit, "edit_chat") end
        self.built = true
    end)
end

function UIZoneChat:__finalize()
end

function UIZoneChat:DoSend()
    local txt = ""
    pcall(function()
        if self.edit and self.edit.GetText then txt = self.edit:GetText() or "" end
    end)
    close_chat()
    txt = tostring(txt):gsub("^%s+", ""):gsub("%s+$", "")
    if txt ~= "" then
        pcall(function() ZoneNet:SendChatText(txt) end)
    end
end

function UIZoneChat:OnKeyboard(dik, action)
    local res = false
    pcall(function() res = CUIScriptWnd.OnKeyboard(self, dik, action) end)
    if action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
            self:DoSend()
            return true
        elseif dik == DIK_keys.DIK_ESCAPE then
            close_chat()
            return true
        end
    end
    return res
end

local function ensure_chat_window()
    if chat_window then return chat_window end
    local ok, w = pcall(function() return UIZoneChat() end)
    if ok and w and w.built then
        chat_window = w
        return chat_window
    end
    if not chat_warned then
        chat_warned = true
        printf("Zone HUD: chat window unavailable (zone_ui_chat.xml missing or parse failed)")
    end
    return nil
end

local function chat_session_ready()
    local connected = false
    pcall(function()
        if ZoneNet and ZoneNet.IsConnected then connected = ZoneNet:IsConnected() and true or false end
    end)
    return connected and (db and db.actor ~= nil)
end

function open_chat()
    if chat_open then return end
    if not chat_session_ready() then return end
    local w = ensure_chat_window()
    if not w then return end
    chat_open = true
    pcall(function()
        if w.edit and w.edit.SetText then w.edit:SetText("") end
        w:ShowDialog(true)
        w:Show(true)
        if w.edit and w.edit.CaptureFocus then w.edit:CaptureFocus(true) end
    end)
end

function close_chat()
    chat_open = false
    if chat_window then
        pcall(function()
            if chat_window.edit and chat_window.edit.CaptureFocus then
                chat_window.edit:CaptureFocus(false)
            end
            chat_window:HideDialog()
            chat_window:Show(false)
        end)
    end
end

function is_chat_open()
    return chat_open == true
end

-- kXRR_CHAT action id when the exe exposes it; nil otherwise.
local function chat_bind_id()
    local kb = rawget(_G, "key_bindings")
    if not kb then return nil end
    local ok, v = pcall(function() return kb.kXRR_CHAT end)
    if ok and type(v) == "number" then return v end
    return nil
end

local function on_before_key_press(dik, bind, dis, flags)
    pcall(function()
        if chat_open then
            -- While typing, swallow game-bound key actions (movement cancels
            -- and weapon binds included); RETURN/ESC reach the window keyboard.
            if type(flags) == "table" then flags.ret_value = false end
            return
        end
        local toggle = false
        local kb_chat = chat_bind_id()
        if kb_chat ~= nil then
            toggle = (bind == kb_chat)
        elseif DIK_keys and dik == DIK_keys.DIK_Y then
            toggle = true
        end
        if toggle then
            if type(flags) == "table" then flags.ret_value = false end
            open_chat()
        end
    end)
end

local function on_before_key_hold(dik, bind, dis, flags)
    if not chat_open then return end
    pcall(function()
        if type(flags) == "table" then flags.ret_value = false end
    end)
end

local function reset_overlay()
    pcall(close_chat)
    chat_window = nil
    chat_warned = false
    destroy_panels()
end

-- ============================================================
-- actor_on_update Handler
-- ============================================================

local function on_actor_update()
    if not (db and db.actor) then return end

    -- Resolution tracking: engine calls guarded so a mid-load failure
    -- just skips the re-layout this tick instead of a fatal CTD.
    -- The .width/.height reads are inside the pcall: a half-constructed
    -- device object must not throw out of actor_on_update.
    if device then
        pcall(function()
            local dev = device()
            if not dev then return end
            local dev_w = dev.width
            local dev_h = dev.height
            if dev_w ~= last_dev_w or dev_h ~= last_dev_h then
                last_dev_w = dev_w
                last_dev_h = dev_h
                if hud_static then
                    local r = get_hud_rect()
                    if r then hud_static:SetWndRect(r) end
                end
            end
        end)
    end

    local ok_tg, tg = pcall(function() return time_global() end)
    if not ok_tg or type(tg) ~= "number" then return end
    if tg - last_update_time < UPDATE_INTERVAL_MS then return end
    last_update_time = tg

    local connected, sid, ping, status_text, status_color = get_status_data()

    -- Hide overlay when NOT connected (offline/singleplayer); 1 Hz check.
    if not connected then
        hide_hud_display()
    else
        -- Update corner HUD text overlay
        update_hud_display(status_text, status_color)
    end

    -- Peer / group / invite / chat-history overlay panels (1 Hz).
    pcall(update_panels, tg, connected)

    -- Connection transition notifications
    if is_dll_loaded() then
        if connected and last_connected ~= true then
            last_connected = true
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    string.format("Connected to session #%s | Ping: %d ms", tostring(sid), ping),
                    "ui_inGame2_PDA_icon",
                    0, 5000, 1
                )
            end)
            pcall(push_system_line, tr("ui_zone_connected", "Connected"))
        elseif not connected and last_connected == true then
            last_connected = false
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    "Disconnected from server.",
                    "ui_inGame2_PDA_icon",
                    0, 5000, 1
                )
            end)
            pcall(push_system_line, tr("ui_zone_failed", "Connection failed"))
        end
    else
        last_connected = false
    end
end

-- ============================================================
-- Safe Zone Notifications API
-- ============================================================

--- Called when safe zone state changes (e.g. from zone_safezone.script).
--- @param locked boolean  true = entered safe zone, false = left safe zone
--- @param zone_id string|nil  safe zone id (optional; backward compat with 1-arg calls)
function notify_safezone(locked, zone_id)
    local is_locked = (locked == true or locked == 1)
    local zid = (type(zone_id) == "string" and zone_id ~= "") and zone_id or ""

    if is_locked and not safe_zone_active then
        safe_zone_active = true
        if db and db.actor then
            local enter_text = "[Safe Zone] Weapons locked — peaceful territory"
            if zid ~= "" then enter_text = enter_text .. " (" .. zid .. ")" end
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    enter_text,
                    "ui_inGame2_PDA_icon",
                    0, 5000, 1
                )
            end)
            pcall(push_system_line, enter_text)
        end
        local _, _, _, text, color = get_status_data()
        update_hud_display(text, color)

    elseif not is_locked and safe_zone_active then
        safe_zone_active = false
        if db and db.actor then
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    "[Safe Zone] You have left the safe zone",
                    "ui_inGame2_PDA_icon",
                    0, 3000, 1
                )
            end)
            pcall(push_system_line, "[Safe Zone] You have left the safe zone")
        end
        local _, _, _, status_text, status_color = get_status_data()
        update_hud_display(status_text, status_color)
    end
end

-- ============================================================
-- Cleanup on Level Transition / Actor Destroy
-- ============================================================

local function on_level_changing()
    clear_hud_static()
    pcall(reset_overlay)
    last_update_time = 0
    last_connected   = nil
    safe_zone_active = false
    last_dev_w       = 0
    last_dev_h       = 0
end

local function on_actor_destroy()
    clear_hud_static()
    pcall(reset_overlay)
    last_update_time = 0
    last_connected   = nil
    safe_zone_active = false
    last_dev_w       = 0
    last_dev_h       = 0
end

-- ============================================================
-- on_game_start
-- ============================================================

local callbacks_registered = false

function on_game_start()
    if callbacks_registered then return end
    callbacks_registered = true
    if RegisterScriptCallback then
        RegisterScriptCallback("actor_on_update",      on_actor_update)
        RegisterScriptCallback("actor_on_net_destroy", on_actor_destroy)
        RegisterScriptCallback("on_level_changing",    on_level_changing)
        RegisterScriptCallback("on_before_key_press",  on_before_key_press)
        RegisterScriptCallback("on_before_key_hold",   on_before_key_hold)
    end
end
