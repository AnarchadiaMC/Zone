-- zone_hud.script
-- Native in-game HUD indicator and status notifications for Zone.
-- Displays real-time connection status and ping overlay, and issues PDA news tips.

local last_update_time = 0
local UPDATE_INTERVAL_MS = 1000 -- 1 Hz HUD status polling

local last_connected   = nil    -- nil (uninitialized), true, false
local last_ping        = -1
local safe_zone_active = false
local last_dev_w       = 0
local last_dev_h       = 0

-- Persistent HUD static widget
local hud_static       = nil

-- Color definitions (ARGB)
local COLOR_CONNECTED    = (GetARGB and GetARGB(220, 80,  220, 80))  or 0xDC50DC50 -- Green
local COLOR_SAFEZONE     = (GetARGB and GetARGB(220, 80,  160, 255)) or 0xDC50A0FF -- Blue
local COLOR_DISCONNECTED = (GetARGB and GetARGB(220, 220, 80,  80))  or 0xDCDC5050 -- Red
local COLOR_DLL_MISSING  = (GetARGB and GetARGB(220, 180, 180, 180)) or 0xDCB4B4B4 -- Grey

-- ============================================================
-- Status Helpers
-- ============================================================

local function is_dll_loaded()
    return type(ZoneNet) == "table" or type(ZoneNet) == "userdata"
end

local function get_status_data()
    if not is_dll_loaded() then
        return false, 0, 0, "[ZO] DLL Offline", COLOR_DLL_MISSING
    end

    local connected = false
    local ok, res = pcall(function() return ZoneNet:IsConnected() end)
    if ok and res then connected = true end

    if connected then
        local sid, ping = 0, 0
        local ok_info, s, p = pcall(function() return ZoneNet:GetSessionInfo() end)
        if ok_info then
            sid = s or 0
            ping = p or 0
        end

        local text, color
        if safe_zone_active then
            text = string.format("[ZO] Safe Zone | Ping: %d ms", ping)
            color = COLOR_SAFEZONE
        else
            text = string.format("[ZO] Online | Ping: %d ms", ping)
            color = COLOR_CONNECTED
        end
        return true, sid, ping, text, color
    end

    return false, 0, 0, "[ZO] Offline", COLOR_DISCONNECTED
end

-- ============================================================
-- HUD Static Widget Management
-- ============================================================

local function get_hud_rect()
    local dev = device and device()
    local dev_w = (dev and dev.width) or 1024
    local dev_h = (dev and dev.height) or 768
    local screen_ratio = dev_w / dev_h
    -- In X-Ray, 1024x768 is the base UI virtual coordinate system.
    -- On widescreen displays, X coordinates stretch with screen ratio.
    -- Scale X dimension by (4:3 / current_aspect_ratio) to preserve aspect ratio.
    local ratio = (1024 / 768) / screen_ratio

    local base_w = 216
    local base_h = 22
    local margin_right = 8
    local margin_top = 8

    local w = base_w * ratio
    local x2 = 1024 - (margin_right * ratio)
    local x1 = x2 - w
    local y1 = margin_top
    local y2 = y1 + base_h

    return Frect():set(x1, y1, x2, y2)
end

local function clear_hud_static()
    if hud_static then
        local hud_mgr = get_hud and get_hud()
        if hud_mgr then
            local ui = (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
            if ui and ui.DetachChild then
                pcall(function() ui:DetachChild(hud_static) end)
            end
        end
        hud_static = nil
    end
end

local function get_or_create_static()
    local hud_mgr = get_hud and get_hud()
    if not hud_mgr then return nil end

    local ui = (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
    if not ui then return nil end

    if hud_static then
        return hud_static
    end

    local s = CUIStatic()
    -- DO NOT USE SetAutoDelete(true) because we are maintaining a Lua reference
    -- s:SetAutoDelete(true)
    s:SetWndRect(get_hud_rect())

    if GetFontLetterica16Russian then
        s:SetFont(GetFontLetterica16Russian())
    end

    s:TextControl():SetTextColor(COLOR_CONNECTED)
    s:TextControl():SetText("")
    s:Show(true)

    ui:AttachChild(s)
    hud_static = s
    return hud_static
end

local function update_hud_display(text, color)
    local s = get_or_create_static()
    if not s then return end

    if s.TextControl then
        s:TextControl():SetText(text)
        s:TextControl():SetTextColor(color)
    end
    s:Show(true)
end

-- ============================================================
-- actor_on_update Handler
-- ============================================================

local function on_actor_update()
    if not db.actor then return end

    local dev = device and device()
    if dev then
        local dev_w = dev.width
        local dev_h = dev.height
        if dev_w ~= last_dev_w or dev_h ~= last_dev_h then
            last_dev_w = dev_w
            last_dev_h = dev_h
            if hud_static then
                hud_static:SetWndRect(get_hud_rect())
            end
        end
    end

    local tg = time_global()
    if tg - last_update_time < UPDATE_INTERVAL_MS then return end
    last_update_time = tg

    local connected, sid, ping, status_text, status_color = get_status_data()

    -- Update corner HUD text overlay
    update_hud_display(status_text, status_color)

    -- Connection transition notifications
    if is_dll_loaded() then
        if connected and last_connected ~= true then
            last_connected = true
            db.actor:give_game_news(
                "Zone",
                string.format("Connected to session #%s | Ping: %d ms", tostring(sid), ping),
                "ui_inGame2_PDA_icon",
                0, 5000, 1
            )
        elseif not connected and last_connected == true then
            last_connected = false
            db.actor:give_game_news(
                "Zone",
                "Disconnected from server.",
                "ui_inGame2_PDA_icon",
                0, 5000, 1
            )
        end
    else
        last_connected = false
    end
end

-- ============================================================
-- Safe Zone Notifications API
-- ============================================================

--- Called when safe zone state changes (e.g. from zone_safezone.script).
--- @param locked boolean  true = entered safe zone, false = left safe zone
function notify_safezone(locked)
    local is_locked = (locked == true or locked == 1)

    if is_locked and not safe_zone_active then
        safe_zone_active = true
        if db.actor then
            db.actor:give_game_news(
                "Zone",
                "[Safe Zone] Weapons locked — peaceful territory",
                "ui_inGame2_PDA_icon",
                0, 5000, 1
            )
        end
        local _, _, _, text, color = get_status_data()
        update_hud_display(text, color)

    elseif not is_locked and safe_zone_active then
        safe_zone_active = false
        if db.actor then
            db.actor:give_game_news(
                "Zone",
                "[Safe Zone] You have left the safe zone",
                "ui_inGame2_PDA_icon",
                0, 3000, 1
            )
        end
        local _, _, _, text, color = get_status_data()
        update_hud_display(text, color)
    end
end

-- ============================================================
-- Cleanup on Level Transition / Actor Destroy
-- ============================================================

local function on_level_changing()
    clear_hud_static()
    last_update_time = 0
    last_connected   = nil
    safe_zone_active = false
    last_dev_w       = 0
    last_dev_h       = 0
end

local function on_actor_destroy()
    clear_hud_static()
    last_update_time = 0
    last_connected   = nil
    safe_zone_active = false
    last_dev_w       = 0
    last_dev_h       = 0
end

-- ============================================================
-- on_game_start
-- ============================================================

function on_game_start()
    if RegisterScriptCallback then
        RegisterScriptCallback("actor_on_update",      on_actor_update)
        RegisterScriptCallback("actor_on_net_destroy", on_actor_destroy)
        RegisterScriptCallback("on_level_changing",    on_level_changing)
    end
end
