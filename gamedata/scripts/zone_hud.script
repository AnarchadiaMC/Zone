-- zone_hud.script
-- Native in-game HUD indicator and status notifications for Zone.
-- Displays real-time connection status and ping overlay, and issues PDA news tips.

local last_update_time = 0
local UPDATE_INTERVAL_MS = 1000 -- 1 Hz HUD status polling

local last_connected   = nil    -- nil (uninitialized), true, false
local last_ping        = -1
local safe_zone_active = false
local last_dev_w       = 0
local last_dev_h       = 0

-- Persistent HUD static widget
local hud_static       = nil

-- Color definitions (ARGB)
local COLOR_CONNECTED    = (GetARGB and GetARGB(220, 80,  220, 80))  or 0xDC50DC50 -- Green
local COLOR_SAFEZONE     = (GetARGB and GetARGB(220, 80,  160, 255)) or 0xDC50A0FF -- Blue
local COLOR_DISCONNECTED = (GetARGB and GetARGB(220, 220, 80,  80))  or 0xDCDC5050 -- Red
local COLOR_DLL_MISSING  = (GetARGB and GetARGB(220, 180, 180, 180)) or 0xDCB4B4B4 -- Grey

-- ============================================================
-- Status Helpers
-- ============================================================

local function is_dll_loaded()
    return type(ZoneNet) == "table" or type(ZoneNet) == "userdata"
end

local function get_status_data()
    if not is_dll_loaded() then
        return false, 0, 0, "[ZO] DLL Offline", COLOR_DLL_MISSING
    end

    local connected = false
    local ok, res = pcall(function() return ZoneNet:IsConnected() end)
    if ok and res then connected = true end

    if connected then
        local sid, ping = 0, 0
        local ok_info, s, p = pcall(function() return ZoneNet:GetSessionInfo() end)
        if ok_info then
            sid = s or 0
            ping = p or 0
        end

        local text, color
        if safe_zone_active then
            text = string.format("[ZO] Safe Zone | Ping: %d ms", ping)
            color = COLOR_SAFEZONE
        else
            text = string.format("[ZO] Online | Ping: %d ms", ping)
            color = COLOR_CONNECTED
        end
        return true, sid, ping, text, color
    end

    return false, 0, 0, "[ZO] Offline", COLOR_DISCONNECTED
end

-- ============================================================
-- HUD Static Widget Management
-- ============================================================

local function get_hud_rect()
    -- device() is an engine call: pcall-guard it so a mid-load failure
    -- degrades to the default 1024x768 layout instead of a fatal CTD.
    local dev = nil
    if device then
        local ok_dev, d = pcall(function() return device() end)
        if ok_dev then dev = d end
    end
    local dev_w = (dev and dev.width) or 1024
    local dev_h = (dev and dev.height) or 768
    local screen_ratio = dev_w / dev_h
    -- In X-Ray, 1024x768 is the base UI virtual coordinate system.
    -- On widescreen displays, X coordinates stretch with screen ratio.
    -- Scale X dimension by (4:3 / current_aspect_ratio) to preserve aspect ratio.
    local ratio = (1024 / 768) / screen_ratio

    local base_w = 216
    local base_h = 22
    local margin_right = 8
    local margin_top = 8

    local w = base_w * ratio
    local x2 = 1024 - (margin_right * ratio)
    local x1 = x2 - w
    local y1 = margin_top
    local y2 = y1 + base_h

    -- Frect():set() is an engine call: never let it throw out of here.
    -- Callers invoke SetWndRect inside pcall, so a nil return degrades
    -- to "skip HUD creation this tick" instead of a fatal CTD.
    local ok_rect, rect = pcall(function() return Frect():set(x1, y1, x2, y2) end)
    if ok_rect and rect then return rect end
    return nil
end

local function clear_hud_static()
    if hud_static then
        -- get_hud()/GetUI() are engine calls: guard them so cleanup during
        -- level change / actor destroy can never throw (fatal CTD on load).
        local ok_mgr, hud_mgr = pcall(function() return get_hud and get_hud() end)
        if ok_mgr and hud_mgr then
            local ok_ui, ui = pcall(function()
                return (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
            end)
            if ok_ui and ui and ui.DetachChild then
                pcall(function() ui:DetachChild(hud_static) end)
            end
        end
        hud_static = nil
    end
end

local function get_or_create_static()
    -- get_hud() is an engine call: guard it for the save-load window where
    -- the HUD manager may not exist yet.
    local ok_mgr, hud_mgr = pcall(function() return get_hud and get_hud() end)
    if not ok_mgr or not hud_mgr then return nil end

    local ok_ui, ui = pcall(function()
        return (hud_mgr.GetUI and hud_mgr:GetUI()) or (hud_mgr.GetWindow and hud_mgr:GetWindow())
    end)
    if not ok_ui or not ui then return nil end

    if hud_static then
        return hud_static
    end

    -- The ENTIRE creation sequence runs inside one pcall: any single
    -- engine failure returns nil (callers nil-check) instead of a fatal
    -- CTD via CScriptEngine::lua_pcall_failed in actor_on_update.
    -- ROOT CAUSE of the save-load crash: CUIStatic exposes NO SetFont
    -- method (see CUIStatic::script_register in UIStatic_script.cpp —
    -- only CUILines and CUITextWnd bind SetFont), so the old
    -- s:SetFont(...) call raised "attempt to call method 'SetFont'
    -- (a nil value)". The engine-correct equivalent is
    -- s:TextControl():SetFont(...) (CUILines::SetFont binding).
    local ok, s = pcall(function()
        local st = CUIStatic()
        if not st then error("CUIStatic() returned nil") end
        local rect = get_hud_rect()
        if not rect then error("get_hud_rect() returned nil") end
        st:SetWndRect(rect)

        if GetFontLetterica16Russian and st.TextControl then
            local tc_font = st:TextControl()
            if tc_font and tc_font.SetFont then
                tc_font:SetFont(GetFontLetterica16Russian())
            end
        end

        local tc = nil
        if st.TextControl then tc = st:TextControl() end
        if not tc then error("TextControl() returned nil") end
        tc:SetTextColor(COLOR_CONNECTED)
        tc:SetText("")
        st:Show(true)

        if not ui.AttachChild then error("ui:AttachChild missing") end
        ui:AttachChild(st)
        return st
    end)
    if not ok or not s then return nil end
    hud_static = s
    return hud_static
end

local function update_hud_display(text, color)
    local s = get_or_create_static()
    if not s then return end

    -- All engine calls pcall-guarded: TextControl()/SetText/SetTextColor/
    -- Show must never throw out of actor_on_update (fatal CTD on load).
    pcall(function()
        if s.TextControl then
            local tc = s:TextControl()
            if tc then
                if text ~= nil and tc.SetText then tc:SetText(text) end
                if color ~= nil and tc.SetTextColor then tc:SetTextColor(color) end
            end
        end
        if s.Show then s:Show(true) end
    end)
end

local function hide_hud_display()
    if hud_static and hud_static.Show then
        pcall(function() hud_static:Show(false) end)
    end
end

-- ============================================================
-- actor_on_update Handler
-- ============================================================

local function on_actor_update()
    if not (db and db.actor) then return end

    -- Resolution tracking: engine calls guarded so a mid-load failure
    -- just skips the re-layout this tick instead of a fatal CTD.
    -- The .width/.height reads are inside the pcall: a half-constructed
    -- device object must not throw out of actor_on_update.
    if device then
        pcall(function()
            local dev = device()
            if not dev then return end
            local dev_w = dev.width
            local dev_h = dev.height
            if dev_w ~= last_dev_w or dev_h ~= last_dev_h then
                last_dev_w = dev_w
                last_dev_h = dev_h
                if hud_static then
                    local r = get_hud_rect()
                    if r then hud_static:SetWndRect(r) end
                end
            end
        end)
    end

    local ok_tg, tg = pcall(function() return time_global() end)
    if not ok_tg or type(tg) ~= "number" then return end
    if tg - last_update_time < UPDATE_INTERVAL_MS then return end
    last_update_time = tg

    local connected, sid, ping, status_text, status_color = get_status_data()

    -- Hide overlay when NOT connected (offline/singleplayer); 1 Hz check.
    if not connected then
        hide_hud_display()
    else
        -- Update corner HUD text overlay
        update_hud_display(status_text, status_color)
    end

    -- Connection transition notifications
    if is_dll_loaded() then
        if connected and last_connected ~= true then
            last_connected = true
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    string.format("Connected to session #%s | Ping: %d ms", tostring(sid), ping),
                    "ui_inGame2_PDA_icon",
                    0, 5000, 1
                )
            end)
        elseif not connected and last_connected == true then
            last_connected = false
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    "Disconnected from server.",
                    "ui_inGame2_PDA_icon",
                    0, 5000, 1
                )
            end)
        end
    else
        last_connected = false
    end
end

-- ============================================================
-- Safe Zone Notifications API
-- ============================================================

--- Called when safe zone state changes (e.g. from zone_safezone.script).
--- @param locked boolean  true = entered safe zone, false = left safe zone
--- @param zone_id string|nil  safe zone id (optional; backward compat with 1-arg calls)
function notify_safezone(locked, zone_id)
    local is_locked = (locked == true or locked == 1)
    local zid = (type(zone_id) == "string" and zone_id ~= "") and zone_id or ""

    if is_locked and not safe_zone_active then
        safe_zone_active = true
        if db and db.actor then
            local enter_text = "[Safe Zone] Weapons locked — peaceful territory"
            if zid ~= "" then enter_text = enter_text .. " (" .. zid .. ")" end
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    enter_text,
                    "ui_inGame2_PDA_icon",
                    0, 5000, 1
                )
            end)
        end
        local _, _, _, text, color = get_status_data()
        update_hud_display(text, color)

    elseif not is_locked and safe_zone_active then
        safe_zone_active = false
        if db and db.actor then
            pcall(function()
                db.actor:give_game_news(
                    "Zone",
                    "[Safe Zone] You have left the safe zone",
                    "ui_inGame2_PDA_icon",
                    0, 3000, 1
                )
            end)
        end
        local _, _, _, text, color = get_status_data()
        update_hud_display(text, color)
    end
end

-- ============================================================
-- Cleanup on Level Transition / Actor Destroy
-- ============================================================

local function on_level_changing()
    clear_hud_static()
    last_update_time = 0
    last_connected   = nil
    safe_zone_active = false
    last_dev_w       = 0
    last_dev_h       = 0
end

local function on_actor_destroy()
    clear_hud_static()
    last_update_time = 0
    last_connected   = nil
    safe_zone_active = false
    last_dev_w       = 0
    last_dev_h       = 0
end

-- ============================================================
-- on_game_start
-- ============================================================

function on_game_start()
    if RegisterScriptCallback then
        RegisterScriptCallback("actor_on_update",      on_actor_update)
        RegisterScriptCallback("actor_on_net_destroy", on_actor_destroy)
        RegisterScriptCallback("on_level_changing",    on_level_changing)
    end
end
