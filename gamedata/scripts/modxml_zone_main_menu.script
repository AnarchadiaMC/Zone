local FILES = {
    [ [[ui\ui_mm_main_16.xml]] ] = true,
    [ [[ui\ui_mm_main.xml]]    ] = true,
}

local LISTS = { "menu_main", "menu_main_last_save" }

local BTN = { name = "btn",
              attr = { name = "btn_zone_online", caption = "ui_mm_zone_online" } }

local function inject_list(xml_obj, list_name)
    local list = xml_obj:query(list_name)[1]
    if not list then return false end

    local pos, already_there
    xml_obj:iterateChildren(list, function(v, i)
        local el = xml_obj:getElement(v)
        local name = el and el.attr and el.attr.name
        if name == "btn_zone_online" then
            already_there = true
            return true
        end
        if name == "btn_quit" then pos = i end
    end)
    if already_there then return false end

    -- Insert btn_zone_online before btn_quit (never delete xrRazom's btn_multiplayer)
    xml_obj:insertElement(BTN, list, pos)
    return true
end

-- Coexistence fix: uniquely-named functions + chaining (see on_xml_read below).
-- Captures any previously-defined SHARED globals before shadowing (shared-_G
-- loader model; normally nil under X-Ray per-file setfenv isolation).
local _prev_global_inject_button = rawget(_G, "inject_button")
local _prev_global_on_xml_read = rawget(_G, "on_xml_read")

function zone_inject_button(xml_file_name, xml_obj)
    if not FILES[xml_file_name] then return end

    local injected = 0
    for _, list_name in ipairs(LISTS) do
        if inject_list(xml_obj, list_name) then injected = injected + 1 end
    end
    if injected > 0 then
        log("[Zone-Online] menu: injected btn_zone_online into " .. xml_file_name)
    end

    -- shniaga_wnd sizing: accommodate BOTH Zone (btn_zone_online) and xrRazom
    -- (btn_multiplayer). Vanilla is y=419 h=280 (8 buttons). Zone alone needs
    -- y=350 h=360 (9 buttons); with xrRazom present we need room for 10, so use
    -- y=330 h=400. Never shrink an already-taller box set by another mod.
    local shniaga_nodes = xml_obj:query("shniaga_wnd")
    if shniaga_nodes then
        for _, el in ipairs(shniaga_nodes) do
            local cur_h = el.attr and tonumber(el.attr.height) or 0
            local want_y, want_h = "330", "400"
            if cur_h and cur_h >= 400 then
                want_y = el.attr.y or want_y
                want_h = el.attr.height or want_h
            end
            if xml_obj.setElementAttr then
                pcall(function()
                    xml_obj:setElementAttr(el, { y = want_y, height = want_h })
                end)
            end
            if el.attr then
                el.attr.y = want_y
                el.attr.height = want_h
            end
        end
    end

    -- Query static_disclaimer: keep below the expanded button box.
    local disclaimer_nodes = xml_obj:query("static_disclaimer")
    if disclaimer_nodes then
        for _, el in ipairs(disclaimer_nodes) do
            if xml_obj.setElementAttr then
                pcall(function() xml_obj:setElementAttr(el, { y = "725" }) end)
            end
            if el.attr then
                el.attr.y = "725"
            end
        end
    end

    -- Shared-_G fallback: if another mod's global inject_button was shadowed,
    -- still run it so its button appears even if only our callback got registered.
    if type(_prev_global_inject_button) == "function" and _prev_global_inject_button ~= zone_inject_button then
        pcall(_prev_global_inject_button, xml_file_name, xml_obj)
    end
end

-- NOTE: no `inject_button` alias is exported. Under X-Ray per-file isolation
-- zone_inject_button is registered explicitly (line ~101); under a shared-_G
-- loader an alias would clobber xrRazom's global with no back-chain on their
-- side (they load first), silently losing btn_multiplayer. Nothing references
-- modxml_zone_main_menu.inject_button externally (dxml dispatches on_xml_read).
local _zone_modxml_chaining = false

function zone_modxml_on_xml_read()
    RegisterScriptCallback("on_xml_read", zone_inject_button)

    -- Defer main_menu_on_init registration: zone_menu_patch loads after gathering.
    -- Use a wrapper that resolves the function at call time, not registration time.
    RegisterScriptCallback("main_menu_on_init", function(menu)
        if zone_menu_patch and zone_menu_patch.on_main_menu_init then
            zone_menu_patch.on_main_menu_init(menu)
        end
    end)
    log("[Zone-Online] modxml_zone_main_menu registered on_xml_read and main_menu_on_init")

    -- Re-entrancy guard (protects against mutual A-calls-B-calls-A chains).
    if _zone_modxml_chaining then return end
    _zone_modxml_chaining = true

    -- Chain to previously-defined shared global (shared-_G loader model).
    if type(_prev_global_on_xml_read) == "function" and _prev_global_on_xml_read ~= zone_modxml_on_xml_read then
        pcall(_prev_global_on_xml_read)
    end

    -- Explicit xrRazom coexistence (per-file namespace model): modxml_xrr_main_menu
    -- sorts before modxml_zone_main_menu, so its on_xml_read has already run;
    -- re-invoking is deduped by dxml_core's function-object check, but gives a
    -- second chance if load order ever reverses. Never bypasses its
    -- xrr_player_name guard (no DLL -> correctly no button).
    local xrr = rawget(_G, "modxml_xrr_main_menu")
    if xrr and type(xrr.on_xml_read) == "function" and xrr.on_xml_read ~= zone_modxml_on_xml_read then
        if xrr.on_xml_read ~= _prev_global_on_xml_read then
            pcall(xrr.on_xml_read)
        end
    end

    _zone_modxml_chaining = false
end

function on_xml_read()
    zone_modxml_on_xml_read()
end
