    <col_name x="214" y="150" width="128" height="16">
        <text font="letterica16" align="l" vert_align="c" r="255" g="195" b="5">ui_zone_col_name</text>
    </col_name>
    <col_map x="342" y="150" width="78" height="16">
        <text font="letterica16" align="l" vert_align="c" r="255" g="195" b="5">ui_zone_col_map</text>
