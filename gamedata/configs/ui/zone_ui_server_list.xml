            <text font="letterica16" align="c" vert_align="c" r="235" g="230" b="215">ui_zone_tab_internet</text>
        </button>
        <button id="tab_lan" x="118" y="0" width="72" height="34">
            <texture>ui_button_tablist</texture>
            <text font="letterica16" align="c" vert_align="c" r="235" g="230" b="215">ui_zone_tab_lan</text>
        </button>
        <button id="tab_favorites" x="190" y="0" width="112" height="34">
            <texture>ui_button_tablist</texture>
            <text font="letterica16" align="c" vert_align="c" r="235" g="230" b="215">ui_zone_tab_favorites</text>
        </button>
        <button id="tab_direct" x="302" y="0" width="92" height="34">
            <texture>ui_button_tablist</texture>
            <text font="letterica16" align="c" vert_align="c" r="235" g="230" b="215">ui_zone_tab_direct</text>
        </button>
