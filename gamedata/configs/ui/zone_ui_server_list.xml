    <port_bg x="352" y="284" width="150" height="26">
        <texture>ui_inGame2_edit_box_1</texture>
    </port_bg>
    <edit_port x="360" y="286" width="134" height="22" max_symb_count="5">
        <text_color>
            <e r="235" g="235" b="230"/>
            <d r="120" g="120" b="120"/>
        </text_color>
    </edit_port>
    <nick_label x="200" y="330" width="140" height="20">
        <text font="letterica16" align="l" vert_align="c" r="200" g="200" b="192">ui_zone_direct_nick</text>
    </nick_label>
    <nick_bg x="352" y="326" width="300" height="26">
        <texture>ui_inGame2_edit_box_1</texture>
    </nick_bg>
    <edit_nick x="360" y="328" width="284" height="22" max_symb_count="24">
        <text_color>
            <e r="235" g="235" b="230"/>
            <d r="120" g="120" b="120"/>
