        <texture>ui_inGame2_edit_box</texture>
    </status_bg>
    <status_label x="188" y="616" width="600" height="18">
        <text font="letterica16" align="l" vert_align="c" r="255" g="215" b="0">ui_zone_status_ready</text>
    </status_label>
    <spinner x="800" y="614" width="24" height="20" frames="1" duration="1000" columns="1" frame_width="24" frame_height="20" cyclic="0" autoplay="0">
        <texture a="255" r="255" g="195" b="5">ui_inGame2_lamp_OFF</texture>
    </spinner>

    <btn_connect x="180" y="648" width="150" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c" r="255" g="215" b="0">ui_zone_btn_connect</text>
    </btn_connect>
    <btn_favorite x="338" y="648" width="140" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c" r="225" g="225" b="215">ui_zone_btn_favorite</text>
    </btn_favorite>
