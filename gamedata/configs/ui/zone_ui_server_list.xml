        <text font="letterica16" align="c" vert_align="c" r="225" g="225" b="215">ui_zone_btn_remove</text>
    </btn_remove>
    <btn_refresh x="634" y="648" width="100" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c" r="225" g="225" b="215">ui_zone_btn_refresh</text>
    </btn_refresh>
    <btn_back x="742" y="648" width="102" height="32">
