<w>
    <background x="0" y="0" width="1024" height="768" stretch="1">
        <texture>ui_inGame2_mp_background</texture>
    </background>

    <window_frame x="163" y="60" width="698" height="648" stretch="1">
        <texture>ui_inGame2_main_window</texture>
    </window_frame>

    <title x="180" y="72" width="530" height="28">
        <text font="graffiti22" align="l" vert_align="c" r="255" g="195" b="5">ui_zone_title</text>
    </title>
    <accent_line x="180" y="104" width="664" height="2" stretch="1">
        <texture a="255" r="255" g="195" b="5">ui_inGame2_white_rect</texture>
    </accent_line>
    <header_lamp x="815" y="70" width="37" height="25">
        <texture>ui_inGame2_lamp_OFF</texture>
    </header_lamp>
    <status_header x="520" y="76" width="285" height="18">
        <text font="letterica16" align="r" vert_align="c" r="255" g="215" b="0">ui_zone_status_ready</text>
    </status_header>

    <tabs x="180" y="112" width="440" height="34">
        <button id="tab_internet" x="0" y="0" width="118" height="34">
