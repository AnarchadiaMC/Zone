<w>
    <!-- Zone Server Browser - Overhauled Tactical Theme (Amber/Dark) -->
    <background x="163" y="64" width="698" height="640" stretch="1">
        <texture>ui_inGame2_multiplayer_game_menu</texture>
    </background>

    <!-- Header: Zone amber primary, subtitle muted -->
    <header_label x="200" y="80" width="624" height="26">
        <text align="c" font="letterica18" r="255" g="195" b="5">ZONE - SERVER BROWSER</text>
    </header_label>
    <subtitle_label x="200" y="106" width="624" height="14">
        <text align="c" font="letterica16" r="140" g="140" b="135">SURVIVAL NETWORK  |  DIRECT LINK  |  SECURE UPLINK</text>
    </subtitle_label>

    <!-- Accent underline (1px gold rule) -->
    <accent_line x="175" y="124" width="674" height="1" stretch="1">
        <texture>ui_inGame2_white_rect</texture>
    </accent_line>

    <!-- Filter tabs (left) + search (right) -->
    <btn_tab_all x="175" y="132" width="72" height="22">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c" r="255" g="215" b="0">All</text>
    </btn_tab_all>
    <btn_tab_fav x="252" y="132" width="96" height="22">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">* Favorites</text>
    </btn_tab_fav>
    <btn_tab_hist x="353" y="132" width="82" height="22">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">Recent</text>
    </btn_tab_hist>

    <search_label x="500" y="136" width="42" height="16">
        <text align="r" font="letterica16" r="160" g="160" b="160">Filter:</text>
    </search_label>
    <edit_search x="548" y="132" width="150" height="22" max_symb_count="32">
        <texture>ui_inGame2_edit_box_1</texture>
        <text font="letterica16" r="220" g="220" b="210"/>
    </edit_search>

    <!-- Column headers (amber underline via color, monospaced alignment via padding) -->
    <col_name x="185" y="160" width="260" height="18">
        <text font="letterica16" r="255" g="195" b="5">*  Server Name</text>
    </col_name>
    <col_host x="455" y="160" width="150" height="18">
        <text font="letterica16" r="255" g="195" b="5">Host</text>
    </col_host>
    <col_port x="615" y="160" width="60" height="18">
        <text font="letterica16" r="255" g="195" b="5">Port</text>
    </col_port>
    <col_status x="680" y="160" width="90" height="18">
        <text font="letterica16" r="255" g="195" b="5">State</text>
    </col_status>

    <!-- Server list: reduced height to make room for details panel -->
    <list x="175" y="180" width="674" height="186" item_height="20">
        <font font="letterica16" r="210" g="210" b="205"/>
        <list_font font="letterica16" r="210" g="210" b="205"/>
    </list>

    <!-- Empty-state hint (shown via script when list empty, hidden otherwise) -->
    <empty_hint x="175" y="250" width="674" height="22">
        <text align="c" font="letterica16" r="120" g="120" b="115">No servers - enter address below or add favorite  |  Double-click to connect</text>
    </empty_hint>

    <!-- Selection details panel (dark strip) -->
    <details_bg x="175" y="370" width="674" height="24" stretch="1">
        <texture>ui_inGame2_edit_box_1</texture>
    </details_bg>
    <details_label x="182" y="374" width="660" height="16">
        <text font="letterica16" r="170" g="170" b="165">Selected: -</text>
    </details_label>
    <details_hint x="182" y="386" width="660" height="12">
        <text font="letterica16" r="110" g="110" b="105">Double-click entry to connect  |  * toggles favorite  |  Recent auto-saved on connect</text>
    </details_hint>

    <!-- Direct connect form -->
    <direct_label x="175" y="404" width="300" height="18">
        <text font="letterica16" r="255" g="195" b="5">DIRECT LINK</text>
    </direct_label>
    <direct_underline x="175" y="420" width="300" height="1" stretch="1">
        <texture>ui_inGame2_white_rect</texture>
    </direct_underline>

    <ip_label x="175" y="430" width="78" height="20">
        <text font="letterica16" r="200" g="200" b="200">IP Address:</text>
    </ip_label>
    <edit_ip x="260" y="428" width="260" height="24" max_symb_count="64">
        <texture>ui_inGame2_edit_box_1</texture>
        <text font="letterica16" r="235" g="235" b="230"/>
    </edit_ip>

    <port_label x="530" y="430" width="38" height="20">
        <text font="letterica16" r="200" g="200" b="200">Port:</text>
    </port_label>
    <edit_port x="570" y="428" width="90" height="24" max_symb_count="5">
        <texture>ui_inGame2_edit_box_1</texture>
        <text font="letterica16" r="235" g="235" b="230"/>
    </edit_port>

    <nick_label x="175" y="458" width="78" height="20">
        <text font="letterica16" r="200" g="200" b="200">Callsign:</text>
    </nick_label>
    <edit_nick x="260" y="456" width="200" height="24" max_symb_count="24">
        <texture>ui_inGame2_edit_box_1</texture>
        <text font="letterica16" r="235" g="235" b="230"/>
    </edit_nick>

    <!-- Primary action row -->
    <btn_connect x="175" y="492" width="150" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c" r="255" g="215" b="0">Connect</text>
    </btn_connect>
    <btn_add_fav x="332" y="492" width="110" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">* Fav</text>
    </btn_add_fav>
    <btn_rename x="449" y="492" width="104" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">Rename</text>
    </btn_rename>
    <btn_refresh x="560" y="492" width="90" height="32">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">Refresh</text>
    </btn_refresh>

    <!-- Secondary row -->
    <btn_del_fav x="175" y="532" width="150" height="30">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">Remove</text>
    </btn_del_fav>
    <btn_back x="332" y="532" width="110" height="30">
        <texture>ui_button_ordinary</texture>
        <text font="letterica16" align="c" vert_align="c">Back</text>
    </btn_back>

    <!-- Status footer: dark strip + amber/green/red text via script SetTextColor -->
    <status_bg x="175" y="574" width="674" height="22" stretch="1">
        <texture>ui_inGame2_edit_box_1</texture>
    </status_bg>
    <status_label x="182" y="578" width="660" height="16">
        <text font="letterica16" r="255" g="215" b="0">o Ready - select server or enter address</text>
    </status_label>
</w>
