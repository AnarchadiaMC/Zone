        <text font="letterica16" align="l" vert_align="c" r="255" g="195" b="5">ui_zone_col_players</text>
    </col_players>
    <col_ping x="472" y="150" width="46" height="16">
        <text font="letterica16" align="l" vert_align="c" r="255" g="195" b="5">ui_zone_col_ping</text>
    </col_ping>
    <col_mode x="518" y="150" width="70" height="16">
        <text font="letterica16" align="l" vert_align="c" r="255" g="195" b="5">ui_zone_col_mode</text>
    </col_mode>

    <list_frame x="180" y="166" width="430" height="436">
        <texture>ui_inGame2_servers_list_frame</texture>
    </list_frame>
    <list x="180" y="166" width="430" height="436" item_height="26" always_show_scroll="1" can_select="1">
        <font font="letterica16" r="225" g="225" b="215"/>
        <list_font font="letterica16" r="225" g="225" b="215"/>
    </list>

    <empty_title x="180" y="340" width="430" height="24">
        <text font="letterica18" align="c" vert_align="c" r="255" g="195" b="5">ui_zone_empty_title</text>
    </empty_title>
    <empty_hint x="180" y="368" width="430" height="36">
        <text font="letterica16" align="c" vert_align="t" r="150" g="150" b="142" complex_mode="1">ui_zone_empty_hint</text>
    </empty_hint>

